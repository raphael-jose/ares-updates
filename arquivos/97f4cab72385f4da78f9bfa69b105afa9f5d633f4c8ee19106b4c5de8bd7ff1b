    const entry = logs[0];
    if (!entry || entry.id === lastLogIdRef.current) return;
    lastLogIdRef.current = entry.id;
    if (entry.tool === "show_image") {
      const m = entry.text.match(/https?:\/\/\S+/);
      if (m) {
        const url = m[0].replace(/[.,;:!?)\]]+$/, "");
        const assunto = entry.text
          .replace(/:.*$/, "")
          .replace(/^Mostrando imagem de\s*/i, "")
          .trim();
        setImageView({ url, assunto: assunto || "" });
        setImageLoading(true);
        setImageError(false);
        setImageOpen(true);
      }
    }
  }, [logs]);

  // ——— Preferências de voz (rate/pitch/voz) ———
  const updateVoice = useCallback((patch: Partial<VoiceSettings>) => {
    // Base = estado global do módulo (sempre em sincronia), não o closure do
    // estado React (que pode estar desatualizado entre patches em lote).
    const next = { ...getVoiceSettings(), ...patch };
    setVoicePrefs(next);
    setVoiceSettings(next);
    try {
      window.localStorage.setItem(VOICE_KEY, JSON.stringify(next));
    } catch {
      /* storage indisponível */
    }
  }, []);

  // Hermes: busca o status do daemon de velocidade (chip discreto, atualiza 1×/min)
  useEffect(() => {
    let alive = true;
    const load = async () => {
      try {
        const res = await fetch("/api/hermes");
        if (!res.ok) return;
        const data = (await res.json()) as HermesStatus;
        if (alive) setHermesStatus(data);
      } catch {
        /* servidor pode ainda não ter a rota — tenta de novo no próximo ciclo */
      }
    };
    void load();
    const iv = window.setInterval(load, 60000);
    return () => {
      alive = false;
      window.clearInterval(iv);
    };
  }, []);

  const toggleVoice = useCallback(() => {
    const assistant = assistantRef.current;
    if (!assistant) return;
    if (assistant.isListening()) {
      assistant.stop();
      setVoice("off");
    } else {
      setVoice("on");
      assistant.start();
    }
  }, []);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      // Teclas digitadas em QUALQUER campo de edição (memória, URL, etc.) não
      // devem acionar os comandos do HUD (+, -, R, G, V, T, I, Esc).
      const target = e.target as HTMLElement | null;
      const tag = target?.tagName ?? "";
      if (
        typing || // caixa de digitação aberta: teclas vão para o input
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        target?.isContentEditable
      ) {
        return;
      }
      switch (e.key) {
        case "+":
        case "=":
          sceneRef.current?.zoomIn();
          break;
        case "-":
        case "_":
          sceneRef.current?.zoomOut();
          break;
        case "r":
        case "R":
          sceneRef.current?.resetView();
          break;
        case "v":
        case "V":
          toggleVoice();
          break;
        case "c":
        case "C":
          if (cameraOnRef.current) stopCameraRef.current();
          else startCameraRef.current();
          break;
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [toggleVoice, typing]);

  // Foco automático na caixa de digitação quando ela é aberta
  useEffect(() => {
    if (typing) typeInputRef.current?.focus();
  }, [typing]);

  const submitTyped = useCallback(() => {
    const value = typedText.trim();
