      const res = await fetch(`/api/whatsapp?action=messages&chat=${encodeURIComponent(chat.id)}`);
      const data = (await res.json()) as { ok?: boolean; messages?: Array<{ id: string; fromMe: boolean; body: string; at: number }> };
