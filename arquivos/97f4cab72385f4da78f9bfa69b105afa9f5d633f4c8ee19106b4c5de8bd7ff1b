                  />
                </label>
                <button
                  type="button"
                  className={`chat-tool${chatGravando ? " gravando" : ""}`}
                  onClick={() => void gravarAudioChat()}
                  title={chatGravando ? "Parar e enviar áudio" : "Gravar áudio"}
                >
                  <i className={`bi ${chatGravando ? "bi-stop-circle" : "bi-mic"}`} aria-hidden="true" />
                  {chatGravando && <span className="chat-gravando-dot" aria-hidden="true" />}
                </button>
                <button
                  type="button"
                  className={`chat-tool${chatCamAberta ? " ativo" : ""}`}
                  onClick={() => void abrirCamChat()}
                  title={chatCamAberta ? "Fechar câmera" : "Tirar foto (rosto/ambiente) e enviar"}
                >
                  <i className="bi bi-camera" aria-hidden="true" />
                </button>
              </div>
              {chatCamAberta && (
                <div className="chat-cam">
                  <video ref={chatCamVideoRef} className="chat-cam-video" muted playsInline autoPlay />
                  <div className="chat-cam-botoes">
                    <button type="button" className="chat-cam-btn" onClick={capturarFotoChat}>
                      <i className="bi bi-camera-fill" aria-hidden="true" />
                      CAPTURAR E ENVIAR
                    </button>
                    <button type="button" className="chat-cam-btn fechar" onClick={fecharCamChat}>
                      <i className="bi bi-x" aria-hidden="true" />
                      FECHAR
                    </button>
                  </div>
                </div>
              )}
              {chatStickers && (
                <StickerPicker onEmoji={enviarChatEmoji} onSticker={enviarChatSticker} />
              )}
              {chatAviso && <div className="chat-aviso">{chatAviso}</div>}
              <div className="chat-input-row">
                <input
                  className="chat-input"
                  value={chatMsg}
                  onChange={(e) => setChatMsg(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === "Enter") enviarChatTexto();
                  }}
                  placeholder={
                    chatSel
                      ? "Mensagem… (imagens: coloque a URL no botão 📷)"
                      : "Adicione ou selecione um contato…"
                  }
                />
                <button
                  type="button"
                  className="chat-send"
                  onClick={enviarChatTexto}
                  disabled={!chatMsg.trim()}
                >
                  <i className="bi bi-send" aria-hidden="true" />
                </button>
              </div>
              {chatMsg.startsWith("http") && (
                <div className="chat-url-preview">
                  <span>Detectei uma URL — enviar como…</span>
                  <button type="button" className="chat-url-btn" onClick={() => enviarChatUrl("imagem", chatMsg)}>
                    🖼️ Imagem
                  </button>
                  <button type="button" className="chat-url-btn" onClick={() => enviarChatUrl("video", chatMsg)}>
                    🎬 Vídeo
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

    </>
  );
}

// Limites da persistência do chat: últimas N mensagens por contato e mídia
// embutida (data-URL) até M bytes — acima disso, trunca para caber no storage.
const CONV_MAX_MSGS = 80;
const CONV_MAX_MIDIA = 64 * 1024;

/** Prepara as conversas para o localStorage (limita tamanho e mídia). */
function compactarConversas(
  conv: Record<string, ChatMensagem[]>,
  semMidia = false,
): Record<string, ChatMensagem[]> {
  const out: Record<string, ChatMensagem[]> = {};
  for (const [id, msgs] of Object.entries(conv)) {
    out[id] = msgs.slice(-CONV_MAX_MSGS).map((m) => {
      const r = m.rico;
      if (!r.url) return m;
      const truncar = semMidia || r.url.length > CONV_MAX_MIDIA;
      if (truncar && r.url.startsWith("data:")) {
        return {
          ...m,
          rico: { ...r, url: "data:truncado,", truncado: true },
        };
      }
      return m;
    });
  }
  return out;
}


// ——— Renderiza uma mensagem rica do chat P2P (texto, imagem, vídeo, áudio, sticker, emoji) ———
function RichPreview({ rico }: { rico: PeerRich }) {
  if (rico.kind === "texto") {
    return <span className="rich-texto">{rico.texto}</span>;
  }
  if (rico.kind === "emoji") {
    return <span className="rich-emoji" aria-label="emoji">{rico.texto}</span>;
  }
  if (rico.truncado) {
    return (
      <span className="rich-truncado" title="Mídia grande — não persistida no histórico (ainda está na sessão atual)">
        <i className="bi bi-file-earmark-x" aria-hidden="true" />
        {rico.kind === "imagem" ? "imagem" : rico.kind === "video" ? "vídeo" : rico.kind === "audio" ? "áudio" : rico.kind} · mídia grande (não salva no histórico)
      </span>
    );
  }
  if (rico.kind === "imagem") {
    return (
      <a href={rico.url} target="_blank" rel="noreferrer" className="rich-imagem-link">
        <img src={rico.url} alt={rico.nome ?? "imagem"} className="rich-imagem" />
      </a>
    );
  }
  if (rico.kind === "video") {
    return (
      <video src={rico.url} controls preload="metadata" className="rich-video">
        Seu navegador não suporta vídeo.
      </video>
    );
  }
  if (rico.kind === "audio") {
    return (
      <div className="rich-audio">
        <audio src={rico.url} controls preload="metadata" />
        {typeof rico.duracao === "number" && <span className="rich-audio-duracao">{rico.duracao}s</span>}
      </div>
    );
  }
  if (rico.kind === "sticker") {
    return <img src={rico.url} alt={rico.nome ?? "sticker"} className="rich-sticker" />;
  }
  return <span className="rich-texto">{rico.texto}</span>;
}

