    loadErrosRef.current = loadErros;
  }, [refreshWaStatus, loadWaChats, loadErros]);

  // Polling de eventos do WhatsApp: mensagens novas são faladas pelo ARES.
  // A âncora começa em Date.now() ao abrir (senão falaria mensagens antigas
  // que já estavam no buffer do servidor) e as ids já vistas são ignoradas.
  useEffect(() => {
    if (!whatsappOpen) return;
    waSinceRef.current = Date.now();
    const vistos = new Set<string>();
    const tick = async () => {
      try {
        const res = await fetch(`/api/whatsapp?action=events&since=${waSinceRef.current}`);
        const data = (await res.json()) as { ok?: boolean; events?: Array<{ id: string; from: string; name: string; body: string; at: number }> };
        if (data.ok && data.events?.length) {
          waSinceRef.current = Math.max(waSinceRef.current, ...data.events.map((e) => e.at));
          const nova = data.events.find((e) => !vistos.has(e.id));
          if (nova) {
            vistos.add(nova.id);
            const assist = assistantRef.current;
            if (assist && nova.body) {
              assist.speak(`Nova mensagem de ${nova.name}: ${nova.body}`);
            }
          }
          void loadWaChatsRef.current();
        }
      } catch {
        /* off-line: silencioso */
      }
    };
    void refreshWaStatusRef.current();
    void loadWaChatsRef.current();
    const id = window.setInterval(tick, 12000);
    return () => window.clearInterval(id);
  }, [whatsappOpen]);

  // Refresh ao vivo: “Mostrando imagem de X: https://…” → abre o visualizador
