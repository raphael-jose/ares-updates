      setWaErro("Não consegui falar com o servidor do WhatsApp.");
    }
  }, []);

  const loadWaChats = useCallback(async () => {
    try {
      const res = await fetch("/api/whatsapp?action=chats");
      const data = (await res.json()) as { ok?: boolean; chats?: Array<{ id: string; name: string; lastMessage: string; at: number }> };
      if (data.ok && data.chats) setWaChats(data.chats);
    } catch {
      /* silencioso: o status já avisa */
