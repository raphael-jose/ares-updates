/** Células da grade do mês (com dias cinzas dos meses vizinhos). */
function cellsDoMes(
  ano: number,
  mes: number,
): Array<{ dia: number; ano: number; mes: number; fora: boolean }> {
  const primeiro = new Date(ano, mes, 1);
  const offset = primeiro.getDay();
  const totalDias = new Date(ano, mes + 1, 0).getDate();
  const out: Array<{ dia: number; ano: number; mes: number; fora: boolean }> = [];
  for (let i = offset - 1; i >= 0; i--) {
    const d = new Date(ano, mes, -i);
    out.push({ dia: d.getDate(), ano: d.getFullYear(), mes: d.getMonth(), fora: true });
  }
  for (let dia = 1; dia <= totalDias; dia++) out.push({ dia, ano, mes, fora: false });
  while (out.length % 7 !== 0) {
    const ult = out[out.length - 1];
    const d = new Date(ult.ano, ult.mes, ult.dia + 1);
    out.push({ dia: d.getDate(), ano: d.getFullYear(), mes: d.getMonth(), fora: true });
  }
  return out;
}

/** Descobre o dia (para o calendário saltar) a partir da frase falada no formulário. */
function dataDaFrase(frase: string): { ano: number; mes: number; dia: number } | null {
  const n = (frase ?? "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
  const hoje = new Date();
  const mk = (d: Date) => ({ ano: d.getFullYear(), mes: d.getMonth(), dia: d.getDate() });
  if (/\bamanha\b/.test(n)) {
    const d = new Date();
    d.setDate(d.getDate() + 1);
    return mk(d);
  }
  if (/\bhoje\b/.test(n)) return mk(hoje);
  const ds = n.match(/\b(domingo|segunda|terca|quarta|quinta|sexta|sabado)\b/);
  if (ds) {
    const alvo = {
      domingo: 0,
      segunda: 1,
      terca: 2,
      quarta: 3,
      quinta: 4,
      sexta: 5,
      sabado: 6,
    }[ds[1]] as number;
    const d = new Date();
    let diff = (alvo - d.getDay() + 7) % 7;
    if (diff === 0) diff = 7;
    d.setDate(d.getDate() + diff);
    return mk(d);
  }
  const dm = n.match(/\bdia\s+(\d{1,2})\b/);
  if (dm) {
    const d = new Date(hoje.getFullYear(), hoje.getMonth(), parseInt(dm[1], 10));
    if (d.getTime() < hoje.getTime()) d.setMonth(d.getMonth() + 1);
    return mk(d);
  }
  const num = n.match(/(\d{1,2})[/-](\d{1,2})/);
  if (num) {
    const d = new Date(hoje.getFullYear(), parseInt(num[2], 10) - 1, parseInt(num[1], 10));
    if (d.getTime() < hoje.getTime()) d.setFullYear(d.getFullYear() + 1);
    return mk(d);
  }
  return null;
}

/** Contagem regressiva MM:SS (ou H:MM:SS) para os chips de timer. */
/** Valor compacto para o gráfico (ex.: 1234 → "1,2k"). */
function shortValor(v: number): string {
  if (v >= 1000) {
    return (
      (v / 1000).toLocaleString("pt-BR", { maximumFractionDigits: 1 }) + "k"
    );
  }
  return v.toLocaleString("pt-BR", { maximumFractionDigits: 0 });
}

function formatCountdown(endsAt: number): string {
  const s = Math.max(0, Math.ceil((endsAt - Date.now()) / 1000));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sec = s % 60;
  if (h) return `${h}:${String(m).padStart(2, "0")}:${String(sec).padStart(2, "0")}`;
  return `${m}:${String(sec).padStart(2, "0")}`;
}

/** Tempo de áudio curto para o player de música (MM:SS). */
function fmtMusicTime(s: number): string {
  if (!Number.isFinite(s) || s <= 0) return "0:00";
  const m = Math.floor(s / 60);
  const sec = Math.floor(s % 60);
  return `${m}:${String(sec).padStart(2, "0")}`;
}

