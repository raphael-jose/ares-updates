  // ciano). Redesenha a cada lançamento (finData muda) e ao abrir a janela.
  useEffect(() => {
    const canvas = finChartRef.current;
    const container = canvas?.parentElement;
    if (!canvas || !container) return;

    const desenhar = () => {
      const dpr = window.devicePixelRatio || 1;
      const w = Math.max(200, container.clientWidth);
      const h = 170;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      const cats = finData.resumo?.porCategoria ?? [];
      if (cats.length === 0) {
        ctx.fillStyle = "rgba(86, 217, 255, 0.5)";
        ctx.font = "11px monospace";
        ctx.textAlign = "center";
        ctx.fillText("Sem gastos este mês ainda — lance uma despesa para ver o gráfico.", w / 2, h / 2);
        return;
      }

      const max = Math.max(...cats.map((c) => c.total), 1);
      const padB = 26;
      const padT = 18;
      const chartH = h - padB - padT;
      const n = cats.length;
      const slot = w / n;
      const barW = Math.min(46, slot * 0.6);

      ctx.textAlign = "center";
      cats.forEach((c, i) => {
        const cx = slot * i + slot / 2;
        const bh = Math.max(2, (c.total / max) * chartH);
        const y = padT + chartH - bh;
        // Barra com gradiente ciano (mais forte na base do topo)
        const grad = ctx.createLinearGradient(0, y, 0, y + bh);
        grad.addColorStop(0, "rgba(86, 217, 255, 0.95)");
        grad.addColorStop(1, "rgba(86, 217, 255, 0.25)");
        ctx.fillStyle = grad;
        ctx.fillRect(cx - barW / 2, y, barW, bh);
        // Valor sobre a barra
        ctx.fillStyle = "rgba(220, 240, 255, 0.95)";
        ctx.font = "bold 10px monospace";
        ctx.fillText(shortValor(c.total), cx, y - 4);
        // Rótulo da categoria
        ctx.fillStyle = "rgba(150, 200, 230, 0.8)";
        ctx.font = "9px monospace";
        let label = c.categoria;
        if (label.length > 8) label = label.slice(0, 7) + "…";
        ctx.fillText(label, cx, h - padB + 12);
      });
    };

    desenhar();
    const ro = new ResizeObserver(desenhar);
    ro.observe(container);
    return () => ro.disconnect();
  }, [finData, finOpen]);

