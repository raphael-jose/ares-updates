      sceneRef.current = null;
    };
  }, [defaultEco]);

  // Mapeia o estado do assistente para a emoção do orbe. Estados ao vivo
  // (erro/confirmação/pensando/ouvindo) têm prioridade sobre o flash, que só
  // vale em repouso (ex.: “falando” após a resposta, “feliz” num timer).
  // Batimento alto (rPPG ≥ 100) acende o orbe em vermelho (emoção “alerta”).
  const bpmAlto = bpm !== null && bpm >= 100;
  useEffect(() => {
    if (EMO_TEST_PARAM) {
      // Hook de teste ?emo=: força a emoção (conferir pulsos/sinapses)
      setEmotion(EMO_TEST_PARAM);
      return;
    }
    if (voice === "error") setEmotion("error");
    else if (confirming) setEmotion("confirming");
    else if (busy) setEmotion("thinking");
    else if (listening) setEmotion("listening");
    else if (bpmAlto) setEmotion("alerta");
    else if (emotionFlash) setEmotion(emotionFlash);
    else setEmotion("idle");
  }, [emotionFlash, voice, confirming, busy, listening, bpmAlto]);

  // Aplica a emoção à cena 3D (mudança suave interna ao orbScene).
  useEffect(() => {
    sceneRef.current?.setEmotion(emotion);
  }, [emotion]);

  // Sincroniza o BPM (leitura real do rPPG ou simulada via ?bpm=) com a cena:
  // a pulsação de coração e a agitação das partículas seguem a frequência real.
  useEffect(() => {
    sceneRef.current?.setBpm(bpm);
  }, [bpm]);

  // Hook de teste ?speech=1: simula a fala de uma resposta multi-frase
  // (rajada de pulsos neurais por frase) sem depender da voz/LLM.
  useEffect(() => {
    if (!SPEECH_TEST) return;
    setEmotionFlash("speaking");
    sceneRef.current?.setSpeech(SPEECH_TEST_SAMPLE);
    const id = window.setTimeout(() => {
      setEmotionFlash(null);
      sceneRef.current?.setSpeech(null);
    }, 45000);
    return () => window.clearTimeout(id);
  }, []);

  // Sincroniza refs usados dentro dos callbacks do tracker (criados uma vez)
  useEffect(() => {
    interfaceModeRef.current = interfaceMode;
  }, [interfaceMode]);
  useEffect(() => {
    selectedPanelRef.current = selectedPanel;
  }, [selectedPanel]);
  useEffect(() => {
    bpmRef.current = bpm;
  }, [bpm]);
  useEffect(() => {
    cameraOnRef.current = cameraOn;
  }, [cameraOn]);
  useEffect(() => {
    chatOpenRef.current = chatOpen;
  }, [chatOpen]);
  useEffect(() => {
    contatosRef.current = contatos;
  }, [contatos]);

  // ——— Rede P2P: gerencia conexões com outras IAs (WebRTC copiar/colar).
  // Cada par conectado tem seu próprio PeerManager (chat multi-contato); o
  // pareamento por oferta/resposta cria uma conexão nova por vez.

  /**
   * Adiciona/atualiza um contato com fingerprint VERIFICADO e abre a conversa.
   * Usado pelo onOpen (contatos já salvos) e pela confirmação manual do
   * fingerprint na primeira conexão (confiarContato).
   */
  const confiarContato = useCallback((peer: PeerIdentidadePublica, pm: PeerManager) => {
    peerManagersRef.current.set(peer.fingerprint, pm);
    setPeerRemoto(peer.fingerprint);
    setContatos((c) => {
      // Remove placeholders do mesmo ID público ainda sem fingerprint
      // (adicionados manualmente por ID) — a identidade real é a chave.
      const semPlaceholder = c.filter(
        (x) => !(x.idPublico.toLowerCase() === peer.idPublico.toLowerCase() && !x.dhPub),
      );
      if (semPlaceholder.some((x) => x.id === peer.fingerprint)) {
        return semPlaceholder.map((x) =>
          x.id === peer.fingerprint
            ? {
                ...x,
                nome: peer.nome,
                idPublico: peer.idPublico,
                dhPub: peer.dhPub,
                sigPub: peer.sigPub,
                estado: (pm.conectado ? "online" : "offline") as "online" | "offline",
                quando: Date.now(),
              }
            : x,
        );
      }
      return [
        ...semPlaceholder,
        {
          id: peer.fingerprint,
          nome: peer.nome,
          idPublico: peer.idPublico,
          dhPub: peer.dhPub,
          sigPub: peer.sigPub,
          estado: (pm.conectado ? "online" : "offline") as "online" | "offline",
          quando: Date.now(),
        },
      ];
    });
    setConversas((conv) => (conv[peer.fingerprint] ? conv : { ...conv, [peer.fingerprint]: [] }));
    setChatSel((sel) => sel ?? peer.fingerprint);
    assistantRef.current?.speak(`Conectada com a IA ${peer.idPublico}, identidade verificada.`);
  }, []);

  const criarPeerManager = useCallback((esperadoFingerprint?: string): PeerManager => {
    const pm = new PeerManager(
      {
        onOpen: (peer: PeerIdentidadePublica) => {
          // Limpa qualquer convite pendente que tenhamos enviado a essa pessoa
          const chave = chaveDe(peer.idPublico);
          const p = pendentesRef.current.get(chave);
          if (p) {
            window.clearTimeout(p.timer);
            pendentesRef.current.delete(chave);
          }
          respondendoRef.current.delete(chave);
          // Contato adicionado pelo ID público: confia direto (TOFU — o
          // fingerprint fica salvo e as conexões seguintes são conferidas
          // contra ele, impedindo que outro use o mesmo ID). A verificação
          // manual fica só para peers inesperados.
          if (contatosRef.current.some((x) => chaveDe(x.idPublico ?? x.nome) === chave)) {
            confiarContato(peer, pm);
            return;
          }
          // Peers desconhecidos: pede verificação manual do fingerprint
          verifPmRef.current = pm;
          setVerifPendente({ peer, pm });
        },
        onMensagem: (msg) => {
          const rico: PeerRich = msg.rich ?? { kind: "texto", texto: "" };
          const de = msg.de;
          const item: ChatMensagem = {
            id: `${msg.ts}-${Math.random().toString(36).slice(2, 7)}`,
            de,
            nome: msg.nome,
            rico,
            ts: msg.ts,
            minha: false,
          };
          // Chat P2P (conversa por contato)
          setConversas((conv) => ({
            ...conv,
            [de]: [...(conv[de] ?? []), item],
          }));
          // Feed único
          setPeerChat((c) => [...c, item]);
          // Anuncia em voz (resumo para mídia)
          const nomeF = msg.nome || de.slice(0, 8);
          const textoVoz =
            rico.kind === "texto"
              ? rico.texto
              : rico.kind === "imagem"
                ? "uma imagem"
                : rico.kind === "video"
                  ? "um vídeo"
                : rico.kind === "audio"
                  ? "um áudio"
                : rico.kind === "sticker"
                  ? "um sticker"
                  : "um emoji";
          setEmotionFlash("speaking");
          if (flashTimerRef.current) window.clearTimeout(flashTimerRef.current);
          flashTimerRef.current = window.setTimeout(() => setEmotionFlash(null), 6000);
          // Só interrompe com a fala quando a janela do chat está FECHADA
          if (!chatOpenRef.current) {
            assistantRef.current?.speak(`Nova mensagem de ${nomeF}: ${textoVoz}`);
          }
        },
        onClose: (motivo) => {
          // Marca os contatos como offline
          setContatos((c) => c.map((x) => ({ ...x, estado: "offline" as const })));
          setPeerRemoto(null);
          if (motivo) setConviteMsg(motivo);
        },
        onState: (estado) => {
          if (estado === "conectado") {
            setConviteMsg("");
            // Reconexão concluída: volta o contato para online
            setContatos((c) => c.map((x) => ({ ...x, estado: "online" as const })));
          } else if (estado === "reconectando") {
            setContatos((c) =>
              c.map((x) => (x.estado === "online" ? { ...x, estado: "conectando" as const } : x)),
            );
          }
        },
        onIdentidadeInvalida: (detalhe) => {
          setConviteMsg(`⚠ ${detalhe}`);
          setChatAviso(detalhe);
          window.setTimeout(() => setChatAviso(""), 6000);
        },
      },
      esperadoFingerprint,
    );
    return pm;
  }, [confiarContato]);

  // ——— Conexão automática por ID (sinalização via broker) ———
  // Envia um convite ao ID alvo e aguarda a resposta (timeout 30s).
  const tentarAutoConectar = useCallback(
    (idPublico: string) => {
      const st = estadoIdentidade();
      const sinal = sinalRef.current;
      if (!st.desbloqueada || !sinal || !sinal.conectado) return;
      const chave = chaveDe(idPublico);
      if (pendentesRef.current.has(chave)) return; // já estamos convidando
      if (contatosRef.current.some((x) => chaveDe(x.idPublico ?? x.nome) === chave && x.estado === "online")) {
        return; // já conectado
      }
      const pm = criarPeerManager();
      peerManagerRef.current = pm;
      void (async () => {
        try {
          const convite = await pm.gerarConvite();
          sinal.enviarSinal(idPublico, "convite", convite);
          const timer = window.setTimeout(() => {
            pendentesRef.current.delete(chave);
            setContatos((c) =>
              c.map((x) =>
                chaveDe(x.idPublico ?? x.nome) === chave && x.estado === "conectando"
                  ? { ...x, estado: "offline" as const }
                  : x,
              ),
            );
          }, 30000);
          pendentesRef.current.set(chave, { pm, timer });
          setContatos((c) =>
            c.map((x) =>
              chaveDe(x.idPublico ?? x.nome) === chave ? { ...x, estado: "conectando" as const } : x,
            ),
          );
        } catch {
          /* identidade bloqueada etc. */
        }
      })();
    },
    [criarPeerManager],
  );

  // Inicializa a conexão P2P (cria o primeiro manager; convites novos criam
  // managers adicionais via criarPeerManager).
  useEffect(() => {
    const pm = criarPeerManager();
    peerManagerRef.current = pm;
    // Carrega contatos (com identidade), conversas e lidos salvos.
    // Contatos antigos (sem fingerprint) são descartados — a identidade real
    // agora é a chave criptográfica, não o ID UUID da instalação.
    try {
      const raw = window.localStorage.getItem("ares-contatos");
      if (raw) {
        const arr = JSON.parse(raw) as {
          id: string;
          nome: string;
          idPublico?: string;
          dhPub?: JsonWebKey;
          sigPub?: JsonWebKey;
          estado?: "online" | "conectando" | "offline";
          quando: number;
        }[];
        if (Array.isArray(arr)) {
          setContatos(
            arr
              .filter((c) => c && c.id && c.idPublico)
              .map((c) => ({
                id: c.id,
                nome: c.nome,
                idPublico: c.idPublico ?? c.nome,
                dhPub: c.dhPub,
                sigPub: c.sigPub,
                estado: (c.estado ?? "offline") as "online" | "conectando" | "offline",
                quando: c.quando,
              })),
          );
        }
      }
      const rawConv = window.localStorage.getItem("ares-conversas");
      if (rawConv) {
        const obj = JSON.parse(rawConv) as Record<string, ChatMensagem[]>;
        if (obj && typeof obj === "object") {
          const limpo: Record<string, ChatMensagem[]> = {};
          for (const [id, msgs] of Object.entries(obj)) {
            if (Array.isArray(msgs)) limpo[id] = msgs.filter((m) => m && m.rico && m.ts);
          }
          setConversas(limpo);
        }
      }
      const rawLidos = window.localStorage.getItem("ares-lidos");
      if (rawLidos) {
        const obj = JSON.parse(rawLidos) as Record<string, number>;
        if (obj && typeof obj === "object") setChatLidos(obj);
      }
    } catch {
      /* sem storage */
    }
    return () => {
      pm.fechar();
      peerManagersRef.current.forEach((m) => m.fechar());
      peerManagersRef.current.clear();
    };
  }, [criarPeerManager]);

  // ——— Sinalizador: presença + auto-conexão por ID (broker MQTT) ———
  useEffect(() => {
    const st = identEstado;
    if (!st.criada || !st.desbloqueada || !st.idPublico) {
      sinalRef.current?.fechar();
      sinalRef.current = null;
      setSinalStatus("off");
      return;
    }
    let ativo = true;
    setSinalStatus("conectando");
    const sinal = new Sinalizador({
      onConectado: (ok) => {
        if (!ativo) return;
        setSinalStatus(ok ? "conectado" : "conectando");
        if (ok) {
          // Re-envia convites aos contatos que estavam online (recuperação)
          contatosRef.current.forEach((c) => {
            if (c.estado === "online" && !pendentesRef.current.has(chaveDe(c.idPublico ?? c.nome))) {
              tentarAutoConectar(c.idPublico ?? c.nome);
            }
          });
        }
      },
      onPresenca: (chave, online, nome) => {
        if (!ativo) return;
        setContatos((c) =>
          c.map((x) =>
            chaveDe(x.idPublico ?? x.nome) === chave
              ? { ...x, estado: (online ? "online" : "offline") as "online" | "conectando" | "offline" }
              : x,
          ),
        );
        if (online) tentarAutoConectar(nome ?? chave);
      },
      onSinal: (s) => {
        if (!ativo) return;
        const sinalAtivo = sinalRef.current;
        if (!sinalAtivo) return;
        if (s.tipo === "convite") {
          const chave = chaveDe(s.de);
          // Desempate: se já enviamos convite a essa pessoa, o nosso vale
          // (o dela chega junto e seria conexão duplicada)
          if (pendentesRef.current.has(chave)) return;
          // Já conectado a ela?
          if (contatosRef.current.some((x) => chaveDe(x.idPublico ?? x.nome) === chave && x.estado === "online")) {
            return;
          }
          // Dedupe: o broker pode reentregar o MESMO convite (QoS 0)
          if (respondendoRef.current.has(chave)) return;
          if (!estadoIdentidade().desbloqueada) return;
          const contato = contatosRef.current.find((x) => chaveDe(x.idPublico ?? x.nome) === chave);
          const esperado = contato?.id && contato.id.length === 64 ? contato.id : undefined;
          const pm = criarPeerManager(esperado);
          peerManagerRef.current = pm;
          respondendoRef.current.add(chave);
          void (async () => {
            try {
              const resposta = await pm.responderConvite(s.dados);
              sinalAtivo.enviarSinal(s.de, "resposta", resposta);
            } catch (e) {
              respondendoRef.current.delete(chave);
              setChatAviso(`Convite rejeitado: ${e instanceof Error ? e.message : "erro"}`);
              window.setTimeout(() => setChatAviso(""), 6000);
            }
          })();
        } else if (s.tipo === "resposta") {
          const chave = chaveDe(s.de);
          const p = pendentesRef.current.get(chave);
          if (!p) return;
          window.clearTimeout(p.timer);
          pendentesRef.current.delete(chave);
          void p.pm.completarConvite(s.dados).catch((e) => {
            setChatAviso(`Falha ao concluir a conexão: ${e instanceof Error ? e.message : "erro"}`);
            window.setTimeout(() => setChatAviso(""), 6000);
          });
        }
      },
    });
    sinalRef.current = sinal;
    void sinal.iniciar(st.idPublico).then(() => {
      if (!ativo) return;
      sinal.assinarInbox();
      contatosRef.current.forEach((c) => sinal.assinarPresenca(c.idPublico ?? c.nome));
    });
    return () => {
      ativo = false;
      sinal.fechar();
      if (sinalRef.current === sinal) sinalRef.current = null;
      pendentesRef.current.forEach((p) => window.clearTimeout(p.timer));
      pendentesRef.current.clear();
      respondendoRef.current.clear();
    };
  }, [identEstado.criada, identEstado.desbloqueada, identEstado.idPublico, tentarAutoConectar]);

  // ——— Alertas de agenda: avisa em voz minutos antes e na hora do evento ———
  useEffect(() => {
    try {
      const saved = Number(window.localStorage.getItem("ares-alerta-antes") ?? "5");
      if (Number.isFinite(saved) && saved > 0) alertaAntesMinRef.current = Math.min(60, saved);
    } catch {
      /* sem storage */
    }
    const checar = async () => {
      try {
        const res = await fetch("/api/agenda");
        const data = (await res.json()) as { agenda?: AgendaItemLite[] };
        const agora = Date.now();
        const antesMs = alertaAntesMinRef.current * 60000;
        for (const e of data.agenda ?? []) {
          const prox = proximaOcorrencia(e, agora);
          if (prox === null) continue;
          const falta = prox - agora;
          if (falta >= 0 && falta <= antesMs && !alertasDisparadosRef.current.has(`${e.id}:lead`)) {
            alertasDisparadosRef.current.add(`${e.id}:lead`);
            const mins = Math.max(1, Math.round(falta / 60000));
            const texto =
              falta <= 60000
                ? `Falta menos de um minuto para ${e.titulo}.`
                : `Faltam ${mins} minutos para ${e.titulo}.`;
            assistantRef.current?.speak(texto);
            const item = { id: e.id, titulo: e.titulo, quando: prox };
            setAlertasEvento((a) => [...a, item]);
            window.setTimeout(() => {
              setAlertasEvento((a) => a.filter((x) => x.id !== item.id));
            }, 25000);
            setEmotionFlash("confirming");
            if (flashTimerRef.current) window.clearTimeout(flashTimerRef.current);
            flashTimerRef.current = window.setTimeout(() => setEmotionFlash(null), 6000);
          }
          if (falta >= 0 && falta <= 30000 && !alertasDisparadosRef.current.has(`${e.id}:hora`)) {
            alertasDisparadosRef.current.add(`${e.id}:hora`);
            assistantRef.current?.speak(`É agora: ${e.titulo}!`);
            try {
              beep();
            } catch {
              /* sem áudio */
            }
            setEmotionFlash("happy");
            if (flashTimerRef.current) window.clearTimeout(flashTimerRef.current);
            flashTimerRef.current = window.setTimeout(() => setEmotionFlash(null), 4000);
          }
        }
      } catch {
        /* agenda indisponível — tenta de novo no próximo tick */
      }
    };
    const iv = window.setInterval(checar, 20000);
    void checar();
    return () => window.clearInterval(iv);
  }, []);

  // ——— Atualizações automáticas: a IA avisa em voz e a página recarrega ———
  useEffect(() => {
    let ativo = true;
    let ultimaFase = "";
    let viuReiniciando = false;
    const tick = async () => {
      try {
        const res = await fetch("/api/updates");
        if (!res.ok) return;
        const st = (await res.json()) as {
          fase: string;
          mensagem: string;
          reiniciando?: boolean;
        };
        if (!ativo) return;
        const fase = st.fase;
        if (fase === "baixando" || fase === "aplicando") {
          if (ultimaFase !== "baixando" && ultimaFase !== "aplicando") {
            assistantRef.current?.speak("Recebendo atualização.");
          }
        } else if (fase === "aplicado") {
          if (ultimaFase !== "aplicado") {
            assistantRef.current?.speak(
              st.reiniciando
                ? "Atualização instalada. Reiniciando o sistema."
                : "Atualização instalada.",
            );
          }
          if (st.reiniciando) viuReiniciando = true;
        } else if (fase === "ocioso" && viuReiniciando) {
          // Servidor reiniciou com a versão nova — recarrega para ativar.
          viuReiniciando = false;
          window.location.reload();
          return;
        } else if (fase === "erro" && ultimaFase !== "erro") {
          assistantRef.current?.speak("Falha ao receber atualização.");
        }
        ultimaFase = fase;
      } catch {
        /* servidor reiniciando — espera o próximo tick */
      }
    };
    const iv = window.setInterval(tick, 15000);
    void tick();
    return () => {
      ativo = false;
      window.clearInterval(iv);
    };
  }, []);

  // ——— Modo interface: a mão vira um cursor que seleciona/arrasta/redimensiona painéis.
  // Extraído do tracker para poder ser dirigido por uma mão simulada (teste).
  const handleHands = useCallback((hands: HandStateData[]) => {
    const cursor = handCursorRef.current;
    // O cursor da mão (indicador do tracker) só aparece no modo interface —
    // no modo normal as mãos giram/zoomam o orbe sem poluir a tela.
    const pinched = hands.find((h) => h.pinching) ?? hands[0];
    if (!pinched || !interfaceModeRef.current) {
      if (cursor) cursor.style.opacity = "0";
      return;
    }
    const x = pinched.x * window.innerWidth;
    const y = pinched.y * window.innerHeight;
    if (cursor) {
      cursor.style.opacity = "1";
      cursor.style.transform = `translate(${x - 17}px, ${y - 17}px)`;
    }

    // Hit-test geométrico (retângulos) em vez de elementFromPoint: painéis
    // só-exibição (relógio/título/dica) têm pointer-events:none no CSS e o
    // elementFromPoint atravessaria até o canvas do orbe, nunca selecionando-os.
    const panelEl = (() => {
      let hit: HTMLElement | null = null;
      const els = document.querySelectorAll("[data-panel]") as NodeListOf<HTMLElement>;
      for (const el of els) {
        const r = el.getBoundingClientRect();
        if (r.width > 10 && x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) {
          hit = el; // último na ordem do DOM vence (painéis sobrepostos)
        }
      }
      return hit;
    })();
    const panelId = (panelEl?.dataset.panel ?? null) as PanelId | null;
    if (pinched.pinching) {
      const move = handMoveRef.current;
      // Com a pinça ativa, mantém o painel já ancorado: não troca de alvo no meio
      // do arrasto nem re-ancora quando o cursor encosta na borda do painel
      // (isso era o que fazia o painel “pular”/tremular).
      if (move) {
        const alvo = document.querySelector(`[data-panel="${move.panel}"]`) as HTMLElement | null;
        if (!alvo) return;
        // Deadband de 2 px: micro-tremor da mão não move o painel
        const d = Math.hypot(x - move.lastX, y - move.lastY);
        if (d < 2) return;
        const px = Math.min(Math.max(0, x - move.startX + move.origLeft), window.innerWidth - 60);
        const py = Math.min(Math.max(0, y - move.startY + move.origTop), window.innerHeight - 40);
        alvo.style.left = `${px}px`;
        alvo.style.top = `${py}px`;
        alvo.style.right = "auto";
        alvo.style.bottom = "auto";
        // Preserva o scale aplicado pelo redimensionar (gesto de duas mãos)
        const esc = panelScaleRef.current[move.panel] ?? 1;
        alvo.style.transform = esc === 1 ? "none" : `scale(${esc})`;
        move.lastX = x;
        move.lastY = y;
      } else if (panelEl && panelId) {
        const r = panelEl.getBoundingClientRect();
        handMoveRef.current = {
          panel: panelId,
          startX: x,
          startY: y,
          lastX: x,
          lastY: y,
          origLeft: r.left,
          origTop: r.top,
        };
        setSelectedPanel(panelId);
      }
    } else {
      handMoveRef.current = null;
    }
  }, []);

  // Hook de teste: ?gestos=sim — mão virtual que mira cada painel do HUD, pinça
  // e arrasta em círculo (cruzando as bordas do painel de propósito, para
  // conferir que ele não “pula” nem treme), solta e parte para o próximo.
  useEffect(() => {
    if (typeof window === "undefined") return;
    if (!window.location.search.includes("gestos=sim")) return;
    // Variante de teste: ?gestos=sim&normal=1 simula as mãos SEM ligar o modo
    // interface (para conferir que o cursor fica oculto no modo normal).
    if (!window.location.search.includes("normal=1")) setInterfaceMode(true);
    const ALVOS: PanelId[] = ["title", "clock", "controls", "hint", "voice", "log"];
    let raf = 0;
    const t0 = performance.now();
    let alvoEl: HTMLElement | null = null;
    let centro = { x: 0.5, y: 0.5 };
    let fase: "aproximar" | "puxar" | "soltar" = "aproximar";
    let faseInicio = t0;
    let alvoIdx = 0;
    const DUR = { aproximar: 1100, puxar: 3400, soltar: 450 };
    const ease = (k: number) => 1 - Math.pow(1 - k, 3);
    const tick = (now: number) => {
      // Próximo alvo visível (ignora painéis ocultos: log/voice sem conteúdo)
      if (!alvoEl || !alvoEl.isConnected) {
        alvoEl = null;
        for (let k = 0; k < ALVOS.length; k++) {
          const cand = document.querySelector(
            `[data-panel="${ALVOS[(alvoIdx + k) % ALVOS.length]}"]`,
          ) as HTMLElement | null;
          if (cand && cand.getBoundingClientRect().width > 10) {
            alvoIdx = (alvoIdx + k) % ALVOS.length;
            alvoEl = cand;
            const r = cand.getBoundingClientRect();
            centro = {
              x: (r.left + r.width / 2) / window.innerWidth,
              y: (r.top + r.height / 2) / window.innerHeight,
            };
            fase = "aproximar";
            faseInicio = now;
            break;
          }
        }
        if (!alvoEl) {
          raf = requestAnimationFrame(tick);
          return;
        }
      }
      const dt = now - faseInicio;
      const t = (now - t0) / 1000;
      let x = 0.5;
      let y = 0.92;
      let pinching = false;
      if (fase === "aproximar") {
        const e = ease(Math.min(1, dt / DUR.aproximar));
        x = 0.5 + (centro.x - 0.5) * e;
        y = 0.92 + (centro.y - 0.92) * e;
        if (dt >= DUR.aproximar) {
          fase = "puxar";
          faseInicio = now;
        }
      } else if (fase === "puxar") {
        // Círculo de ±5% da tela em volta do centro — cruza as bordas do painel
        x = centro.x + 0.05 * Math.sin(t * 0.9);
        y = centro.y + 0.05 * Math.cos(t * 1.1);
        pinching = true;
        if (dt >= DUR.puxar) {
          fase = "soltar";
          faseInicio = now;
        }
      } else {
        const e = ease(Math.min(1, dt / DUR.soltar));
        x = centro.x + 0.05 * Math.sin(t * 0.9) * (1 - e);
        y = centro.y + 0.05 * Math.cos(t * 1.1) * (1 - e);
        if (dt >= DUR.soltar) {
          alvoEl = null;
          alvoIdx = (alvoIdx + 1) % ALVOS.length;
        }
      }
      handleHands([{ x, y, pinching, indexX: x, indexY: y }]);
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [handleHands]);

  // ——— Câmera: hand tracking (gestos no orbe / modo interface) + rPPG + bem-estar ———
  const stopCamera = useCallback(() => {
    cameraOnRef.current = false;
    handTrackerRef.current?.stop();
    handTrackerRef.current = null;
    rppgRef.current?.stop();
    rppgRef.current = null;
    wellnessRef.current?.stop();
    wellnessRef.current = null;
    cameraStreamRef.current?.getTracks().forEach((t) => t.stop());
    cameraStreamRef.current = null;
    if (videoRef.current) videoRef.current.srcObject = null;
    setCameraOn(false);
    setCameraState("off");
    setBpm(null);
    setTrackerStatus({ hands: 0, mode: "idle" });
    setInterfaceMode(false);
    setSelectedPanel(null);
    handMoveRef.current = null;
    if (handCursorRef.current) handCursorRef.current.style.opacity = "0";
  }, []);

  const startCamera = useCallback(async () => {
    setCameraState("starting");
    try {
      const video = videoRef.current;
      const overlay = overlayRef.current;
      if (!video || !overlay) throw new Error("vídeo indisponível");

      // 1) Vídeo: abre a câmera e mostra o preview imediatamente
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { width: 640, height: 480, facingMode: "user" },
        audio: false,
      });
      cameraStreamRef.current = stream;
      video.srcObject = stream;
      await video.play().catch(() => {});

      // 2) rPPG + bem-estar em paralelo: o BPM funciona mesmo que o modelo de
      //    mãos (MediaPipe, baixado da CDN) falhe ou demore a carregar
      const rppg = new RppgMonitor(video, {
        onBpm: (b) => {
          // Com ?bpm= na URL, mantém o valor simulado (hook de teste)
          if (BPM_TEST_PARAM !== null) return;
          setBpm(b);
          wellnessRef.current?.setBpm(b);
        },
      });
      rppg.start();
      rppgRef.current = rppg;

      const wellness = new WellnessMonitor({
        onSugestao: (s) => assistantRef.current?.speak(s.texto),
      });
      wellness.start();
      wellnessRef.current = wellness;

      // 3) HUD “ligado” assim que o vídeo está no ar — não fica preso em
      //    “INICIANDO…” esperando o modelo de mãos
      cameraOnRef.current = true;
      setCameraState("on");
      setCameraOn(true);

      // 4) Hand tracking com timeout: se o modelo não carregar em 25s, a
      //    câmera e o BPM seguem — só os gestos ficam indisponíveis
      const tracker = new HandTracker(video, overlay, {
        // Gestos no orbe: pinça arrasta (gira) e duas mãos afastam/aproximam (zoom)
        onRotate: (dt, dp) => sceneRef.current?.rotateBy(dt, dp),
        onZoom: (f) => sceneRef.current?.zoomBy(f),
        onStatus: setTrackerStatus,
        onHands: handleHands,
        // Duas mãos afastando/aproximando no modo interface: redimensiona o painel selecionado
        onResize: (factor) => {
          const sel = selectedPanelRef.current;
          if (!sel) return;
          const panel = document.querySelector(`[data-panel="${sel}"]`) as HTMLElement | null;
          if (!panel) return;
          const cur = panelScaleRef.current[sel] ?? 1;
          const next = Math.min(2, Math.max(0.5, cur * factor));
          panelScaleRef.current[sel] = next;
          panel.style.transform = `scale(${next})`;
        },
        // Palma dupla: sai do modo interface
        onDoubleClap: () => {
          if (interfaceModeRef.current) {
            setInterfaceMode(false);
            setSelectedPanel(null);
            handMoveRef.current = null;
            assistantRef.current?.speak("Saindo do modo interface.");
          }
        },
        onClap: () => {
          /* feedback de palma (sem ação extra) */
        },
      });
      const modelPromise = tracker.start(stream);
      const modelTimeout = new Promise<never>((_, rej) => {
        window.setTimeout(() => rej(new Error("modelo de mãos não carregou a tempo")), 25000);
      });
      try {
        await Promise.race([modelPromise, modelTimeout]);
        handTrackerRef.current = tracker;
        setHandModelOk(true);
      } catch {
        // Sem modelo de mãos: câmera e BPM continuam; só os gestos ficam fora.
        // Se o modelo chegar depois do timeout, ativa os gestos mesmo assim.
        handTrackerRef.current = null;
        setHandModelOk(false);
        modelPromise
          .then(() => {
            handTrackerRef.current = tracker;
            setHandModelOk(true);
          })
          .catch(() => {});
      }
    } catch {
      // Falhou antes do vídeo (permissão negada, câmera ocupada etc.)
      setCameraState("error");
    }
  }, []);

  const toggleCamera = useCallback(() => {
    if (cameraOnRef.current) stopCamera();
    else void startCamera();
  }, [startCamera, stopCamera]);

  const toggleInterfaceMode = useCallback(() => {
    setInterfaceMode((m) => {
      const next = !m;
      if (!next) {
        setSelectedPanel(null);
        handMoveRef.current = null;
        if (handCursorRef.current) handCursorRef.current.style.opacity = "0";
      }
      return next;
    });
  }, []);

  // Refs estáveis para o assistant (criado uma vez) e o teclado enxergarem os handlers
  const startCameraRef = useRef<() => void>(() => {});
  const stopCameraRef = useRef<() => void>(() => {});
  startCameraRef.current = () => void startCamera();
  stopCameraRef.current = stopCamera;

  // Preferências de voz salvas: sincroniza com o módulo de fala ao montar
  useEffect(() => {
    setVoiceSettings(voicePrefs);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Volume do player de música segue o slider por voz
  useEffect(() => {
    const audio = musicAudioRef.current;
    if (audio && Number.isFinite(musicVol)) audio.volume = musicVol / 100;
  }, [musicVol]);

  // Limpeza de timers/intervalos do componente no unmount
  useEffect(() => {
    return () => {
      if (flashTimerRef.current) window.clearTimeout(flashTimerRef.current);
      handTrackerRef.current?.stop();
      rppgRef.current?.stop();
      wellnessRef.current?.stop();
      cameraStreamRef.current?.getTracks().forEach((t) => t.stop());
    };
  }, []);

  // Tick de 1s: contagem regressiva dos timers + relógio digital de Brasília
  useEffect(() => {
    const iv = window.setInterval(() => {
      setNowTick((n) => n + 1);
      setClockNow(new Date());
    }, 1000);
    return () => window.clearInterval(iv);
  }, []);

  // ——— Memória editável (painel HUD) ———
  const loadMemory = useCallback(async () => {
    try {
      const res = await fetch("/api/memory");
      if (!res.ok) throw new Error("memória indisponível");
      setMemory((await res.json()) as MemoryData);
      setMemoryMsg("");
    } catch {
      setMemoryMsg("Não consegui carregar a memória.");
    }
  }, []);

  /** Abre a janela CALENDÁRIO e salta para o mês/dia atuais (relógio + voz). */
  const openCalendarWin = useCallback(() => {
    setCalendarOpen(true);
    void loadMemory();
    const d = new Date();
    setCalMes({ ano: d.getFullYear(), mes: d.getMonth() });
    setCalDiaSel(d.getDate());
  }, [loadMemory]);

  const toggleMemory = useCallback(() => {
    setMemoryOpen((open) => {
      if (!open) {
        void loadMemory();
        // Abre o calendário no mês atual com o dia de hoje selecionado
        const d = new Date();
        setCalMes({ ano: d.getFullYear(), mes: d.getMonth() });
        setCalDiaSel(d.getDate());
      }
      return !open;
    });
  }, [loadMemory]);

  const memoryAdd = useCallback(
    async (section: "usuario" | "contatos" | "fatos" | "tarefas" | "notas" | "historicoMusica" | "agenda", key: string, value: string): Promise<boolean> => {
      try {
        const res = await fetch("/api/memory", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ section, key, value }),
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
        setMemoryMsg(data?.message ?? (res.ok ? "Memória atualizada." : "Falha ao salvar."));
        await loadMemory();
        return data?.ok ?? res.ok;
      } catch {
        setMemoryMsg("Falha ao salvar na memória.");
        return false;
      }
    },
    [loadMemory],
  );

  const memoryRemove = useCallback(
    async (section: "usuario" | "contatos" | "fatos" | "tarefas" | "notas" | "historicoMusica" | "agenda", key: string) => {
      const res = await fetch("/api/memory", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ section, key }),
      });
      const data = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;
      setMemoryMsg(data?.message ?? (res.ok ? "Item removido." : "Falha ao remover."));
      await loadMemory();
    },
    [loadMemory],
  );

  // ——— Player de áudio: busca no YouTube e toca só o áudio ———
  /** Pré-resolve URLs de áudio no servidor (cache) — os próximos plays ficam quase instantâneos. */
  const prefetchMusic = useCallback((faixas: Array<{ id: string }>, aPartirDe: number) => {
    const ids = faixas.slice(aPartirDe, aPartirDe + 3).map((t) => t.id).filter(Boolean);
    if (ids.length === 0) return;
    void fetch(`/api/audio?action=prefetch&ids=${encodeURIComponent(ids.join(","))}`).catch(() => {});
  }, []);

  const playMusicTrack = useCallback(
    (idx: number) => {
      const faixa = musicTracks[idx];
      if (!faixa) return;
      setMusicIdx(idx);
      setMusicErro("");
      // Zera o progresso ao trocar de faixa (evita o flash do tempo anterior)
      setMusicTime(0);
      setMusicDur(0);
      const audio = musicAudioRef.current;
      if (audio) {
        audio.src = `/api/audio?action=stream&id=${encodeURIComponent(faixa.id)}`;
        audio.volume = musicVol / 100;
        void audio.play().catch((err: unknown) => {
          // Autoplay bloqueado (comando de voz não é gesto do usuário): o
          // primeiro clique no play libera — mostra aviso em vez de erro.
          const name = err instanceof DOMException ? err.name : "";
          setMusicErro(
            name === "NotAllowedError"
              ? "Toque no play para liberar o som (o navegador bloqueia o primeiro áudio automático)."
              : "Não consegui reproduzir o áudio.",
          );
        });
      }
      // Pré-resolve as próximas faixas em segundo plano (avançar fica rápido)
      prefetchMusic(musicTracks, idx + 1);
    },
    [musicTracks, musicVol, prefetchMusic],
  );

  /** Arrasta a barra de progresso do player. */
  const seekMusic = (t: number) => {
    const audio = musicAudioRef.current;
    if (!audio || !Number.isFinite(t)) return;
    audio.currentTime = t;
    setMusicTime(t);
  };

  /** Expande a playlist: busca novas faixas e mescla com as atuais (sem duplicar). */
  const expandMusic = useCallback(
    async (busca: string) => {
      setMusicLoading(true);
      try {
        const res = await fetch(`/api/audio?action=search&q=${encodeURIComponent(busca)}`);
        const data = (await res.json()) as {
          ok?: boolean;
          message?: string;
          faixas?: Array<{ id: string; titulo: string; artista: string; duracao: number; durLabel: string; thumb: string; album?: boolean }>;
        };
        if (!data.ok || !data.faixas?.length) {
          setMusicErro(data.message ?? "Não encontrei músicas para expandir.");
          return;
        }
        // Mescla sem duplicar por id DENTRO do updater funcional (evita a
        // corrida de closure quando dois cliques rápidos capturam a lista velha)
        let novas: typeof data.faixas = [];
        setMusicTracks((prev) => {
          const ids = new Set(prev.map((t) => t.id));
          novas = data.faixas!.filter((f) => !ids.has(f.id));
          if (novas.length === 0) return prev;
          return [...prev, ...novas].slice(0, 60); // teto total da playlist
        });
        if (novas.length === 0) {
          setMusicErro("Já estão todas na playlist.");
          return;
        }
        setMusicErro("");
        // Atualiza as sugestões com base na nova busca
        setMusicSugestoes((sug) => {
          if (sug.length === 0) return sug;
          const primeiroArtista = novas[0]?.artista ?? "";
          const next = [...sug];
          // "Mais do artista" novo vai primeiro se existir
          if (primeiroArtista && !next.some((s) => s.busca.includes(primeiroArtista))) {
            next.unshift({
              rotulo: `Mais de ${primeiroArtista}`,
              busca: primeiroArtista,
              icone: "bi-person-plus",
            });
          }
          return next.slice(0, 4);
        });
      } catch {
        setMusicErro("Não consegui expandir a playlist.");
      } finally {
        setMusicLoading(false);
      }
    },
    [],
  );

  const openMusic = useCallback(async (query: string) => {
    setMusicQuery(query);
    setMusicTracks([]);
    setMusicIdx(-1);
    setMusicErro("");
    setMusicSugestoes([]);
    setMusicWin({ min: false, max: false });
    setMusicOpen(true);
    if (!query.trim()) {
      // "abre o player de música" sem busca: só mostra a janela pronta
      setMusicLoading(false);
      return;
    }
    setMusicLoading(true);
    try {
      // Busca direto (sem pre-flight de status: a própria busca devolve a
      // mensagem honesta se o yt-dlp estiver ausente/instalando).
      const res = await fetch(`/api/audio?action=search&q=${encodeURIComponent(query)}`);
      const data = (await res.json()) as {
        ok?: boolean;
        message?: string;
        faixas?: Array<{ id: string; titulo: string; artista: string; duracao: number; durLabel: string; thumb: string; album?: boolean }>;
      };
      if (!data.ok || !data.faixas?.length) {
        setMusicErro(data.message ?? "Não encontrei músicas para essa busca.");
        return;
      }
      setMusicTracks(data.faixas);
      // Pré-resolve o áudio das 3 primeiras no servidor (cache) — o primeiro
      // play fica quase instantâneo em vez de esperar o yt-dlp resolver.
      void prefetchMusic(data.faixas, 0);
      // Chips de sugestão: "mais do artista" + "semelhantes" para expandir
      const artistaPrincipal = data.faixas[0]?.artista ?? "";
      const sugs: Array<{ rotulo: string; busca: string; icone: string }> = [];
      if (artistaPrincipal) {
        sugs.push({ rotulo: `Mais de ${artistaPrincipal}`, busca: artistaPrincipal, icone: "bi-person-plus" });
      }
      sugs.push({ rotulo: `Semelhantes a ${query}`, busca: `${query} similar songs`, icone: "bi-stars" });
      setMusicSugestoes(sugs.slice(0, 3));
      // Guarda no histórico da memória (o ARES lembra e pode sugerir de novo)
      void fetch("/api/memory", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          section: "historicoMusica",
          key: String(data.faixas.length),
          value: query,
        }),
      }).catch(() => {});
      // Toca a primeira já — o atraso pequeno deixa o prefetch aquecer o cache
      window.setTimeout(() => playMusicTrack(0), 180);
    } catch {
      setMusicErro("Não consegui buscar as músicas.");
    } finally {
      setMusicLoading(false);
    }
  }, [playMusicTrack]);

  const closeMusic = useCallback(() => {
    setMusicOpen(false);
    setMusicTracks([]);
    setMusicIdx(-1);
    const audio = musicAudioRef.current;
    if (audio) {
      audio.pause();
      audio.removeAttribute("src");
    }
  }, []);

  /** Refs para o assistant (criado uma vez) enxergar os handlers mais novos */
  const openMusicRef = useRef<typeof openMusic>(async () => {});
  const musicControlRef = useRef<(acao: MusicAction) => void>(() => {});

  const musicControl = useCallback(
    (acao: MusicAction) => {
      if (acao.tipo === "fechar") {
        closeMusic();
        return;
      }
      if (acao.tipo !== "controle") return;
      const { acao: cmd, valor } = acao;
      const audio = musicAudioRef.current;
      if (cmd === "volume") {
        setMusicVol((v) => Math.min(100, Math.max(0, v + (valor ?? 10))));
        return;
      }
      if (!audio || musicTracks.length === 0) return;
      if (cmd === "play") void audio.play().catch(() => {});
      else if (cmd === "pause") audio.pause();
      else if (cmd === "proxima") playMusicTrack((musicIdx + 1) % musicTracks.length);
      else if (cmd === "anterior") playMusicTrack((musicIdx - 1 + musicTracks.length) % musicTracks.length);
    },
    [closeMusic, musicTracks, musicIdx, playMusicTrack],
  );
  openMusicRef.current = openMusic;
  musicControlRef.current = musicControl;

  // Arrastar janelas de app (navegador/explorer/terminal/editor) pela barra de
  // título com o MOUSE, sempre — os painéis do HUD (comandos/voz/registro)
  // continuam restritos ao modo interface (mãos).
  const windowDragRef = useRef<{ dx: number; dy: number } | null>(null);
  const startWindowDrag = useCallback((e: React.PointerEvent) => {
    // Clique nos botões de controle (min/max/fechar) não arrasta a janela
    if ((e.target as HTMLElement).closest(".win-btn")) return;
    e.preventDefault();
    e.stopPropagation();
    const el = e.currentTarget.closest(".win-window") as HTMLElement | null;
    if (!el) return;
    const r = el.getBoundingClientRect();
    windowDragRef.current = { dx: e.clientX - r.left, dy: e.clientY - r.top };
    el.style.position = "fixed";
    el.style.left = `${r.left}px`;
    el.style.top = `${r.top}px`;
    el.style.right = "auto";
    el.style.margin = "0";
    el.style.transform = "none";
    const onMove = (ev: PointerEvent) => {
      const d = windowDragRef.current;
      if (!d) return;
      el.style.left = `${ev.clientX - d.dx}px`;
      el.style.top = `${ev.clientY - d.dy}px`;
    };
    const onUp = () => {
      windowDragRef.current = null;
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerup", onUp);
      window.removeEventListener("pointercancel", onUp);
    };
    window.addEventListener("pointermove", onMove);
    window.addEventListener("pointerup", onUp);
    window.addEventListener("pointercancel", onUp);
  }, []);

  // Redimensionar janelas de app pelo canto inferior direito (mouse, sempre)
  // Restaura janelas maximizadas ao tentar arrastar (comportamento do Windows)
  const windowResizeRef = useRef<{
    startX: number;
    startY: number;
    origW: number;
    origH: number;
    origLeft: number;
    origTop: number;
  } | null>(null);
  const startWindowResize = useCallback((e: React.PointerEvent) => {
    if ((e.target as HTMLElement).closest(".win-btn")) return;
    e.preventDefault();
    e.stopPropagation();
    const el = e.currentTarget.closest(".win-window") as HTMLElement | null;
    if (!el) return;
    const r = el.getBoundingClientRect();
    // Converte o posicionamento (transform centralizado) para coordenadas fixas
    el.style.position = "fixed";
    el.style.left = `${r.left}px`;
    el.style.top = `${r.top}px`;
    el.style.right = "auto";
    el.style.margin = "0";
    el.style.transform = "none";
    el.style.width = `${r.width}px`;
    el.style.height = `${r.height}px`;
    windowResizeRef.current = {
      startX: e.clientX,
      startY: e.clientY,
      origW: r.width,
      origH: r.height,
      origLeft: r.left,
      origTop: r.top,
    };
    const onMove = (ev: PointerEvent) => {
      const g = windowResizeRef.current;
      if (!g) return;
      const w = Math.max(360, g.origW + (ev.clientX - g.startX));
      const h = Math.max(200, g.origH + (ev.clientY - g.startY));
      el.style.width = `${w}px`;
      el.style.height = `${h}px`;
      el.style.maxWidth = "calc(100vw - 16px)";
      el.style.maxHeight = "calc(100vh - 16px)";
    };
    const onUp = () => {
      windowResizeRef.current = null;
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerup", onUp);
      window.removeEventListener("pointercancel", onUp);
    };
    window.addEventListener("pointermove", onMove);
    window.addEventListener("pointerup", onUp);
    window.addEventListener("pointercancel", onUp);
  }, []);

  // ——— WhatsApp: status / conversas / mensagens (janela do HUD) ———
