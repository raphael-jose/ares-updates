// Onde os painéis HUD ficam por padrão (topo esquerdo → escala a partir do canto)
/**
 * Se o texto contém uma URL de imagem DIRETA (extensão de imagem ou host de
 * imagens conhecido), devolve essa URL — para o HUD abrir o visualizador.
 */
function extractImageUrl(text: string): string | null {
  const urls = text.match(/https?:\/\/[^\s"'<>]+/gi) ?? [];
  const IMG_HOST =
    /(?:upload\.wikimedia\.org|i\.imgur\.com|images\.unsplash\.com|cdn\.pixabay\.com|live\.staticflickr\.com|media\.istockphoto\.com|picsum\.photos|pbs\.twimg\.com|i\.ytimg\.com|image\.tmdb\.org|cdn\.images\.express\.co\.uk|images\.pexels\.com)$/i;
  for (const raw of urls) {
    const u = raw.replace(/[.,;:!?()\])]+$/g, "");
    try {
      const parsed = new URL(u);
      const path = parsed.pathname.toLowerCase();
      const isExt = /\.(jpe?g|png|gif|webp|bmp|avif)(\?|$)/.test(path);
      const isHost = IMG_HOST.test(parsed.hostname.toLowerCase());
      if (isExt || isHost) return u;
    } catch {
      /* URL inválida: segue para a próxima */
    }
  }
  return null;
}

/** Linha do modo leitura com os termos da busca destacados (<mark>). */
function EditorLineMark({ line, term }: { line: string; term: string }): ReactNode {
  if (!term) return <>{line || " "}</>;
  const lower = line.toLowerCase();
  const t = term.toLowerCase();
  const parts: ReactNode[] = [];
  let i = 0;
  let idx = 0;
  let key = 0;
  while ((idx = lower.indexOf(t, i)) !== -1) {
    if (idx > i) parts.push(<span key={key++}>{line.slice(i, idx)}</span>);
    parts.push(
      <mark key={key++} className="editor-find-hit">
        {line.slice(idx, idx + t.length)}
      </mark>,
    );
    i = idx + t.length;
  }
  if (i < line.length) parts.push(<span key={key++}>{line.slice(i)}</span>);
  return parts.length ? <>{parts}</> : (line || " ");
}

/** Quebra um caminho em segmentos clicáveis (C:/a/b → [C:, a, b]). */
function pathSegments(p: string): Array<{ nome: string; caminho: string }> {
  const parts = (p ?? "").split(/[\\/]+/).filter(Boolean);
  let acc = "";
  return parts.map((part) => {
    acc = acc ? `${acc}/${part}` : part;
    // Segmento de drive (C:) deve navegar para a raiz C:/
    if (/^[A-Za-z]:$/.test(acc)) acc = `${acc}/`;
    return { nome: part, caminho: acc };
  });
}

