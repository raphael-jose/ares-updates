  }, [typedText]);

  const voiceOn = voice === "on";

  // ——— Identidade criptográfica: criar / desbloquear ———
  const abrirIdentidade = useCallback(() => {
    const st = estadoIdentidade();
    setIdentEstado(st);
    setIdentModo(st.criada ? "desbloquear" : "criar");
    setIdentMsg("");
    setIdentSenha("");
    setIdentAberto(true);
  }, []);

  const salvarIdentidade = useCallback(async () => {
    if (identModo === "criar") {
      const r = await criarIdentidade(identNome, identSenha);
      if (!r.ok) {
        setIdentMsg(r.erro ?? "Erro ao criar identidade.");
        return;
      }
      setIdentMsg("✓ Identidade criada! Guarde bem a senha — é ela que protege sua chave privada.");
    } else {
      const r = await desbloquearIdentidade(identSenha);
      if (!r.ok) {
        setIdentMsg(r.erro ?? "Erro ao desbloquear.");
        return;
      }
      setIdentMsg("✓ Identidade desbloqueada nesta sessão.");
    }
    setIdentEstado(estadoIdentidade());
    setIdentSenha("");
  }, [identModo, identNome, identSenha]);

  const bloquearIdent = useCallback(() => {
    bloquearIdentidade();
    setIdentEstado(estadoIdentidade());
    setIdentMsg("Identidade bloqueada.");
  }, []);

  // ——— Verificação manual do fingerprint (peers inesperados apenas) ———
  const confirmarVerificacao = useCallback(() => {
    const p = verifPendente;
    if (!p) return;
    confiarContato(p.peer, p.pm);
    setVerifPendente(null);
    verifPmRef.current = null;
    setConviteMsg("");
  }, [verifPendente, confiarContato]);

  const recusarVerificacao = useCallback(() => {
    const p = verifPendente;
    if (!p) return;
    p.pm.fechar("verificação de identidade recusada");
    peerManagersRef.current.delete(p.peer.fingerprint);
    setPeerRemoto((r) => (r === p.peer.fingerprint ? null : r));
    setVerifPendente(null);
    verifPmRef.current = null;
    setChatAviso("Conexão recusada — identidade não confirmada. O contato NÃO foi adicionado.");
    window.setTimeout(() => setChatAviso(""), 6000);
  }, [verifPendente]);

  const copiarTexto = useCallback((txt: string) => {
    void navigator.clipboard?.writeText(txt).catch(() => {});
  }, []);

  // ——— CHAT P2P: contatos, conversas e mensagens ricas ———
  // Adiciona um contato pelo ID público amigável ("Nome#XXXX"). Sem servidor
  // central, não dá para localizar um ID arbitrário offline: o contato entra no
  // catálogo como offline e as chaves são preenchidas ao conectar por convite.
  const adicionarContato = useCallback(() => {
    const idPublico = chatNovoId.trim();
    if (!idPublico) return;
    const nome = chatNovoNome.trim() || idPublico.split("#")[0] || idPublico.slice(0, 12);
    const chaveLocal = idPublico.toLowerCase();
    setContatos((c) => {
      if (c.some((x) => x.idPublico.toLowerCase() === chaveLocal || x.id === chaveLocal)) return c;
      return [
        ...c,
        { id: chaveLocal, nome, idPublico, estado: "offline", quando: Date.now() },
      ];
    });
    setConversas((conv) =>
      conv[chaveLocal] ? conv : { ...conv, [chaveLocal]: [] },
    );
    setChatSel(chaveLocal);
    setChatNovoId("");
    setChatNovoNome("");
    // Sinalização automática: assina a presença e tenta conectar por ID
    sinalRef.current?.assinarPresenca(idPublico);
    tentarAutoConectar(idPublico);
    setChatAviso(
      "Contato adicionado. Se a IA estiver online, a conexão acontece sozinha — sem convite manual.",
    );
    window.setTimeout(() => setChatAviso(""), 6000);
  }, [chatNovoId, chatNovoNome, tentarAutoConectar]);

  const enviarChatRich = useCallback(
    (alvo: string | null, rico: PeerRich) => {
      const pm =
        (alvo && peerManagersRef.current.get(alvo)) || peerManagerRef.current;
      const destino = alvo ?? peerRemoto ?? null;
      if (!pm?.conectado) {
        setChatAviso("Conecte com a IA primeiro (use o convite no chat).");
        window.setTimeout(() => setChatAviso(""), 4000);
        return false;
      }
      const minhaFp = estadoIdentidade().fingerprint || getInstanceId();
      void pm.enviarRich(rico).then((ok) => {
        if (ok) {
          const item: ChatMensagem = {
            id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
            de: minhaFp,
            rico,
            ts: Date.now(),
            minha: true,
          };
          if (destino) {
            setConversas((conv) => ({
              ...conv,
              [destino]: [...(conv[destino] ?? []), item],
            }));
          }
          setPeerChat((c) => [...c, item]);
        } else {
          setChatAviso("Não foi possível enviar (canal fechado).");
          window.setTimeout(() => setChatAviso(""), 4000);
        }
      });
      return true;
    },
    [peerRemoto],
  );

  const enviarChatTexto = useCallback(() => {
    const t = chatMsg.trim();
    if (!t) return;
    if (enviarChatRich(chatSel, { kind: "texto", texto: t })) setChatMsg("");
  }, [chatMsg, chatSel, enviarChatRich]);

  const enviarChatUrl = useCallback(
    (kind: "imagem" | "video", url: string) => {
      const u = url.trim();
      if (!u) return;
      enviarChatRich(chatSel, {
        kind,
        url: u,
        nome: u.split("/").pop()?.slice(0, 60) || u.slice(0, 60),
      });
    },
    [chatSel, enviarChatRich],
  );

  const enviarChatSticker = useCallback(
    (key: string) => {
      enviarChatRich(chatSel, { kind: "sticker", url: key, texto: key });
      setChatStickers(false);
    },
    [chatSel, enviarChatRich],
  );

  const enviarChatEmoji = useCallback(
    (emoji: string) => {
      enviarChatRich(chatSel, { kind: "emoji", texto: emoji });
    },
    [chatSel, enviarChatRich],
  );

  // Gravação de áudio (MediaRecorder → webm/opus → base64 → P2P)
  const gravarAudioChat = useCallback(async () => {
    if (chatGravandoRef.current) {
      // Para a gravação
      chatGravandoRef.current = false;
      setChatGravando(false);
      const rec = chatRecRef.current;
      if (rec && rec.state !== "inactive") rec.stop();
      return;
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const rec = new MediaRecorder(stream, {
        mimeType: MediaRecorder.isTypeSupported("audio/webm;codecs=opus")
          ? "audio/webm;codecs=opus"
          : "audio/webm",
      });
      chatChunksRef.current = [];
      rec.ondataavailable = (e) => {
        if (e.data.size > 0) chatChunksRef.current.push(e.data);
      };
      rec.onstop = () => {
        stream.getTracks().forEach((t) => t.stop());
        const blob = new Blob(chatChunksRef.current, { type: rec.mimeType || "audio/webm" });
        if (blob.size > 0) {
          const reader = new FileReader();
          reader.onload = () => {
            const b64 = String(reader.result).split(",")[1] ?? "";
            const duracao = Math.round(blob.size / 16000);
            enviarChatRich(chatSel, {
              kind: "audio",
              url: `data:${rec.mimeType};base64,${b64}`,
              mime: rec.mimeType,
              duracao,
              nome: "áudio.webm",
            });
          };
          reader.readAsDataURL(blob);
        }
      };
      rec.start();
      chatRecRef.current = rec;
      chatGravandoRef.current = true;
      setChatGravando(true);
    } catch {
      setChatAviso("Não consegui acessar o microfone.");
      window.setTimeout(() => setChatAviso(""), 4000);
    }
  }, [chatSel, enviarChatRich]);

  // Envia arquivo (imagem/vídeo/áudio) selecionado no input file
  const enviarChatArquivo = useCallback(
    (file: File | null) => {
      if (!file) return;
      const kind: "imagem" | "video" | "audio" | "texto" =
        file.type.startsWith("image/") ? "imagem" : file.type.startsWith("video/") ? "video" : file.type.startsWith("audio/") ? "audio" : "texto";
      if (kind === "texto") return;
      const reader = new FileReader();
      reader.onload = () => {
        enviarChatRich(chatSel, {
          kind,
          url: String(reader.result),
          mime: file.type,
          nome: file.name.slice(0, 80),
          duracao: kind === "audio" ? Math.round(file.size / 16000) : undefined,
        });
      };
      reader.readAsDataURL(file);
    },
    [chatSel, enviarChatRich],
  );

  // Fecha o preview da câmera do chat (libera o stream)
  const fecharCamChat = useCallback(() => {
    chatCamStreamRef.current?.getTracks().forEach((t) => t.stop());
    chatCamStreamRef.current = null;
    setChatCamAberta(false);
  }, []);

  // Abre o preview da câmera dentro do chat (rosto/ambiente para enviar foto)
  const abrirCamChat = useCallback(async () => {
    if (chatCamAberta) {
      fecharCamChat();
      return;
    }
    try {
      const stream = await Promise.race([
        navigator.mediaDevices.getUserMedia({
          video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        }),
        new Promise<never>((_, rej) =>
          setTimeout(() => rej(new Error("câmera indisponível (permissão negada ou sem câmera)")), 8000),
        ),
      ]);
      chatCamStreamRef.current = stream;
      setChatCamAberta(true);
      // Liga o video no próximo tick (o elemento só existe depois do state)
      window.setTimeout(() => {
        const v = chatCamVideoRef.current;
        if (v) {
          v.srcObject = stream;
          void v.play().catch(() => {});
        }
      }, 50);
    } catch {
      chatCamStreamRef.current?.getTracks().forEach((t) => t.stop());
      chatCamStreamRef.current = null;
      setChatAviso("Não consegui acessar a câmera (permissão negada ou sem câmera).");
      window.setTimeout(() => setChatAviso(""), 5000);
    }
  }, [chatCamAberta, fecharCamChat]);

  // Captura o frame atual da câmera e envia como imagem P2P
  const capturarFotoChat = useCallback(() => {
    const v = chatCamVideoRef.current;
    if (!v || !v.videoWidth) {
      setChatAviso("Câmera ainda não pronta — aguarde um instante.");
      window.setTimeout(() => setChatAviso(""), 4000);
      return;
    }
    const canvas = document.createElement("canvas");
    canvas.width = v.videoWidth;
    canvas.height = v.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(v, 0, 0, canvas.width, canvas.height);
    const url = canvas.toDataURL("image/jpeg", 0.85);
    const enviado = enviarChatRich(chatSel, {
      kind: "imagem",
      url,
      mime: "image/jpeg",
      nome: `foto-camera-${new Date().toISOString().slice(11, 19).replace(/:/g, "-")}.jpg`,
    });
    if (enviado) fecharCamChat();
  }, [chatSel, enviarChatRich, fecharCamChat]);

  // Libera a câmera se a janela do chat for fechada com o preview aberto
