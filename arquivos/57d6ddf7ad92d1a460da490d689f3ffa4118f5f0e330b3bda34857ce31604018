/**
 * Devolve o texto com os termos em inglês embrulhados em <lang xml:lang="en-US">.
 * Se `clean` for true, remove os marcadores e devolve o texto puro.
 */
export function wrapEnglishTerms(text: string, clean = false): string {
  if (!text) return text;
  let out = text;
  for (const t of TERMOS) {
    // Lookbehind evita re-embrulhar o que já está embrulhado
    out = out.replace(
      new RegExp(`(?<!<lang xml:lang="en-US">)(${t.re.source})`, "gi"),
      (m) => (clean ? m : `<lang xml:lang="en-US">${m}</lang>`),
    );
  }
  return out;
}

/** Limpa marcadores SSML (para motores sem suporte: Piper/Razo). */
export function stripLangTags(text: string): string {
  return text.replace(/<\/?lang[^>]*>/gi, "");
}

/** Verifica se o texto contém algum termo em inglês (para decidir o motor). */
export function hasEnglishTerms(text: string): boolean {
  return TERMOS.some((t) => t.re.test(text));
}
