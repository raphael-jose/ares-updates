/**
 * Pronúncia bilíngue: detecta palavras/termos em inglês no meio de texto em
 * português e os marca para o TTS falar no idioma original.
 *
 * Ex.: "vou fazer um pull request" → o "pull request" deve soar em inglês.
 *
 * O edge-tts suporta SSML com <lang xml:lang="en-US">…</lang>, então a função
 * devolve o texto pronto para SSML. Para motores que não suportam SSML
 * (Piper/Razo local), os marcadores são limpos antes de sintetizar.
 *
 * IMPORTANTE: só entram termos que quase nunca são falsos positivos em pt-BR.
 * As regexes NÃO usam a flag /g: test() com /g avança lastIndex e a segunda
 * chamada devolveria falso negativo (bug intermitente).
 */

type Termo = { re: RegExp };

// Termos técnicos/jargão que o brasileiro fala em inglês.
const TERMOS: Termo[] = [
  { re: /pull request(?:s)?/i },
  { re: /code review(?:s)?/i },
