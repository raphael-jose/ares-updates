    create_folder: "criar pasta",
    create_project: "criar projeto",
    read_file: "ler arquivo",
    edit_file: "editar arquivo",
    list_folder: "listar pasta",
    open_folder: "abrir pasta",
    web_search: "pesquisar na internet",
    fetch_url: "ler página",
    open_url: "abrir site",
