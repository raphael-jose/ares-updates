/**
 * Registro de Ações: tabela persistente das falhas de ferramentas.
 *
 * Quando o ARES não consegue executar uma tarefa (tool ok:false), a falha é
 * registrada aqui como uma linha da tabela: hora, tipo de ação, ferramenta e o
 * erro real. A fala NÃO repete o erro técnico — fala apenas "no momento não
 * posso realizar essa tarefa" (ver executor.ts) e o detalhe fica nesta tabela,
 * exibida na janela REGISTRO DE AÇÕES do HUD ("exibir log de erros").
 */
import fs from "fs";
import fsp from "fs/promises";
import os from "os";
import path from "path";
import type { ToolName } from "./types";

export interface ErroRegistro {
  id: number;
  /** HH:MM:SS */
  hora: string;
  /** ISO completo (para ordenar/agrupar por dia). */
  iso: string;
  /** Tipo da ação pedida (ex.: "apagar arquivo", "enviar whatsapp"). */
  acao: string;
  /** Nome da ferramenta que falhou. */
  tool: ToolName;
  /** Mensagem de erro real (técnica). */
  erro: string;
  /** Erro recebido de outra instalação via MQTT (telemetria do dev). */
  remoto?: boolean;
  /** Identificador da instalação que originou o erro remoto. */
  de?: string;
}

const ERROS_DIR = path.join(os.homedir(), ".ares");
const ERROS_FILE = path.join(ERROS_DIR, "erros.json");
const MAX_ERROS = 300;

let cache: ErroRegistro[] | null = null;
let writeQueue: Promise<void> = Promise.resolve();
let seq = 0; // contador monotônico: id único mesmo com falhas no mesmo ms

function nowIso(): string {
  return new Date().toISOString();
}

function horaDe(iso: string): string {
  return new Date(iso).toLocaleTimeString("pt-BR", { hour12: false });
}

function ensureLoaded(): ErroRegistro[] {
  if (cache) return cache;
  try {
    if (fs.existsSync(ERROS_FILE)) {
      const raw = JSON.parse(fs.readFileSync(ERROS_FILE, "utf8")) as unknown;
      cache = Array.isArray(raw)
        ? (raw as ErroRegistro[]).filter((e) => e && typeof e.tool === "string").slice(0, MAX_ERROS)
        : [];
    } else {
      cache = [];
    }
  } catch {
    cache = [];
  }
  return cache;
}

function scheduleSave(): void {
  const data = cache ?? [];
  writeQueue = writeQueue.then(async () => {
    try {
      await fsp.mkdir(ERROS_DIR, { recursive: true });
      await fsp.writeFile(ERROS_FILE, JSON.stringify(data, null, 2), "utf8");
    } catch {
      /* tabela é best-effort: nunca derruba o fluxo */
    }
  });
}

/** Rótulo amigável do tipo de ação para a tabela. */
