function inserir(entry: ErroRegistro): void {
  const data = ensureLoaded();
  data.unshift(entry);
  if (data.length > MAX_ERROS) data.length = MAX_ERROS;
  scheduleSave();
}

/**
 * Registra uma falha de ferramenta na tabela. Recebe o erro real e o tipo de
 * ação. Não lança — o registro nunca quebra o fluxo principal.
 * Também envia uma cópia enxuta ao broker (telemetria: o dev recebe na área
 * de erros dele via MQTT).
 */
export function registrarFalha(tool: ToolName, erro: string, acao?: string): void {
  const iso = nowIso();
  const entry: ErroRegistro = {
    id: Date.now() * 100 + (seq++ % 100),
    hora: horaDe(iso),
    iso,
    acao: acao ?? acaoLabel(tool),
    tool,
    erro: String(erro ?? "").slice(0, 400) || "erro desconhecido",
  };
  inserir(entry);
  try {
    // Telemetria: publicação é assíncrona/best-effort — nunca quebra o fluxo.
    void import("./errosMqtt").then((m) => m.publicarFalha(entry));
  } catch {
    /* best-effort */
  }
}

/** Injeta um erro remoto (de outra instalação) na tabela local. */
export function registrarErroRemoto(e: {
  remoto: true;
  de: string;
  id: number;
  hora: string;
  iso: string;
  acao: string;
  tool: string;
  erro: string;
}): void {
  inserir({
    ...e,
    tool: e.tool as ToolName,
  });
}

/** Liga a telemetria: erros remotos chegam aqui e entram na tabela. */
export function ativarTelemetriaErros(): void {
  try {
    void import("./errosMqtt").then((m) => {
      m.registrarReceptorErros(registrarErroRemoto);
      m.iniciarReceptorErros();
    });
  } catch {
    /* best-effort */
  }
}

/** Devolve a tabela de erros (mais recentes primeiro). */
export function listarErros(limite = 100): ErroRegistro[] {
  return ensureLoaded().slice(0, limite);
}

/** Limpa a tabela inteira. */
export function limparErros(): { ok: boolean; message: string } {
  cache = [];
  scheduleSave();
  return { ok: true, message: "Registro de ações limpo." };
}

/**
 * True quando a mensagem parece um erro TÉCNICO (exceção, caminho, código).
 * Caminhos usam \x5c (hex) em vez de \\ para não sofrerem duplo-escape.
 */
export function isTechnicalError(msg: string): boolean {
  const s = (msg ?? "").toLowerCase();
  if (!s) return true;
  const pathRe =
    /(?:[a-z]:\x5c[\w\x5c.\s-]+|[a-z]:\/[\w\/.\s-]+|\x5c\x5c[\w\x5c.\s-]+)/i;
  return (
    /\b(?:error|exception|timeout|timedout|etimedout|eacces|enoent|eexist|econnrefused|undefined|null|nan|typeerror|syntaxerror|referenceerror|rangeerror|aggregateerror|networkerror|rejected)\b/.test(
      s,
    ) ||
    pathRe.test(s) ||
    /(?:at\s+[\w.]+\x5c?\.|node_modules|\.tsx?:|\.jsx?:|stack\s+trace|is\s+not\s+a\s+function|of\s+undefined|is\s+not\s+defined)/i.test(s)
  );
}

/** Versão enxuta para testes: limpa o cache em memória sem tocar no disco. */
export function __resetErrosCache(): void {
  cache = null;
}
