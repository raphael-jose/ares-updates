// Busca de mídia no Wikimedia Commons (imagens e vídeos, sem chave) —
// usada pela ferramenta show_image ("mostra uma imagem de cachorros").

const UA =
  "Arthemis-Assistant/1.0 (assistente de voz desktop; contato: local)";

export interface WikiEntry {
  title: string;
  url: string;
  mime: string;
  width?: number;
  size?: number;
}

export async function wikimediaSearch(
  query: string,
  kind: "bitmap" | "video",
  limit = 6,
): Promise<WikiEntry[]> {
  const url =
    `https://commons.wikimedia.org/w/api.php?action=query` +
    `&generator=search&gsrsearch=${encodeURIComponent(`${query} filetype:${kind}`)}` +
    `&gsrnamespace=6&gsrlimit=${limit}&prop=imageinfo&iiprop=url|mime|size` +
    `&format=json&origin=*`;
  const res = await fetch(url, {
    headers: { "User-Agent": UA },
    signal: AbortSignal.timeout(20000),
  });
  if (!res.ok) throw new Error(`Wikimedia HTTP ${res.status}`);
  const data = (await res.json()) as {
    query?: { pages?: Record<string, { title?: string; imageinfo?: Array<{ url?: string; mime?: string; width?: number; size?: number }> }> };
  };
  const pages = data.query?.pages ?? {};
  return Object.values(pages)
    .map((p) => ({
      title: p.title ?? "",
      url: p.imageinfo?.[0]?.url ?? "",
      mime: p.imageinfo?.[0]?.mime ?? "",
      width: p.imageinfo?.[0]?.width,
      size: p.imageinfo?.[0]?.size,
    }))
    .filter((e) => e.url && e.mime);
}
