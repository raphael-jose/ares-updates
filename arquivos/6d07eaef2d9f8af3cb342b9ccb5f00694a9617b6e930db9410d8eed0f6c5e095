  gap: 6px;
  margin-left: auto;
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #ffb0a0;
  background: rgba(255, 90, 90, 0.12);
  border: 1px solid rgba(255, 100, 100, 0.35);
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
}

.memory-erros-btn:hover {
