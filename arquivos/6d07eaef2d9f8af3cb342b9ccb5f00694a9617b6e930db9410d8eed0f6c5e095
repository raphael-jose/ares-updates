}

@keyframes saude-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(255, 90, 90, 0.35);
  }
  50% {
    box-shadow: 0 0 10px 2px rgba(255, 90, 90, 0.25);
