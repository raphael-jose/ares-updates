}

/* ——— Player de áudio (música do YouTube — só o áudio) ——— */
.music-window {
  position: fixed;
  bottom: 150px;
  right: 40px;
  width: 340px;
  height: 430px;
  z-index: 240;
}

.music-window.win-max {
  width: 560px;
  height: 700px;
  inset: 60px auto auto 50%;
  transform: translateX(-50%);
}

.music-body {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 14px;
  overflow: hidden;
}

.music-body audio {
  /* Controles customizados no lugar do player nativo */
  display: none;
}

.music-now {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 10px;
  background: linear-gradient(135deg, rgba(var(--glow-rgb), 0.13), rgba(var(--glow-rgb), 0.04));
  border: 1px solid rgba(var(--glow-rgb), 0.28);
  border-radius: 10px;
  overflow: hidden;
}

.music-now-thumb {
  width: 100%;
  height: 210px;
  object-fit: cover;
  border-radius: 8px;
  flex-shrink: 0;
  background: rgba(var(--glow-rgb), 0.06);
}

.music-now-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  min-width: 0;
  max-width: 100%;
}

.music-now-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.music-now-artist {
  font-size: 11px;
  text-align: center;
  color: rgba(207, 221, 230, 0.6);
}

.music-now-empty {
  font-size: 12px;
  color: rgba(207, 221, 230, 0.5);
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Equalizador animado enquanto toca */
.music-eq {
  display: inline-flex;
  align-items: flex-end;
  gap: 2px;
  height: 16px;
  flex-shrink: 0;
}

.music-eq i {
  width: 3px;
  height: 100%;
  border-radius: 2px;
  background: var(--accent);
  animation: music-eq-bounce 0.9s ease-in-out infinite;
  transform-origin: bottom;
}

.music-eq i:nth-child(2) {
  animation-delay: 0.15s;
}

.music-eq i:nth-child(3) {
  animation-delay: 0.3s;
}

.music-eq i:nth-child(4) {
  animation-delay: 0.45s;
}

@keyframes music-eq-bounce {
  0%,
  100% {
    transform: scaleY(0.35);
  }
  50% {
    transform: scaleY(1);
  }
}

/* Barra de progresso customizada + tempos */
.music-progress {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.music-progress input[type="range"] {
  width: 100%;
  height: 4px;
  accent-color: var(--accent);
  cursor: pointer;
}

.music-times {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  color: rgba(207, 221, 230, 0.55);
  letter-spacing: 0.4px;
