}

.whatsapp-qr-wait {
  font-size: 13px;
  color: var(--text-dim);
}

.whatsapp-qr-err {
  font-size: 12px;
  color: #ff9d9d;
}

.whatsapp-reload {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--accent);
  background: rgba(var(--accent-rgb), 0.1);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
