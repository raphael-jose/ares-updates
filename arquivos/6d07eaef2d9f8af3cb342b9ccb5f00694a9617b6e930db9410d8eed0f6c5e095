}

/* ——— Banner de novidades (changelog) após instalar uma atualização ——— */
.upd-banner {
  position: fixed;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2000;
  max-width: min(480px, calc(100vw - 32px));
  padding: 12px 38px 12px 16px;
  background: rgba(6, 14, 22, 0.96);
  border: 1px solid var(--accent);
  border-radius: 8px;
  box-shadow: 0 6px 28px rgba(0, 0, 0, 0.55), 0 0 18px rgba(var(--accent-rgb), 0.25);
  animation: upd-banner-in 0.35s ease;
}

@keyframes upd-banner-in {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.upd-banner-titulo {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 8px;
}

.upd-banner-notas {
  margin: 0;
  padding-left: 18px;
  font-size: 12px;
  line-height: 1.6;
  color: var(--text, #dcecf7);
}

.upd-banner-notas li {
  margin-bottom: 3px;
}

.upd-banner-fechar {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  color: var(--text-dim);
  background: transparent;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 13px;
}

.upd-banner-fechar:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
}


.erros-dev-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--bg, #0b0f14);
  background: var(--accent);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: filter 0.15s, transform 0.1s;
}

.erros-dev-btn:hover:not(:disabled) {
  filter: brightness(1.2);
  transform: translateY(-1px);
}

.erros-dev-btn:disabled {
  opacity: 0.6;
  cursor: wait;
}

.erros-dev-btn .spin {
  display: inline-block;
  animation: girar 1s linear infinite;
}

@keyframes girar {
