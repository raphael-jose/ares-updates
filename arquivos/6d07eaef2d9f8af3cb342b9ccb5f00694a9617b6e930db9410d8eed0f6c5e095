/* ——— Janela WHATSAPP (sessão real via whatsapp-web.js) ——— */
.whatsapp-panel.win-window {
  position: fixed;
  top: 90px;
  right: 420px;
  z-index: 27;
  width: 380px;
  max-width: calc(100vw - 48px);
  height: min(560px, calc(100vh - 120px));
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 4px;
  backdrop-filter: blur(3px);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45), 0 0 16px rgba(var(--glow-rgb), 0.14);
}

.whatsapp-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 12px;
