.fb-modal-resposta-feita .fb-modal-resposta-texto {
  margin: 6px 0 0;
  font-size: 12px;
  line-height: 1.6;
  color: var(--text, #eaf6fc);
  white-space: pre-wrap;
  word-break: break-word;
}

.erros-fb-apagar {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border: 1px solid rgba(255, 120, 120, 0.35);
  border-radius: 4px;
  background: rgba(255, 80, 80, 0.08);
  color: #ff9d9d;
  font-size: 11px;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}

.erros-fb-apagar:hover {
  background: rgba(255, 80, 80, 0.25);
  color: #ffd0d0;
}

.erros-fb-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
}

.erros-fb-de {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #56d9ff;
}

.erros-fb-hora {
  font-size: 10px;
  color: var(--text-dim, #9fb8cc);
  opacity: 0.8;
}

.erros-fb-texto {
  margin: 0;
  font-size: 11.5px;
  line-height: 1.55;
  color: var(--text, #eaf6fc);
  white-space: pre-wrap;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ——— Modal do feedback completo (dev clica no item) ——— */
.fb-modal {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}

.fb-modal-card {
  width: min(560px, calc(100vw - 48px));
  max-height: min(70vh, 560px);
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid, #101418);
  border: 1px solid rgba(86, 217, 255, 0.45);
  border-radius: 8px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6), 0 0 24px rgba(86, 217, 255, 0.18);
  overflow: hidden;
}

.fb-modal-titulo {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 16px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.25);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.2px;
  color: var(--text, #eaf6fc);
}

.fb-modal-titulo i {
  color: #56d9ff;
  font-size: 14px;
}

.fb-modal-fechar {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  border-radius: 4px;
  background: transparent;
  color: var(--text, #eaf6fc);
  font-size: 12px;
  cursor: pointer;
}

.fb-modal-fechar:hover {
  background: rgba(255, 80, 80, 0.15);
  color: #ffb0b0;
}

.fb-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 16px 0;
}

.fb-modal-texto {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  margin: 10px 16px;
  padding: 12px 14px;
  border: 1px solid rgba(var(--accent-rgb), 0.2);
  border-radius: 6px;
  background: rgba(0, 0, 0, 0.4);
  font-size: 12.5px;
  line-height: 1.65;
  color: var(--text, #eaf6fc);
  white-space: pre-wrap;
  word-break: break-word;
  scrollbar-width: thin;
}

.fb-modal-acoes {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding: 10px 16px 14px;
}

.fb-modal-apagar,
.fb-modal-btn {
  padding: 8px 14px;
  border-radius: 5px;
  font: inherit;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.8px;
  cursor: pointer;
}

.fb-modal-apagar {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid rgba(255, 100, 100, 0.5);
  background: rgba(255, 80, 80, 0.12);
  color: #ffb0b0;
}

.fb-modal-apagar:hover {
  background: rgba(255, 80, 80, 0.25);
}

.fb-modal-btn {
  border: 1px solid rgba(var(--accent-rgb), 0.45);
  background: rgba(var(--accent-rgb), 0.12);
  color: var(--text, #eaf6fc);
}

.fb-modal-btn:hover {
  background: rgba(var(--accent-rgb), 0.22);
}

.chip-evento {
  border-color: rgba(255, 200, 90, 0.65);
  color: #ffe2b0;
  box-shadow: 0 0 14px rgba(255, 170, 40, 0.3);
}

.chip-evento .chip-icon {
  color: #ffc65c;
  animation: hermes-pulse 1.2s ease-in-out infinite;
}

.chip-peer {
  border-color: rgba(90, 217, 255, 0.6);
  color: #c9efff;
  box-shadow: 0 0 14px rgba(90, 217, 255, 0.3);
}

.chip-peer .chip-icon {
  color: #56d9ff;
}

/* Medidor de FPS: chip discreto no canto inferior central */
.fps-pos {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 60;
  pointer-events: none;
}

.chip-fps {
  border-color: rgba(160, 220, 255, 0.4);
  color: #bfe3ff;
  box-shadow: 0 0 14px rgba(120, 200, 255, 0.18);
  opacity: 0.8;
  font-variant-numeric: tabular-nums;
}

.chip-fps .chip-icon {
  color: #8fc9ff;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.12em;
  color: var(--accent-bright);
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 999px;
  backdrop-filter: blur(3px);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.7);
  box-shadow: 0 0 14px rgba(var(--glow-rgb), 0.25);
  animation: chip-in 0.3s ease-out;
}

.chip-icon {
  font-size: 12px;
  line-height: 1;
}

.chip-timer {
  border-color: rgba(var(--accent-bright-rgb), 0.7);
  box-shadow: 0 0 14px rgba(var(--glow-rgb), 0.4);
}

.chip-bpm {
  border-color: rgba(255, 120, 80, 0.8);
  color: #ffd7c4;
  box-shadow: 0 0 14px rgba(255, 90, 40, 0.35);
}

.chip-bpm .chip-icon {
  color: #ff6a4a;
  animation: heart-beat 1s ease-in-out infinite;
}

.chip-hermes {
  border-color: rgba(140, 140, 255, 0.6);
  color: #d6d9ff;
  box-shadow: 0 0 14px rgba(110, 110, 255, 0.3);
}

.chip-hermes .chip-icon {
  color: #a6a8ff;
  animation: hermes-pulse 2s ease-in-out infinite;
}

@keyframes hermes-pulse {
  0%,
  100% {
    opacity: 1;
    text-shadow: 0 0 8px rgba(130, 130, 255, 0.9);
  }
  50% {
    opacity: 0.45;
    text-shadow: 0 0 2px rgba(130, 130, 255, 0.3);
  }
}

@keyframes chip-in {
  from {
    opacity: 0;
    transform: translateY(-8px) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes heart-beat {
  0%,
  100% {
    transform: scale(1);
  }
  25% {
    transform: scale(1.35);
  }
  40% {
    transform: scale(1);
  }
}

/* ——— Painel de memória editável ——— */
.memory-panel {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 300;
  width: min(720px, calc(100vw - 48px));
  max-height: min(560px, calc(100vh - 96px));
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 6px;
  backdrop-filter: blur(14px) saturate(1.15);
  box-shadow:
    0 0 30px rgba(var(--glow-rgb), 0.3),
    0 0 0 1px rgba(0, 0, 0, 0.6);
  overflow: hidden;
}

.memory-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.25em;
  color: var(--accent);
  text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.7);
  background: var(--header-bg);
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.3);
}

.memory-close {
  width: 26px;
  height: 26px;
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  background: var(--panel-bg-clear);
  color: var(--accent);
  font-size: 12px;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease;
}

.memory-close:hover {
  background: var(--panel-bg-hover);
  border-color: var(--accent-bright);
}

.memory-msg {
  padding: 6px 12px;
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--accent-bright);
  background: rgba(var(--accent-rgb), 0.08);
  border-bottom: 1px dashed rgba(var(--accent-rgb), 0.25);
}

.memory-grid {
  scrollbar-width: thin;
  scrollbar-color: rgba(var(--accent-rgb), 0.3) transparent;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 12px;
  display: grid;
  overflow-y: auto;
}

.memory-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.35);
  padding: 8px;
}

.memory-title {
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.2em;
  color: var(--accent);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.6);
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.25);
}

.memory-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 3px;
  max-height: 180px;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(var(--accent-rgb), 0.3) transparent;
}

.memory-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  line-height: 1.4;
  color: var(--accent-bright);
  text-shadow: 0 0 4px rgba(var(--accent-rgb), 0.3);
  animation: log-in 0.2s ease-out;
}

.memory-v {
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-all;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.memory-k {
  flex-shrink: 0;
  font-weight: bold;
  white-space: nowrap;
  word-break: break-all;
}

.memory-x {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  border: none;
  border-radius: 3px;
  background: transparent;
  color: rgba(var(--accent-rgb), 0.7);
  font-size: 10px;
  cursor: pointer;
  transition:
    color 0.15s ease,
    background 0.15s ease;
}

.memory-play {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 50%;
  background: rgba(var(--glow-rgb), 0.12);
  color: var(--accent);
  font-size: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition:
    background 0.15s ease,
    transform 0.15s ease;
}

.memory-play:hover {
  background: rgba(var(--glow-rgb), 0.25);
  transform: scale(1.1);
}

.memory-faixas {
  opacity: 0.6;
  font-size: 10px;
}

.memory-x:hover {
  color: #ff7a5e;
  background: rgba(255, 85, 51, 0.15);
}

.memory-empty {
  font-size: 10px;
  letter-spacing: 0.1em;
  color: rgba(var(--accent-rgb), 0.45);
  font-style: italic;
}

.memory-add {
  display: flex;
  gap: 4px;
  margin-top: 4px;
}

.memory-input {
  flex: 1;
  min-width: 0;
  padding: 4px 6px;
  background: rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  color: var(--accent-bright);
  font-size: 10px;
  font-family: inherit;
  letter-spacing: 0.04em;
}

.memory-input:focus {
  outline: none;
  border-color: var(--accent-bright);
  box-shadow: 0 0 6px rgba(var(--accent-rgb), 0.4);
}

.memory-input::placeholder {
  color: rgba(var(--accent-rgb), 0.5);
}

.memory-add-btn {
  flex-shrink: 0;
  width: 28px;
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  background: rgba(var(--accent-rgb), 0.15);
  color: var(--accent-bright);
  font-size: 13px;
  font-weight: bold;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease;
}

.memory-add-btn:hover {
  background: rgba(var(--accent-rgb), 0.35);
  border-color: var(--accent-bright);
}

/* ——— Agenda em formato calendário (painel MEMÓRIA) ——— */
.memory-section-cal {
  grid-column: 1 / -1;
}

.agenda-cal {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.agenda-cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.agenda-cal-titulo {
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.15em;
  text-transform: capitalize;
  color: var(--accent-bright);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.5);
}

.agenda-cal-nav {
  width: 24px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  background: rgba(var(--accent-rgb), 0.08);
  color: var(--accent);
  font-size: 12px;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    transform 0.15s ease;
}

.agenda-cal-nav:hover {
  background: rgba(var(--accent-rgb), 0.25);
  border-color: var(--accent-bright);
  transform: translateY(-1px);
}

.agenda-cal-dows {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2px;
}

.agenda-cal-dow {
  text-align: center;
  font-size: 9px;
  letter-spacing: 0.1em;
  color: rgba(var(--accent-rgb), 0.6);
  padding: 2px 0;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
}

.agenda-cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2px;
}

.agenda-cal-cell {
  position: relative;
  min-height: 34px;
  border: 1px solid rgba(var(--accent-rgb), 0.15);
  border-radius: 3px;
  background: rgba(0, 0, 0, 0.3);
  color: var(--accent-bright);
  font-size: 10px;
  font-family: inherit;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    transform 0.15s ease;
}

.agenda-cal-cell:hover {
  background: rgba(var(--accent-rgb), 0.2);
  border-color: rgba(var(--accent-rgb), 0.6);
  transform: translateY(-1px);
}

.agenda-cal-cell.fora {
  opacity: 0.35;
}

.agenda-cal-cell.hoje {
  border-color: var(--accent-bright);
  box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.5);
}

.agenda-cal-cell.sel {
  background: rgba(var(--accent-rgb), 0.35);
  border-color: var(--accent-bright);
}

.agenda-cal-dot {
  position: absolute;
  bottom: 3px;
  left: 50%;
  transform: translateX(-50%);
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--accent-bright);
  box-shadow: 0 0 6px rgba(var(--accent-rgb), 0.9);
}

.agenda-cal-hoje-row {
  display: flex;
  justify-content: flex-end;
}

.agenda-cal-hoje {
  font-size: 9px;
  letter-spacing: 0.15em;
  color: var(--accent);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  background: rgba(var(--accent-rgb), 0.1);
  padding: 2px 8px;
  cursor: pointer;
  transition: background 0.15s ease;
}

.agenda-cal-hoje:hover {
  background: rgba(var(--accent-rgb), 0.3);
}

.agenda-cal-dia {
  max-height: 130px;
  margin-top: 2px;
}

/* ——— Painel de preferências de voz (rate/pitch/voz) ——— */
.tts-panel {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 300;
  width: min(360px, calc(100vw - 48px));
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 6px;
  backdrop-filter: blur(14px) saturate(1.15);
  box-shadow:
    0 0 30px rgba(var(--glow-rgb), 0.3),
    0 0 0 1px rgba(0, 0, 0, 0.6);
}

.tts-panel .memory-header {
  padding: 0 0 8px;
  background: transparent;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.3);
}

.tts-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tts-label {
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.15em;
  color: var(--accent);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.6);
}

.tts-slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 4px;
  border-radius: 2px;
  background: rgba(var(--accent-rgb), 0.3);
  outline: none;
}

.tts-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--accent-bright);
  border: 1px solid var(--accent);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.7);
  cursor: pointer;
}

.tts-slider::-moz-range-thumb {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--accent-bright);
  border: 1px solid var(--accent);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.7);
  cursor: pointer;
}

.tts-voice-btns {
  display: flex;
  gap: 6px;
}

.tts-voice-btn {
  flex: 1;
  padding: 7px 8px;
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  background: var(--panel-bg-clear);
  color: var(--accent);
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.12em;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.tts-voice-btn:hover {
  background: var(--panel-bg-hover);
  border-color: var(--accent-bright);
}

.tts-voice-btn.active {
  background: var(--panel-bg-pressed);
  border-color: var(--accent-bright);
  color: var(--accent-bright);
  box-shadow: 0 0 10px rgba(var(--glow-rgb), 0.3);
}

@media (max-width: 600px) {
  .memory-grid {
    grid-template-columns: 1fr;
  }

  .chip-row {
    top: 64px;
  }
}

/* ——— Painel editor de código (modo editor) ——— */
.editor-panel {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 300;
  width: min(960px, calc(100vw - 48px));
  height: min(580px, calc(100vh - 80px));
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 6px;
  backdrop-filter: blur(14px) saturate(1.15);
  box-shadow:
    0 0 30px rgba(var(--glow-rgb), 0.3),
    0 0 0 1px rgba(0, 0, 0, 0.6);
  overflow: hidden;
  animation: log-in 0.2s ease-out;
}

.editor-msg {
  border-bottom: 1px dashed rgba(var(--accent-rgb), 0.25);
}

.editor-body {
  display: flex;
  flex: 1;
  min-height: 0;
}

/* ——— Árvore de arquivos ——— */
.editor-tree {
  width: 240px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  border-right: 1px solid rgba(var(--accent-rgb), 0.25);
  background: rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.editor-tree-title {
  padding: 7px 10px;
  font-size: 9px;
  font-weight: bold;
  letter-spacing: 0.25em;
  color: var(--accent);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.6);
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
  background: var(--header-bg);
}

.editor-tree-list {
  list-style: none;
  padding: 4px 0;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(var(--accent-rgb), 0.3) transparent;
}

.editor-node {
  width: 100%;
}

.editor-node-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  width: 100%;
  padding: 3px 8px;
  background: transparent;
  border: none;
  color: var(--accent-bright);
  font-size: 11px;
  font-family: "Courier New", monospace;
  text-align: left;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition:
    background 0.12s ease,
    color 0.12s ease;
}

.editor-node-btn:hover {
  background: var(--panel-bg-hover);
  color: var(--accent-bright);
  box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.3);
}

.editor-node-btn:focus-visible {
  outline: 1px solid var(--accent-bright);
  outline-offset: -1px;
}

.editor-arrow {
  flex-shrink: 0;
  width: 12px;
  text-align: center;
  color: rgba(var(--accent-rgb), 0.6);
  transition: transform 0.15s ease;
}

.editor-arrow.open {
  color: var(--accent);
}

.editor-icon {
  flex-shrink: 0;
  font-size: 12px;
}

.editor-name {
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ——— Área de código ——— */
.editor-code {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: rgba(0, 0, 0, 0.45);
}

.editor-empty {
  padding: 12px;
  font-size: 10px;
  letter-spacing: 0.1em;
  color: rgba(var(--accent-rgb), 0.45);
  font-style: italic;
  line-height: 1.6;
}

.editor-empty-code {
  align-self: center;
  margin: auto;
  max-width: 340px;
  text-align: center;
}

.editor-filebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 5px 10px;
  font-size: 10px;
  letter-spacing: 0.06em;
  color: var(--accent);
  background: var(--header-bg);
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
}

.editor-filebar-path {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-lang {
  flex-shrink: 0;
  font-size: 9px;
  letter-spacing: 0.12em;
  padding: 2px 6px;
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 999px;
  color: var(--accent-bright);
  background: rgba(var(--accent-rgb), 0.1);
}

.editor-pre {
  flex: 1;
  margin: 0;
  padding: 8px 0;
  overflow: auto;
  font-family: "Courier New", monospace;
  font-size: 11px;
  line-height: 1.5;
  scrollbar-width: thin;
  scrollbar-color: rgba(var(--accent-rgb), 0.3) transparent;
}

.editor-line {
  display: flex;
  min-height: 1.5em;
}

.editor-lineno {
  flex-shrink: 0;
  width: 44px;
  padding-right: 10px;
  text-align: right;
  color: rgba(var(--accent-rgb), 0.4);
  user-select: none;
}

.editor-line-text {
  flex: 1;
  min-width: 0;
  white-space: pre;
  color: var(--accent-bright);
  text-shadow: 0 0 4px rgba(var(--accent-rgb), 0.2);
}

.editor-line:hover {
  background: rgba(var(--accent-rgb), 0.06);
}

.editor-textarea {
  flex: 1;
  width: 100%;
  padding: 8px 12px;
  resize: none;
  border: none;
  outline: none;
  background: transparent;
  color: var(--accent-bright);
  font-family: "Courier New", monospace;
  font-size: 11px;
  line-height: 1.5;
  white-space: pre;
  overflow: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(var(--accent-rgb), 0.3) transparent;
}

.editor-textarea:focus {
  box-shadow: inset 0 0 0 1px rgba(var(--accent-bright-rgb), 0.5);
}

/* ——— Diff ——— */
.editor-diff {
  border-top: 1px solid rgba(var(--accent-rgb), 0.3);
  background: rgba(0, 0, 0, 0.55);
}

.editor-diff-title {
  padding: 5px 10px;
  font-size: 9px;
  font-weight: bold;
  letter-spacing: 0.2em;
  color: var(--accent);
  background: var(--header-bg);
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
}

.editor-diff-list {
  max-height: 150px;
  overflow-y: auto;
  padding: 4px 0;
  font-family: "Courier New", monospace;
  font-size: 10px;
  line-height: 1.5;
  scrollbar-width: thin;
  scrollbar-color: rgba(var(--accent-rgb), 0.3) transparent;
}

.editor-diff-line {
  display: flex;
  gap: 6px;
  padding: 0 10px;
  white-space: pre;
}

.editor-diff-line code {
  flex: 1;
  min-width: 0;
  font-family: inherit;
}

.editor-diff-num {
  flex-shrink: 0;
  width: 14px;
  text-align: center;
  font-weight: bold;
}

.diff-rem {
  background: rgba(255, 85, 51, 0.16);
  color: #ffb3a3;
}

.diff-rem .editor-diff-num {
  color: #ff7a5e;
}

.diff-add {
  background: rgba(120, 255, 90, 0.13);
  color: #c9ffb8;
}

.diff-add .editor-diff-num {
  color: #9dff7a;
}

.diff-ctx {
  color: rgba(var(--accent-rgb), 0.55);
}

/* ——— Ações ——— */
.editor-actions {
  display: flex;
  gap: 8px;
  padding: 8px 10px;
  border-top: 1px solid rgba(var(--accent-rgb), 0.25);
  background: var(--header-bg);
}

.editor-btn {
  min-height: 30px;
  height: 30px;
  padding: 0 14px;
  font-size: 11px;
}

.editor-btn-save {
  background: rgba(var(--accent-rgb), 0.25);
  border-color: var(--accent-bright);
  color: var(--accent-bright);
}

.editor-btn-save:hover {
  background: rgba(var(--accent-rgb), 0.45);
}

/* ——— Abas de arquivos abertos (estilo VS Code) ——— */
.editor-tabs {
  display: flex;
  align-items: stretch;
  gap: 2px;
  padding: 4px 6px 0;
  background: rgba(0, 0, 0, 0.25);
  border-bottom: 1px solid rgba(var(--glow-rgb), 0.15);
  overflow-x: auto;
  scrollbar-width: thin;
}

.editor-tab {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 6px 5px 10px;
  border-radius: 6px 6px 0 0;
  border: 1px solid transparent;
  border-bottom: none;
  background: transparent;
  color: rgba(207, 221, 230, 0.65);
  font-size: 11px;
  cursor: pointer;
  white-space: nowrap;
  max-width: 200px;
  transition: background 0.15s, color 0.15s;
}

.editor-tab:hover {
  background: rgba(var(--glow-rgb), 0.07);
  color: #e3edf2;
}

.editor-tab.active {
  background: rgba(var(--glow-rgb), 0.14);
  border-color: rgba(var(--glow-rgb), 0.3);
  color: var(--accent);
}

.editor-tab-icon {
  display: inline-flex;
  color: rgba(207, 221, 230, 0.7);
  flex-shrink: 0;
}

.editor-tab-name {
  overflow: hidden;
  text-overflow: ellipsis;
}

.editor-tab-dirty {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

.editor-tab-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  border-radius: 4px;
  color: rgba(207, 221, 230, 0.5);
  cursor: pointer;
  flex-shrink: 0;
  transition: background 0.15s, color 0.15s;
}

.editor-tab-close:hover {
  background: rgba(255, 80, 80, 0.2);
  color: #ff9d9d;
}

/* ——— Toolbar do editor (PREVIEW / BUSCAR / CLI) ——— */
.editor-toolbar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px 4px;
}

.editor-tool-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  font-size: 10px;
  letter-spacing: 0.6px;
  border-radius: 5px;
  border: 1px solid rgba(var(--glow-rgb), 0.3);
  background: rgba(var(--glow-rgb), 0.08);
  color: rgba(207, 221, 230, 0.75);
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}

.editor-tool-btn:hover {
  background: rgba(var(--glow-rgb), 0.16);
  transform: translateY(-1px);
}

.editor-tool-btn.on {
  background: rgba(var(--glow-rgb), 0.22);
  border-color: var(--accent);
  color: var(--accent);
}

/* ——— Busca no arquivo (Ctrl+F) ——— */
.editor-find {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-bottom: 1px solid rgba(var(--glow-rgb), 0.15);
  color: rgba(207, 221, 230, 0.6);
}

.editor-find-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(var(--glow-rgb), 0.25);
  border-radius: 5px;
  padding: 4px 8px;
  color: #e3edf2;
  font-size: 12px;
}

.editor-find-input:focus {
  outline: none;
  border-color: var(--accent);
}

.editor-find-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 5px;
  border: 1px solid rgba(var(--glow-rgb), 0.25);
  background: rgba(var(--glow-rgb), 0.07);
  color: rgba(207, 221, 230, 0.7);
  cursor: pointer;
  transition: background 0.15s;
}

.editor-find-btn:hover {
  background: rgba(var(--glow-rgb), 0.18);
}

.editor-find-count {
  font-size: 10px;
  color: rgba(207, 221, 230, 0.55);
  min-width: 40px;
  text-align: center;
}

.editor-find-hit {
  background: rgba(255, 196, 0, 0.35);
  color: #ffe9a8;
  border-radius: 2px;
  padding: 0 1px;
}

/* ——— Modo preview (split editor + iframe) ——— */
.editor-preview-split {
  display: flex;
  flex: 1;
  min-height: 0;
  gap: 2px;
}

.editor-preview-editor {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.editor-preview-pane {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  border-left: 1px solid rgba(var(--glow-rgb), 0.2);
  min-height: 0;
}

.editor-preview-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  font-size: 10px;
  letter-spacing: 0.6px;
  color: var(--accent);
  background: rgba(var(--glow-rgb), 0.08);
  border-bottom: 1px solid rgba(var(--glow-rgb), 0.2);
}

.editor-preview-frame {
  flex: 1;
  width: 100%;
  border: none;
  background: #0d1117;
}

/* ——— Status bar do editor ——— */
.editor-statusbar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 4px 10px;
  font-size: 10px;
  letter-spacing: 0.4px;
  color: rgba(207, 221, 230, 0.6);
  background: rgba(0, 0, 0, 0.35);
  border-top: 1px solid rgba(var(--glow-rgb), 0.15);
}

.editor-statusbar span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.editor-statusbar-right {
  margin-left: auto;
  color: rgba(207, 221, 230, 0.45);
}

/* ——— CLI do ARES embutida no editor ——— */
.editor-cli {
  border-top: 1px solid rgba(var(--glow-rgb), 0.25);
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  max-height: 200px;
}

.editor-cli-bar {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 4px 10px;
  font-size: 10px;
  letter-spacing: 0.6px;
  color: var(--accent);
  background: rgba(var(--glow-rgb), 0.1);
  border-bottom: 1px solid rgba(var(--glow-rgb), 0.2);
}

.editor-cli-out {
  flex: 1;
  overflow-y: auto;
  padding: 6px 10px;
  font-family: Consolas, "Cascadia Mono", monospace;
  font-size: 11px;
  line-height: 1.5;
}

.editor-cli-hint {
  color: rgba(207, 221, 230, 0.4);
  font-style: italic;
}

.editor-cli-line {
  white-space: pre-wrap;
  word-break: break-word;
}

.editor-cli-line.cli-cmd {
  color: var(--accent);
  font-weight: 700;
}

.editor-cli-line.cli-out {
  color: #c9d6de;
}

.editor-cli-line.cli-err {
  color: #ff9d9d;
}

.editor-cli-prompt-inline {
  color: var(--accent);
  font-weight: 700;
}

.editor-cli-form {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border-top: 1px solid rgba(var(--glow-rgb), 0.15);
}

.editor-cli-prompt {
  color: var(--accent);
  font-family: Consolas, monospace;
  font-size: 12px;
  font-weight: 700;
}

.editor-cli-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(var(--glow-rgb), 0.25);
  border-radius: 5px;
  padding: 5px 9px;
  color: #e3edf2;
  font-family: Consolas, monospace;
  font-size: 12px;
}

.editor-cli-input:focus {
  outline: none;
  border-color: var(--accent);
}

.editor-cli-btn {
  padding: 5px 12px;
  font-size: 10px;
  letter-spacing: 0.6px;
  border-radius: 5px;
  border: 1px solid rgba(var(--glow-rgb), 0.3);
  background: rgba(var(--glow-rgb), 0.14);
  color: var(--accent);
  cursor: pointer;
  transition: background 0.15s;
}

.editor-cli-btn:hover:not(:disabled) {
  background: rgba(var(--glow-rgb), 0.24);
}

.editor-cli-btn:disabled {
  opacity: 0.5;
  cursor: default;
}

@media (max-width: 720px) {
  .editor-panel {
    width: calc(100vw - 24px);
    height: calc(100vh - 48px);
  }

  .editor-tree {
    width: 170px;
  }
}

/* ——— Handles de janela (modo interface, mouse) ——— */
.win-handle {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 18px;
  display: flex;
  align-items: center;
  padding: 0 6px;
  font-size: 9px;
  letter-spacing: 0.2em;
  color: var(--accent-bright);
  background: rgba(0, 0, 0, 0.45);
  border-bottom: 1px solid rgba(var(--accent-bright-rgb), 0.35);
  cursor: move;
  z-index: 30;
  user-select: none;
  pointer-events: auto;
  text-shadow: 0 0 6px rgba(var(--glow-rgb), 0.6);
}

.win-resize {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 16px;
  height: 16px;
  cursor: nwse-resize;
  z-index: 30;
  pointer-events: auto;
  background: linear-gradient(135deg, transparent 0 45%, rgba(var(--accent-bright-rgb), 0.8) 45% 55%, transparent 55%);
}

.win-handle:hover,
.win-resize:hover {
  filter: brightness(1.3);
}

/* ——— Editor: breadcrumb de navegação ——— */
.editor-crumbs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1px;
  padding: 4px 8px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.15);
  background: rgba(0, 0, 0, 0.25);
}

.editor-crumb {
  display: inline-flex;
  align-items: center;
  max-width: 130px;
}

.editor-crumb-btn {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  color: var(--accent-bright);
  font-family: "Courier New", monospace;
  font-size: 9px;
  padding: 1px 4px;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: background 0.12s ease, color 0.12s ease;
}

.editor-crumb-btn:hover {
  background: var(--panel-bg-hover);
  color: var(--accent-bright);
  box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.3);
}

.editor-crumb-sep {
  font-size: 7px;
  color: rgba(var(--accent-rgb), 0.4);
  margin: 0 2px;
}

/* ——— Editor: filtro de arquivos da árvore ——— */
.editor-filter-row {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.15);
}

.editor-filter-icon {
  font-size: 10px;
  color: rgba(var(--accent-rgb), 0.6);
  flex-shrink: 0;
}

.editor-filter-input {
  flex: 1;
  min-width: 0;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 3px;
  color: var(--accent-bright);
  font-family: "Courier New", monospace;
  font-size: 10px;
  padding: 3px 6px;
  outline: none;
}

.editor-filter-input:focus {
  border-color: var(--accent-bright);
  box-shadow: 0 0 6px rgba(var(--glow-rgb), 0.25);
}

.editor-filter-clear {
  background: transparent;
  border: 1px solid transparent;
  color: var(--accent);
  border-radius: 3px;
  width: 18px;
  height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  cursor: pointer;
  padding: 0;
}

.editor-filter-clear:hover {
  background: var(--panel-bg-hover);
  border-color: rgba(var(--accent-rgb), 0.4);
}

/* ——— Editor: expandir/recolher tudo ——— */
.editor-tree-tools {
  display: flex;
  gap: 4px;
  padding: 4px 8px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.15);
}

.editor-path-input:focus {
  border-color: var(--accent-bright);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.editor-path-btn {
  background: rgba(var(--accent-rgb), 0.2);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.12em;
  padding: 0 8px;
  cursor: pointer;
  transition: background 0.15s ease, box-shadow 0.15s ease;
}

.editor-path-btn:hover {
  background: rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

/* ——— Explorer de arquivos ——— */
.explorer-panel {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 25;
  width: 420px;
  max-width: calc(100vw - 48px);
  height: min(520px, calc(100vh - 48px));
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 4px;
  backdrop-filter: blur(3px);
  box-shadow: 0 0 16px rgba(var(--glow-rgb), 0.14);
  overflow: hidden;
  animation: log-in 0.25s ease-out;
}

.explorer-tools {
  display: flex;
  gap: 4px;
  padding: 6px 8px;
}

.explorer-tool {
  min-width: 30px;
  height: 28px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 13px;
  cursor: pointer;
  transition: background 0.15s ease, box-shadow 0.15s ease;
}

.explorer-tool:hover:not(:disabled) {
  background: var(--panel-bg-hover);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.explorer-tool:disabled {
  opacity: 0.4;
  cursor: default;
}

.explorer-roots {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 0 8px 6px;
}

.explorer-root {
  background: rgba(var(--accent-rgb), 0.12);
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 999px;
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.05em;
  padding: 3px 8px;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.explorer-root:hover {
  background: rgba(var(--accent-rgb), 0.3);
  border-color: var(--accent-bright);
}

.explorer-list {
  flex: 1;
  overflow-y: auto;
  padding: 2px 6px 8px;
}

.explorer-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  border-radius: 3px;
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 12px;
  padding: 5px 8px;
  cursor: pointer;
  transition: background 0.12s ease, box-shadow 0.12s ease;
}

.explorer-item:hover {
  background: var(--panel-bg-hover);
  box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.35);
}

.explorer-item-icon {
  font-size: 14px;
  flex-shrink: 0;
}

.explorer-item-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.explorer-item-meta {
  font-size: 9px;
  opacity: 0.5;
  flex-shrink: 0;
}

/* ——— Ferramentas do terminal do ARES ——— */
.terminal-tool {
  min-width: 30px;
  height: 28px;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 13px;
  cursor: pointer;
  transition: background 0.15s ease, box-shadow 0.15s ease;
  flex-shrink: 0;
}

.terminal-tool:hover:not(:disabled) {
  background: var(--panel-bg-hover);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.terminal-tool:disabled {
  opacity: 0.4;
  cursor: default;
}

/* ——— Janelas de app: barra de título estilo Windows/Opera GX ——— */
.win-titlebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 10px;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.35));
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.4);
  cursor: grab;
  user-select: none;
  flex-shrink: 0;
}

.win-titlebar:active {
  cursor: grabbing;
}

.win-title {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: "Courier New", monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--accent-bright);
  text-shadow: 0 0 8px rgba(var(--glow-rgb), 0.5);
}

.win-title i {
  font-size: 13px;
}

.win-controls {
  display: flex;
  gap: 3px;
  flex-shrink: 0;
}

.win-btn {
  width: 26px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  border-radius: 3px;
  color: var(--accent);
  font-size: 12px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

.win-btn:hover {
  background: var(--panel-bg-hover);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.win-btn-close:hover {
  background: #e81123;
  border-color: #e81123;
  color: #fff;
  box-shadow: 0 0 10px rgba(232, 17, 35, 0.6);
}

/* Maximizado: ocupa a tela inteira */
.win-window.win-max {
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  max-width: 100vw !important;
  height: 100vh !important;
  max-height: 100vh !important;
  border-radius: 0;
  transform: none !important;
  margin: 0 !important;
}

/* Minimizado: só a barra de título */
.win-window.win-min {
  height: auto !important;
}

.win-window.win-min .explorer-body,
.win-window.win-min .memory-msg,
.win-window.win-min .terminal-tools,
.win-window.win-min .terminal-out,
.win-window.win-min .terminal-form,
.win-window.win-min .editor-body,
.win-window.win-min .editor-msg,
.win-window.win-min .editor-actions,
.win-window.win-min .editor-diff,
.win-window.win-min .calendar-body,
.win-window.win-min .whatsapp-body,
.win-window.win-min .erros-body,
.win-window.win-min .erros-tools,
.win-window.win-min .music-body,
.win-window.win-min .fin-body,
.win-window.win-min .chat-body,
.win-window.win-min .peer-body {
  display: none;
}

/* Blur de fundo atrás de TODAS as janelas do HUD — o orbe vira um glow suave,
   sem partículas/números se misturando com o conteúdo da janela. */
.win-window {
  backdrop-filter: blur(16px) saturate(1.15);
}

/* Canto de redimensionar das janelas de app (mouse) */
.win-resize-corner {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 18px;
  height: 18px;
  cursor: nwse-resize;
  z-index: 6;
  border-right: 2px solid rgba(var(--accent-rgb), 0.55);
  border-bottom: 2px solid rgba(var(--accent-rgb), 0.55);
  border-bottom-right-radius: 3px;
  opacity: 0.55;
  transition: opacity 0.15s ease, box-shadow 0.15s ease;
}

.win-resize-corner:hover {
  opacity: 1;
  box-shadow: 0 0 10px rgba(var(--glow-rgb), 0.4);
}

/* ——— Explorer: corpo interno + dica de duplo clique ——— */
.explorer-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.explorer-tool-hint {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.05em;
  opacity: 0.55;
  color: var(--accent);
}

.explorer-panel.win-window {
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45), 0 0 16px rgba(var(--glow-rgb), 0.14);
}

/* ——— Janela REDE P2P (conexão com outras IAs) ——— */
.peer-panel.win-window {
  position: fixed;
  bottom: 90px;
  right: 24px;
  z-index: 27;
  width: 400px;
  max-width: calc(100vw - 48px);
  max-height: calc(100vh - 140px);
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--glow-rgb), 0.2);
}

.peer-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px;
  overflow-y: auto;
}

.peer-id-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
}

.peer-label {
  letter-spacing: 0.15em;
  color: var(--accent-bright);
  opacity: 0.7;
}

.peer-id {
  flex: 1;
  font-size: 11px;
  color: var(--accent-bright);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.peer-copy {
  background: none;
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  color: var(--accent-bright);
  border-radius: 2px;
  padding: 2px 6px;
  cursor: pointer;
}

.peer-copy:hover {
  background: rgba(var(--accent-rgb), 0.15);
}

.peer-status {
  font-size: 10px;
  letter-spacing: 0.12em;
  color: var(--accent);
  opacity: 0.85;
  border-left: 2px solid rgba(var(--accent-rgb), 0.5);
  padding-left: 8px;
}

.peer-status.st-conectado {
  color: #7fe0a0;
  border-left-color: #7fe0a0;
}

.peer-status.st-erro {
  color: #ff9d8a;
  border-left-color: #ff6a4a;
}

.peer-acoes {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.peer-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px 10px;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.1em;
  color: var(--accent-bright);
  background: rgba(var(--accent-rgb), 0.08);
  border: 1px solid rgba(var(--accent-rgb), 0.45);
  border-radius: 2px;
  cursor: pointer;
}

.peer-btn:hover:not(:disabled) {
  background: rgba(var(--accent-rgb), 0.18);
}

.peer-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.peer-btn-row {
  display: flex;
  gap: 6px;
}

.peer-btn-row .peer-btn {
  flex: 1;
}

/* Botão de perigo (recusar verificação de identidade) */
.peer-btn-perigo {
  color: #ff8a8a !important;
  background: rgba(255, 90, 90, 0.08) !important;
  border-color: rgba(255, 90, 90, 0.55) !important;
}

.peer-btn-perigo:hover:not(:disabled) {
  background: rgba(255, 90, 90, 0.16) !important;
}

/* Fingerprint em grupos de 4 para conferência manual */
.verif-fp {
  font-size: 13px !important;
  letter-spacing: 0.08em;
  line-height: 1.6;
  word-break: break-all;
}

.peer-textarea {
  width: 100%;
  resize: vertical;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 11px;
  padding: 6px;
  border-radius: 2px;
}

.peer-chat {
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-top: 1px solid rgba(var(--accent-rgb), 0.25);
  padding-top: 8px;
}

.peer-chat-titulo {
  font-size: 10px;
  letter-spacing: 0.15em;
  color: var(--accent-bright);
  opacity: 0.7;
}

.peer-chat-lista {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-height: 150px;
  overflow-y: auto;
  font-size: 12px;
}

.peer-chat-vazio {
  color: var(--accent);
  opacity: 0.5;
  font-size: 11px;
}

.peer-msg {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding: 4px 8px;
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  border-radius: 2px;
  background: rgba(var(--accent-rgb), 0.05);
}

.peer-msg.minha {
  align-self: flex-end;
  background: rgba(90, 217, 255, 0.1);
  border-color: rgba(90, 217, 255, 0.4);
}

.peer-msg-de {
  font-size: 9px;
  letter-spacing: 0.1em;
  color: var(--accent-bright);
  opacity: 0.6;
}

.peer-chat-input {
  display: flex;
  gap: 6px;
}

.peer-chat-input input {
  flex: 1;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  color: var(--accent);
  font-size: 12px;
  padding: 6px 8px;
  border-radius: 2px;
}


/* ——— Modal IDENTIDADE criptográfica ——— */
.ident-panel.win-window {
  position: fixed;
  top: 90px;
  right: 24px;
  z-index: 29;
  width: 380px;
  max-width: calc(100vw - 48px);
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--glow-rgb), 0.2);
}

.ident-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  overflow-y: auto;
}

.ident-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px;
  border: 1px solid rgba(86, 217, 255, 0.45);
  border-radius: 3px;
  background: rgba(86, 217, 255, 0.08);
}

.ident-card-nome {
  font-size: 15px;
  font-weight: bold;
  letter-spacing: 0.05em;
  color: var(--accent-bright);
}

.ident-card-fp {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ident-verde {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: #7fe0a0;
}

.ident-aviso {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  font-size: 11px;
  color: var(--accent);
  opacity: 0.9;
  line-height: 1.5;
  border-left: 2px solid rgba(var(--accent-rgb), 0.5);
  padding-left: 8px;
}

.ident-form {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ident-msg {
  font-size: 11px;
  color: var(--accent-bright);
  opacity: 0.9;
}

/* ——— Fluxo de convite dentro do CHAT ——— */
.chat-convite {
  display: flex;
  flex-direction: column;
  gap: 6px;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 3px;
  padding: 8px;
  background: rgba(0, 0, 0, 0.45);
}

.chat-convite-titulo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 10px;
  letter-spacing: 0.15em;
  color: var(--accent-bright);
  opacity: 0.75;
}

.chat-convite-ident {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 8px;
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.08em;
  color: var(--accent-bright);
  background: rgba(var(--accent-rgb), 0.12);
  border: 1px solid rgba(var(--accent-rgb), 0.45);
  border-radius: 2px;
  cursor: pointer;
}

.chat-convite-ident:hover {
  background: rgba(var(--accent-rgb), 0.22);
}

.chat-convite-acoes {
  display: flex;
  gap: 6px;
}

.chat-convite-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px 10px;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.08em;
  color: var(--accent-bright);
  background: rgba(var(--accent-rgb), 0.08);
  border: 1px solid rgba(var(--accent-rgb), 0.45);
  border-radius: 2px;
  cursor: pointer;
}

.chat-convite-btn:hover:not(:disabled) {
  background: rgba(var(--accent-rgb), 0.18);
}

.chat-convite-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.chat-convite-msg {
  font-size: 11px;
  color: var(--accent-bright);
  opacity: 0.9;
  line-height: 1.4;
}

/* ——— Janela FINANÇAS: planilha estilo Office ——— */
.fin-panel.win-window {
  position: fixed;
  bottom: 90px;
  left: 24px;
  z-index: 27;
  width: 560px;
  max-width: calc(100vw - 48px);
  max-height: calc(100vh - 140px);
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--glow-rgb), 0.2);
}

/* ——— Menu CONFIGURAÇÕES ——— */
.settings-panel.win-window {
  position: fixed;
  bottom: 90px;
  left: 24px;
  z-index: 28;
  width: 520px;
  max-width: calc(100vw - 48px);
  max-height: calc(100vh - 140px);
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--glow-rgb), 0.2);
}

.settings-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 10px;
  overflow-y: auto;
}

.settings-vazio {
  padding: 24px;
  text-align: center;
  color: rgba(var(--accent-rgb), 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.settings-secao {
  border: 1px solid rgba(var(--accent-rgb), 0.12);
  border-radius: 8px;
  padding: 8px 10px;
  background: rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.settings-titulo {
  margin: 0 0 2px;
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 700;
  color: var(--accent-bright);
  text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.6);
  display: flex;
  align-items: center;
  gap: 6px;
}

.settings-linha {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 4px 0;
}

.settings-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.settings-info strong {
  font-size: 12px;
  color: #e8f4ff;
}

.settings-info small {
  font-size: 10px;
  color: rgba(var(--accent-rgb), 0.55);
  overflow-wrap: anywhere;
}

.settings-range {
  width: 150px;
  accent-color: rgba(var(--glow-rgb), 0.9);
}

.settings-mono {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 10px !important;
  color: rgba(var(--accent-rgb), 0.75) !important;
}

.settings-voz-btns {
  display: flex;
  gap: 6px;
}

.settings-quick {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}

.settings-quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px 4px;
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.05);
  color: var(--accent-bright);
  font-size: 10px;
  letter-spacing: 1px;
  cursor: pointer;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
}

.settings-quick-btn i {
  font-size: 16px;
  color: rgba(var(--accent-rgb), 0.85);
}

.settings-quick-btn:hover {
  border-color: rgba(var(--accent-rgb), 0.6);
  box-shadow: 0 0 10px rgba(var(--glow-rgb), 0.35);
  background: rgba(255, 255, 255, 0.1);
}

.cfg-toggle {
  width: 42px;
  height: 22px;
  border-radius: 11px;
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  background: rgba(255, 255, 255, 0.08);
  position: relative;
  cursor: pointer;
  flex-shrink: 0;
  transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
}

.cfg-toggle-thumb {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: rgba(var(--accent-rgb), 0.85);
  transition: transform 0.2s;
}

.cfg-toggle.on {
  background: rgba(var(--glow-rgb), 0.35);
  border-color: rgba(var(--glow-rgb), 0.8);
  box-shadow: 0 0 10px rgba(var(--glow-rgb), 0.5);
}

.cfg-toggle.on .cfg-toggle-thumb {
  transform: translateX(20px);
  background: #fff;
}

.settings-msg {
  text-align: center;
  font-size: 11px;
  color: var(--accent-bright);
  padding: 6px;
  border: 1px solid rgba(var(--glow-rgb), 0.4);
  border-radius: 6px;
  background: rgba(var(--glow-rgb), 0.1);
}

.fin-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px;
  overflow-y: auto;
}

.fin-resumo {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}

.fin-resumo-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 8px;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 2px;
  background: rgba(0, 0, 0, 0.4);
}

.fin-resumo-item.neg {
  border-color: rgba(255, 107, 107, 0.5);
}

.fin-resumo-item.pos {
  border-color: rgba(127, 224, 160, 0.5);
}

.fin-resumo-label {
  font-size: 9px;
  letter-spacing: 0.15em;
  color: var(--accent-bright);
  opacity: 0.6;
}

.fin-resumo-valor {
  font-size: 14px;
  font-weight: bold;
  color: var(--accent-bright);
  font-variant-numeric: tabular-nums;
}

.fin-resumo-item.neg .fin-resumo-valor {
  color: #ff6b6b;
}

.fin-resumo-item.pos .fin-resumo-valor {
  color: #7fe0a0;
}

.fin-form {
  display: flex;
  gap: 6px;
  align-items: stretch;
  flex-wrap: wrap;
}

.fin-form-tipos {
  display: flex;
  gap: 4px;
}

.fin-tipo {
  padding: 6px 10px;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.08em;
  color: var(--accent-bright);
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  border-radius: 2px;
  cursor: pointer;
}

.fin-tipo.ativo.neg {
  background: rgba(255, 107, 107, 0.18);
  border-color: rgba(255, 107, 107, 0.6);
  color: #ff9d8a;
}

.fin-tipo.ativo.pos {
  background: rgba(127, 224, 160, 0.18);
  border-color: rgba(127, 224, 160, 0.6);
  color: #a8f0c0;
}

.fin-input {
  flex: 1;
  min-width: 90px;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  color: var(--accent);
  font-size: 12px;
  padding: 6px 8px;
  border-radius: 2px;
}

.fin-input option {
  background: #0a0f14;
  color: var(--accent);
}

.fin-add {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.1em;
  color: #0a0f14;
  background: var(--accent-bright);
  border: none;
  border-radius: 2px;
  cursor: pointer;
}

.fin-add:hover {
  filter: brightness(1.15);
}

.fin-msg {
  font-size: 11px;
  color: var(--accent-bright);
  opacity: 0.9;
  border-left: 2px solid rgba(var(--accent-rgb), 0.5);
  padding-left: 8px;
}

.fin-grafico {
  display: flex;
  flex-direction: column;
  gap: 4px;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 2px;
  padding: 8px;
  background: rgba(0, 0, 0, 0.4);
}

.fin-grafico-titulo {
  font-size: 9px;
  letter-spacing: 0.15em;
  color: var(--accent-bright);
  opacity: 0.6;
}

.fin-grafico-canvas {
  width: 100%;
}

.fin-chart-canvas {
  display: block;
  width: 100%;
  height: auto;
}

.fin-tabela {
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 2px;
  overflow: hidden;
}

.fin-tabela-head,
.fin-linha {
  display: grid;
  grid-template-columns: 70px 1fr 90px 110px 34px;
  gap: 6px;
  align-items: center;
  padding: 5px 8px;
  font-size: 11px;
}

.fin-tabela-head {
  background: rgba(var(--accent-rgb), 0.12);
  letter-spacing: 0.12em;
  font-size: 9px;
  color: var(--accent-bright);
  opacity: 0.7;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.3);
}

.fin-linha {
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.12);
}

.fin-linha.pos .fin-cel-valor {
  color: #7fe0a0;
}

.fin-linha.neg .fin-cel-valor {
  color: #ff6b6b;
}

.fin-cel-desc small {
  display: block;
  font-size: 9px;
  color: var(--accent-bright);
  opacity: 0.45;
}

.fin-cel-valor {
  font-weight: bold;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.fin-cel-del {
  text-align: right;
}

.fin-del {
  background: none;
  border: none;
  color: rgba(255, 107, 107, 0.8);
  cursor: pointer;
  padding: 2px 4px;
}

.fin-del:hover {
  color: #ff6b6b;
}

.fin-vazio {
  padding: 14px;
  font-size: 11px;
  color: var(--accent);
  opacity: 0.55;
  text-align: center;
}

/* ——— Janela CHAT P2P: contatos + conversas + mídia ——— */
.chat-panel.win-window {
  position: fixed;
  bottom: 90px;
  left: 24px;
  z-index: 28;
  width: 640px;
  height: 480px;
  max-width: calc(100vw - 48px);
  max-height: calc(100vh - 140px);
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--glow-rgb), 0.2);
}

.chat-body {
  display: flex;
  flex: 1;
  min-height: 0;
}

.chat-side {
  width: 190px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 8px;
  border-right: 1px solid rgba(var(--accent-rgb), 0.25);
  overflow-y: auto;
}

.chat-side-titulo {
  font-size: 10px;
  letter-spacing: 0.15em;
  color: var(--accent-bright);
  opacity: 0.7;
}

.chat-contato-form {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.chat-input-peq {
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  color: var(--accent);
  font-size: 11px;
  padding: 4px 6px;
  border-radius: 2px;
}

.chat-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 5px 8px;
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.1em;
  color: #0a0f14;
  background: var(--accent-bright);
  border: none;
  border-radius: 2px;
  cursor: pointer;
}

.chat-add:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.chat-contatos {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.chat-contato {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1px;
  padding: 6px 8px;
  text-align: left;
  background: rgba(var(--accent-rgb), 0.05);
  border: 1px solid rgba(var(--accent-rgb), 0.2);
  border-radius: 2px;
  color: var(--accent);
  cursor: pointer;
  width: 100%;
}

.chat-contato-linha {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  min-width: 0;
}

.chat-contato-info {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
  flex: 1;
}

.chat-contato-bloqueado {
  color: #ff6b6b;
  font-size: 13px;
  opacity: 0.8;
}

.chat-contato.bloqueado {
  opacity: 0.55;
}

/* Avatar determinístico (iniciais + cor do ID) */
.chat-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #04121a;
  font-weight: 800;
  letter-spacing: 0.02em;
  flex-shrink: 0;
  user-select: none;
  box-shadow: 0 0 8px rgba(0, 0, 0, 0.35), inset 0 0 0 1px rgba(255, 255, 255, 0.25);
}

.chat-contato:hover {
  background: rgba(var(--accent-rgb), 0.12);
}

.chat-contato.ativo {
  background: rgba(90, 217, 255, 0.16);
  border-color: rgba(90, 217, 255, 0.55);
}

.chat-contato-nome {
  font-size: 12px;
  font-weight: bold;
  color: var(--accent-bright);
}

.chat-contato-id {
  font-size: 9px;
  color: var(--accent);
  opacity: 0.5;
}

.chat-contato-estado {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  opacity: 0.6;
}

.chat-contato-estado .bi-circle-fill {
  color: #7fe0a0;
}

.chat-contato-estado .bi-circle-half {
  color: #ffd166;
}

.chat-contato-estado .bi-circle {
  color: #ff6b6b;
}

.chat-contato-novos {
  align-self: flex-end;
  margin-top: 2px;
  min-width: 16px;
  text-align: center;
  font-size: 9px;
  font-weight: bold;
  color: #0a0f14;
  background: var(--accent-bright);
  border-radius: 8px;
  padding: 1px 5px;
}

.chat-side-nota {
  margin-top: auto;
  font-size: 9px;
  color: var(--accent);
  opacity: 0.5;
  line-height: 1.4;
}

.chat-vazio {
  padding: 12px;
  font-size: 11px;
  color: var(--accent);
  opacity: 0.55;
  text-align: center;
  line-height: 1.5;
}

.chat-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 8px;
  gap: 6px;
}

.chat-main-titulo {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 0.08em;
  color: var(--accent-bright);
  min-width: 0;
}

.chat-main-nome {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-status {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.7;
}

.chat-status.online {
  color: #7fe0a0;
}

.chat-status.conectando {
  color: #ffd166;
}

.chat-status.offline {
  color: #ff6b6b;
}

.chat-status i {
  font-size: 7px;
}

.chat-bloqueado-label {
  font-size: 9px;
  letter-spacing: 0.1em;
  color: #ff6b6b;
  border: 1px solid rgba(255, 107, 107, 0.5);
  padding: 1px 6px;
  border-radius: 999px;
  white-space: nowrap;
}

.chat-acoes {
  display: inline-flex;
  gap: 4px;
  margin-left: auto;
}

.chat-acao {
  width: 26px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  border-radius: 3px;
  color: var(--accent);
  font-size: 12px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.chat-acao:hover {
  background: rgba(var(--accent-rgb), 0.25);
}

.chat-acao.perigo:hover {
  background: rgba(255, 107, 107, 0.25);
  color: #ff9b9b;
  border-color: rgba(255, 107, 107, 0.6);
}

.chat-lista {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 4px;
  border: 1px solid rgba(var(--accent-rgb), 0.2);
  border-radius: 2px;
  background: rgba(0, 0, 0, 0.3);
}

.chat-msg {
  display: flex;
  align-items: flex-end;
  gap: 6px;
}

.chat-msg.minha {
  justify-content: flex-end;
}

.chat-msg-bolha {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 6px 9px;
  border-radius: 8px;
  background: rgba(var(--accent-rgb), 0.1);
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  font-size: 12px;
  color: var(--accent);
}

.chat-msg.minha .chat-msg-bolha {
  background: rgba(90, 217, 255, 0.16);
  border-color: rgba(90, 217, 255, 0.5);
}

.chat-msg-hora {
  align-self: flex-end;
  font-size: 8px;
  color: var(--accent-bright);
  opacity: 0.5;
}

.chat-tools {
  display: flex;
  gap: 5px;
}

.chat-tool {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 26px;
  background: rgba(var(--accent-rgb), 0.08);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  border-radius: 2px;
  color: var(--accent-bright);
  cursor: pointer;
}

.chat-tool:hover,
.chat-tool.ativo {
  background: rgba(var(--accent-rgb), 0.2);
}

.chat-tool.gravando {
  background: rgba(255, 107, 107, 0.25);
  border-color: rgba(255, 107, 107, 0.7);
  color: #ff9d8a;
}

.chat-gravando-dot {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #ff6b6b;
  animation: chat-pulse 1s ease-in-out infinite;
}

@keyframes chat-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.3;
    transform: scale(0.7);
  }
}

.chat-file-hidden {
  display: none;
}

.chat-cam {
  display: flex;
  flex-direction: column;
  gap: 6px;
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  border-radius: 4px;
  padding: 6px;
  background: rgba(0, 0, 0, 0.55);
}

.chat-cam-video {
  width: 100%;
  max-height: 220px;
  object-fit: cover;
  border-radius: 3px;
  background: #000;
}

.chat-cam-botoes {
  display: flex;
  gap: 6px;
}

.chat-cam-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px 10px;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.1em;
  color: #0a0f14;
  background: var(--accent-bright);
  border: none;
  border-radius: 2px;
  cursor: pointer;
}

.chat-cam-btn:hover {
  filter: brightness(1.15);
}

.chat-cam-btn.fechar {
  flex: 0 0 auto;
  color: var(--accent-bright);
  background: rgba(var(--accent-rgb), 0.1);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
}

.chat-cam-btn.fechar:hover {
  background: rgba(var(--accent-rgb), 0.2);
  filter: none;
}

.chat-input-row {
  display: flex;
  gap: 6px;
}

.chat-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(var(--accent-rgb), 0.35);
  color: var(--accent);
  font-size: 12px;
  padding: 7px 9px;
  border-radius: 2px;
}

.chat-send {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  background: var(--accent-bright);
  border: none;
  border-radius: 2px;
  color: #0a0f14;
  cursor: pointer;
}

.chat-send:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.chat-url-preview {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: var(--accent-bright);
  opacity: 0.85;
}

.chat-aviso {
  font-size: 11px;
  color: #ff9d8a;
  border-left: 2px solid rgba(255, 107, 107, 0.6);
  padding-left: 8px;
}

.chat-nat-dica {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  font-size: 10px;
  line-height: 1.45;
  color: #ffd166;
  background: rgba(255, 209, 102, 0.06);
  border: 1px solid rgba(255, 209, 102, 0.25);
  border-left: 2px solid rgba(255, 209, 102, 0.6);
  border-radius: 3px;
  padding: 5px 8px;
  margin: 6px 10px 0;
}

.chat-nat-dica i {
  font-size: 11px;
  margin-top: 1px;
}

.chat-turn-aviso {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  background: linear-gradient(90deg, rgba(255, 209, 102, 0.10), rgba(255, 209, 102, 0.03));
  border: 1px solid rgba(255, 209, 102, 0.35);
  border-left: 3px solid rgba(255, 209, 102, 0.8);
  border-radius: 3px;
  padding: 7px 10px;
  margin: 8px 10px 0;
}

.chat-turn-aviso-txt {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  font-size: 10.5px;
  line-height: 1.5;
  color: var(--accent-bright);
  flex: 1;
}

.chat-turn-aviso-txt i {
  font-size: 14px;
  color: #ffd166;
  margin-top: 1px;
}

.chat-turn-aviso-txt strong {
  color: #ffd166;
}

.chat-turn-aviso-txt code {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 9.5px;
  color: #ffe29a;
  background: rgba(255, 209, 102, 0.12);
  border: 1px solid rgba(255, 209, 102, 0.25);
  border-radius: 2px;
  padding: 0 4px;
}

.chat-turn-aviso-x {
  width: 20px;
  height: 20px;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  color: rgba(255, 209, 102, 0.7);
  font-size: 14px;
  cursor: pointer;
  border-radius: 2px;
}

.chat-turn-aviso-x:hover {
  background: rgba(255, 209, 102, 0.15);
  color: #ffe29a;
}

.chat-diag {
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 3px;
  background: rgba(0, 0, 0, 0.35);
  margin: 6px 10px 0;
  overflow: hidden;
}

.chat-diag-titulo {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 9px;
  letter-spacing: 0.12em;
  color: var(--accent-bright);
  padding: 5px 8px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
  background: rgba(var(--accent-rgb), 0.08);
}

.chat-diag-hora {
  margin-left: auto;
  opacity: 0.55;
  font-size: 8.5px;
  letter-spacing: 0.05em;
}

.chat-diag-linha {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.12);
  font-size: 10px;
}

.chat-diag-nome {
  font-weight: 600;
  color: var(--accent-bright);
  margin-right: 4px;
  white-space: nowrap;
}

.chat-diag-chip {
  font-size: 8.5px;
  letter-spacing: 0.06em;
  padding: 1px 5px;
  border-radius: 999px;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  color: rgba(var(--accent-rgb), 0.85);
  background: rgba(var(--accent-rgb), 0.06);
  white-space: nowrap;
}

.chat-diag-chip.online {
  color: #7fe0a0;
  border-color: rgba(127, 224, 160, 0.5);
  background: rgba(127, 224, 160, 0.08);
}

.chat-diag-chip.conectando {
  color: #ffd166;
  border-color: rgba(255, 209, 102, 0.5);
  background: rgba(255, 209, 102, 0.08);
}

.chat-diag-chip.offline {
  color: #ff6b6b;
  border-color: rgba(255, 107, 107, 0.5);
  background: rgba(255, 107, 107, 0.08);
}

.chat-diag-chip.ok {
  color: #7fe0a0;
  border-color: rgba(127, 224, 160, 0.5);
}

.chat-diag-chip.relay {
  color: #6ec3ff;
  border-color: rgba(110, 195, 255, 0.5);
  background: rgba(110, 195, 255, 0.08);
}

.chat-diag-dica {
  font-size: 8.5px;
  line-height: 1.5;
  opacity: 0.6;
  padding: 5px 8px;
  color: var(--accent-bright);
}

.chat-diag-vazio {
  font-size: 10px;
  opacity: 0.6;
  padding: 6px 8px;
}

.chat-url-btn {
  padding: 3px 8px;
  font-size: 10px;
  background: rgba(var(--accent-rgb), 0.12);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 2px;
  color: var(--accent-bright);
  cursor: pointer;
}

.chat-url-btn:hover {
  background: rgba(var(--accent-rgb), 0.22);
}

/* Mídia dentro das mensagens */
.rich-texto {
  white-space: pre-wrap;
  word-break: break-word;
}

.rich-emoji {
  font-size: 34px;
  line-height: 1.2;
  display: inline-block;
  animation: emoji-pop 0.9s ease-in-out infinite alternate;
  /* Emojis em CORES (o padrão do GitHub/HuggingFace): usa a fonte de emoji do
     sistema em vez do glifo monocromático da fonte do HUD. */
  font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", "Twemoji Mozilla", sans-serif;
  font-variant-emoji: emoji;
}

@keyframes emoji-pop {
  from {
    transform: scale(0.92) rotate(-6deg);
  }
  to {
    transform: scale(1.12) rotate(6deg);
  }
}

.rich-imagem {
  max-width: 100%;
  max-height: 220px;
  border-radius: 4px;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  display: block;
}

.rich-video {
  max-width: 100%;
  max-height: 220px;
  border-radius: 4px;
}

.rich-audio {
  display: flex;
  align-items: center;
  gap: 8px;
}

.rich-audio audio {
  max-width: 100%;
}

.rich-audio-duracao {
  font-size: 10px;
  color: var(--accent-bright);
  opacity: 0.6;
  white-space: nowrap;
}

.rich-sticker {
  font-size: 72px;
  line-height: 1;
  display: inline-block;
  font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", "Twemoji Mozilla", sans-serif;
  font-variant-emoji: emoji;
  animation: sticker-in 0.35s ease-out;
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
}

@keyframes sticker-in {
  from {
    transform: scale(0.4) rotate(-8deg);
    opacity: 0;
  }
  to {
    transform: scale(1) rotate(0);
    opacity: 1;
  }
}

.rich-truncado {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: var(--accent);
  opacity: 0.65;
  font-style: italic;
}

.chat-stickers {
  display: flex;
  flex-direction: column;
  gap: 5px;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 2px;
  padding: 6px;
  background: rgba(0, 0, 0, 0.5);
  max-height: 260px;
  overflow-y: auto;
}

.chat-stickers-titulo {
  font-size: 9px;
  letter-spacing: 0.15em;
  color: var(--accent-bright);
  opacity: 0.6;
}

.chat-stickers-grade {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.chat-sticker-btn {
  width: 30px;
  height: 30px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  background: rgba(var(--accent-rgb), 0.08);
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 4px;
  cursor: pointer;
  transition: transform 0.15s ease;
  font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", "Twemoji Mozilla", sans-serif;
  font-variant-emoji: emoji;
  line-height: 1;
}

.chat-sticker-btn:hover {
  transform: scale(1.25);
  background: rgba(var(--accent-rgb), 0.2);
}

.chat-sticker-btn.grande {
