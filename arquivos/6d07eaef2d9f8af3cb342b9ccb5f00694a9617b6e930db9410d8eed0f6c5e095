@import url("https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&display=swap");
/* ——— Tema (variáveis CSS): preto e branco puro em TODOS os modos ——— */
:root {
  --accent: #ffffff;
  --accent-bright: #ffffff;
  --accent-rgb: 255, 255, 255;
  --accent-bright-rgb: 255, 255, 255;
  --accent-hex: #ffffff;
  --glow-rgb: 200, 200, 200;
  --bg: #04070c;
  --text: #eaf6fc;
  --text-dim: #9fb8cc;
  --text-rgb: 234, 246, 252;
  --text-primary: #eaf6fc;
  --text-secondary: #9fb8cc;
  --panel-bg: rgba(18, 18, 18, 0.55);
  --panel-bg-solid: rgba(18, 18, 18, 0.8);
  --panel-bg-hover: rgba(55, 55, 55, 0.7);
  --panel-bg-active: rgba(85, 85, 85, 0.8);
  --panel-bg-pressed: rgba(105, 105, 105, 0.6);
  --panel-bg-clear: rgba(18, 18, 18, 0.6);
  --header-bg: rgba(42, 42, 42, 0.5);
  --dot-idle: #3a3a3a;
  --camera-bg: #0a0a0a;
  --camera-status-bg: rgba(14, 14, 14, 0.65);
  --cam-hue: 0deg;
}


* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  height: 100%;
}

body {
  background: #000;
  overflow: hidden;
  font-family: "Courier New", monospace;
}

.orb-root {
  position: fixed;
  inset: 0;
  cursor: grab;
}

.orb-root:active {
  cursor: grabbing;
}

.orb-root canvas {
  display: block;
}

/* Film grain overlay */
.overlay-grain {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 10;
  opacity: 0.06;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 150px;
  mix-blend-mode: screen;
}

/* Scanline overlay */
.overlay-scanlines {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 11;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0px,
    transparent 2px,
    rgba(0, 0, 0, 0.15) 2px,
    rgba(0, 0, 0, 0.15) 4px
  );
  opacity: 0.3;
}

/* ——— Probe de FPS oculto (?fps=1 na URL) ——— */
.fps-probe {
  position: fixed;
  bottom: 12px;
  right: 12px;
  z-index: 100;
  font-family: "Courier New", monospace;
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--accent-bright);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.8);
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  border-radius: 3px;
  padding: 3px 8px;
  pointer-events: none;
}

/* Vignette */
.overlay-vignette {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9;
  background: radial-gradient(
    ellipse at center,
    transparent 40%,
    rgba(0, 0, 0, 0.7) 100%
  );
}

/* ——— HUD ——— */
.hud {
  position: fixed;
  z-index: 20;
  color: var(--accent);
  font-family: "Courier New", monospace;
  user-select: none;
}

.hud-controls {
  position: fixed;
  right: 24px;
  bottom: 24px;
  width: 236px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px 10px 10px;
  background:
    linear-gradient(170deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 36%),
    rgba(5, 5, 5, 0.78);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 2px;
  backdrop-filter: blur(8px);
  box-shadow:
    0 0 32px rgba(var(--glow-rgb), 0.16),
    0 0 0 1px rgba(0, 0, 0, 0.6) inset,
    0 18px 44px rgba(0, 0, 0, 0.55);
}

/* Cantoneiras HUD: 4 cantos com brilho (estilo visor) */
.hud-controls::before {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: 3;
  pointer-events: none;
  background:
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top left / 14px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top left / 2px 14px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top right / 14px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top right / 2px 14px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom left / 14px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom left / 2px 14px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom right / 14px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom right / 2px 14px;
  filter: drop-shadow(0 0 3px rgba(var(--glow-rgb), 0.9));
  opacity: 0.85;
}

.hud-btn {
  position: relative;
  width: 100%;
  min-width: 0;
  height: 40px;
  padding: 0 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  white-space: nowrap;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 55%), rgba(10, 10, 10, 0.62);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px);
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 13px;
  font-weight: bold;
  letter-spacing: 0.08em;
  cursor: pointer;
  backdrop-filter: blur(2px);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.7);
  box-shadow: 0 0 12px rgba(var(--glow-rgb), 0.12) inset;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

/* Badge de mensagens não lidas no botão CHAT (chegam com o chat fechado) */
.hud-btn-badge {
  position: absolute;
  top: 3px;
  right: 4px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: rgba(255, 90, 90, 0.95);
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 0 8px rgba(255, 80, 80, 0.55);
  animation: chat-badge-pulso 1s ease-in-out infinite alternate;
  pointer-events: none;
}

.hud-btn-badge.contato-online {
  right: 22px;
  background: rgba(64, 190, 120, 0.95);
  box-shadow: 0 0 8px rgba(64, 190, 120, 0.55);
  animation: none;
  gap: 2px;
}

.hud-btn-badge.contato-online i {
  font-size: 5px;
}

@keyframes chat-badge-pulso {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1.12);
  }
}

/* Varredura de luz ao passar o mouse */
.hud-btn::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: -45%;
  width: 38%;
  background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transform: skewX(-22deg);
  opacity: 0;
  pointer-events: none;
  transition: left 0.3s ease, opacity 0.15s ease;
}

.hud-btn:hover {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0) 55%), var(--panel-bg-hover);
  border-color: rgba(var(--accent-bright-rgb), 0.9);
}

.hud-btn:hover::after {
  left: 115%;
  opacity: 1;
}

.hud-btn:active {
  background: var(--panel-bg-active);
}

.hud-btn[aria-pressed="true"],
.hud-btn.active {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.02) 60%), var(--panel-bg-pressed);
  border-color: var(--accent-bright);
  color: var(--accent-bright);
  box-shadow:
    0 0 16px rgba(var(--glow-rgb), 0.45),
    0 0 14px rgba(var(--glow-rgb), 0.25) inset;
}

.hud-btn:disabled {
  opacity: 0.5;
  cursor: default;
}

.hud-btn:disabled::after {
  display: none;
}

.hud-btn-mic {
  border-color: rgba(var(--accent-rgb), 0.7);
}

.hud-row {
  display: grid;
  gap: 8px;
}

.hud-row.full {
  grid-template-columns: 1fr;
}

.hud-row.trio {
  grid-template-columns: repeat(3, 1fr);
}

.hud-row.duo {
  grid-template-columns: repeat(2, 1fr);
}

.hud-hint {
  bottom: 24px;
  left: 24px;
  font-size: 11px;
  line-height: 1.7;
  letter-spacing: 0.1em;
  opacity: 0.55;
  text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.6);
  pointer-events: none;
}

.hud-hint .key {
  display: inline-block;
  padding: 0 4px;
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  margin-right: 4px;
  font-size: 10px;
}

.hud-title {
  top: 24px;
  left: 24px;
  font-size: 13px;
  letter-spacing: 0.35em;
  opacity: 0.7;
  text-shadow: 0 0 10px rgba(var(--accent-rgb), 0.8);
  pointer-events: none;
}

.hud-subtitle {
  margin-top: 6px;
  font-size: 9px;
  letter-spacing: 0.25em;
  opacity: 0.45;
  text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.5);
}

.hud-title::after {
  content: "";
  display: block;
  margin-top: 6px;
  width: 120px;
  height: 1px;
  background: linear-gradient(to right, rgba(var(--accent-rgb), 0.8), transparent);
}

.hud-error {
  font-size: 11px;
  letter-spacing: 0.15em;
  color: #ff5533;
  text-shadow: 0 0 8px rgba(255, 60, 30, 0.7);
}

/* ——— Relógio digital futurista (horário de Brasília) ——— */
.hud-clock {
  top: 24px;
  right: 24px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  padding-top: 18px;
  background: transparent;
  border: none;
  backdrop-filter: none;
  box-shadow: none;
  pointer-events: none;
}

.hud-clock .clock-time {
  font-family: "Orbitron", "Courier New", monospace;
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.12em;
  color: #f2fdff;
  /* Borda ciano nos números (contorno de cada dígito) */
  -webkit-text-stroke: 1px #56d9ff;
  font-variant-numeric: tabular-nums;
  text-shadow:
    0 0 16px rgba(86, 217, 255, 0.95),
    0 0 5px rgba(86, 217, 255, 0.9),
    0 0 2px rgba(86, 217, 255, 0.8);
}

.hud-clock .clock-time::after {
  content: "▮";
  margin-left: 6px;
  font-size: 15px;
  opacity: 0.55;
  animation: clock-cursor 1s step-start infinite;
}

.hud-clock .clock-date {
  font-family: "Orbitron", "Courier New", monospace;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.32em;
  color: var(--accent);
  opacity: 0.85;
  text-shadow: 0 0 10px rgba(var(--accent-rgb), 0.7);
}

@keyframes clock-cursor {
  50% {
    opacity: 0.12;
  }
}

/* ——— Log panel ——— */
.log-panel {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  width: 400px;
  max-width: calc(100vw - 48px);
  display: none;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 4px;
  backdrop-filter: blur(3px);
  box-shadow: 0 0 16px rgba(var(--glow-rgb), 0.14);
  overflow: hidden;
}

.log-panel.visible {
  display: flex;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 10px;
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.2em;
  color: var(--accent);
  text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.7);
  background: var(--header-bg);
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.25);
}

.log-clear {
  background: var(--panel-bg-clear);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.15em;
  padding: 2px 8px;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.log-clear:hover {
  background: var(--panel-bg-hover);
  border-color: var(--accent-bright);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.log-list {
  max-height: 180px;
  overflow-y: auto;
  padding: 4px 0;
}

.log-item {
  display: flex;
  align-items: baseline;
  gap: 7px;
  padding: 4px 10px;
  font-size: 12.5px;
  line-height: 1.5;
  letter-spacing: 0.04em;
  color: var(--accent-bright);
  text-shadow: 0 0 6px rgba(var(--accent-rgb), 0.35);
  border-left: 2px solid rgba(var(--accent-rgb), 0.35);
  animation: log-in 0.25s ease-out;
}

.log-item-err {
  color: #ff7a5e;
  text-shadow: 0 0 6px rgba(255, 85, 51, 0.4);
  border-left-color: rgba(255, 85, 51, 0.6);
}

.log-time {
  flex-shrink: 0;
  color: rgba(var(--accent-rgb), 0.55);
  font-size: 11px;
}

.log-icon {
  flex-shrink: 0;
}

.log-tool {
  flex-shrink: 0;
  font-weight: bold;
  font-size: 11.5px;
  opacity: 0.85;
}

.log-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

@keyframes log-in {
  from {
    opacity: 0;
    transform: translateX(-6px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ——— Voice panel ——— */
.voice-panel {
  position: fixed;
  /* Lado esquerdo, logo abaixo do logo/título do HUD */
  top: 100px;
  left: 24px;
  z-index: 20;
  min-width: 260px;
  max-width: 380px;
  max-height: min(60vh, 520px);
  overflow-y: auto;
  padding: 4px 6px;
  display: none;
  flex-direction: column;
  gap: 5px;
  /* Sem caixa: texto flutuante com glow, estilo HUD limpo */
  background: transparent;
  border: none;
  border-radius: 0;
  backdrop-filter: none;
  color: var(--accent);
  font-size: 14px;
  letter-spacing: 0.1em;
  text-shadow:
    0 0 6px rgba(var(--accent-rgb), 0.9),
    0 0 18px rgba(var(--accent-rgb), 0.45),
    0 0 42px rgba(var(--glow-rgb), 0.3);
  box-shadow: none;
}

.voice-panel.visible {
  display: flex;
}

.voice-line {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: bold;
}

.voice-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--dot-idle);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
}

.voice-dot.live {
  background: var(--accent);
  box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.9);
  animation: voice-pulse 1s ease-in-out infinite;
}

@keyframes voice-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.voice-hearing {
  color: var(--accent-bright);
  font-size: 15px;
  word-break: break-word;
  overflow-wrap: anywhere;
  max-width: 100%;
}

.voice-reply {
  color: var(--accent-bright);
  font-weight: bold;
  font-size: 15px;
  word-break: break-word;
  overflow-wrap: anywhere;
  max-width: 100%;
  margin-top: 3px;
  text-shadow:
    0 0 7px rgba(var(--accent-rgb), 0.95),
    0 0 22px rgba(var(--accent-rgb), 0.5);
}

.voice-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
  padding-top: 2px;
}

.voice-suggestion {
  padding: 5px 10px;
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 999px;
  background: rgba(var(--accent-rgb), 0.1);
  color: var(--accent-bright);
  font-family: "Courier New", monospace;
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.05em;
  text-align: left;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.voice-suggestion:hover {
  background: rgba(var(--accent-rgb), 0.3);
  border-color: var(--accent-bright);
  box-shadow: 0 0 10px rgba(var(--glow-rgb), 0.35);
}

.voice-confirming {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  border: 1px solid rgba(var(--accent-bright-rgb), 0.7);
  border-radius: 3px;
  background: rgba(var(--accent-rgb), 0.12);
  color: var(--accent-bright);
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 0.1em;
  animation: confirm-blink 1.1s ease-in-out infinite;
}

/* ——— Caixa de digitação (URL/@) ——— */
.voice-type {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 8px;
  border: 1px solid rgba(var(--accent-bright-rgb), 0.6);
  border-radius: 3px;
  background: rgba(0, 0, 0, 0.55);
  margin-top: 6px;
}

.voice-type-label {
  color: var(--accent-bright);
  font-size: 9px;
  font-weight: bold;
  letter-spacing: 0.12em;
}

.voice-type-row {
  display: flex;
  gap: 6px;
}

.voice-type-input {
  flex: 1;
  min-width: 0;
  padding: 6px 8px;
  background: rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  color: var(--accent-bright);
  font-size: 12px;
  font-family: inherit;
  letter-spacing: 0.04em;
}

.voice-type-input:focus {
  outline: none;
  border-color: var(--accent-bright);
  box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.5);
}

.voice-type-input::placeholder {
  color: rgba(var(--accent-rgb), 0.6);
}

.voice-type-btn {
  padding: 6px 10px;
  border: 1px solid rgba(var(--accent-rgb), 0.5);
  border-radius: 3px;
  background: rgba(var(--accent-rgb), 0.15);
  color: var(--accent-bright);
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 0.1em;
  cursor: pointer;
}

.voice-type-btn:hover:not(:disabled) {
  background: rgba(var(--accent-rgb), 0.35);
}

.voice-type-btn:disabled {
  opacity: 0.4;
  cursor: default;
}

.voice-type-close {
  background: transparent;
  border-color: rgba(var(--accent-rgb), 0.35);
}

.voice-confirm-icon {
  font-size: 12px;
  line-height: 1;
  animation: confirm-icon-pulse 0.8s ease-in-out infinite;
}

@keyframes confirm-blink {
  0%,
  100% {
    opacity: 1;
    box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.5);
  }
  50% {
    opacity: 0.55;
    box-shadow: 0 0 4px rgba(var(--accent-rgb), 0.15);
  }
}

@keyframes confirm-icon-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.35;
    transform: scale(0.85);
  }
}

/* ——— Camera preview panel ——— */
.camera-panel {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  display: none;
  border: 1px solid rgba(var(--accent-rgb), 0.55);
  border-radius: 2px;
  overflow: hidden;
  background: var(--camera-bg);
  box-shadow:
    0 0 20px rgba(var(--glow-rgb), 0.18),
    inset 0 0 34px rgba(0, 0, 0, 0.6);
}

/* Cantoneiras + scanlines + linha de varredura no preview da câmera */
.camera-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  background:
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top left / 16px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top left / 2px 16px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top right / 16px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat top right / 2px 16px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom left / 16px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom left / 2px 16px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom right / 16px 2px,
    linear-gradient(var(--accent-bright), var(--accent-bright)) no-repeat bottom right / 2px 16px;
  filter: drop-shadow(0 0 4px rgba(var(--glow-rgb), 0.9));
}

.camera-panel::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 4px),
    linear-gradient(180deg, transparent, transparent 45%, rgba(255, 255, 255, 0.18) 50%, transparent 55%, transparent);
  background-size: 100% 100%, 100% 240%;
  animation: camera-sweep 4.5s linear infinite;
  mix-blend-mode: overlay;
}

@keyframes camera-sweep {
  0% {
    background-position: 0 0, 0 -140%;
  }
  100% {
    background-position: 0 0, 0 240%;
  }
}

.camera-top {
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 4;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 12px;
  font-size: 10px;
  letter-spacing: 0.32em;
  color: var(--accent-bright);
  background: rgba(0, 0, 0, 0.62);
  border: 1px solid rgba(var(--accent-rgb), 0.45);
  clip-path: polygon(7px 0, 100% 0, calc(100% - 7px) 100%, 0 100%);
  text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.9);
}

.camera-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--dot-idle);
  border: 1px solid rgba(var(--accent-rgb), 0.5);
}

.camera-dot.live {
  background: var(--accent);
  box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.9);
  animation: voice-pulse 1s ease-in-out infinite;
}

.camera-dot.err {
  background: #ff5a5a;
  box-shadow: 0 0 8px rgba(255, 90, 90, 0.9);
}

.camera-panel.visible {
  display: block;
}

.camera-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scaleX(-1); /* mirror so it behaves like a mirror */
  /* Sem filtro de cor: o preview fica natural e você consegue centralizar o
     rosto no quadro — essencial para a leitura de BPM (rPPG amostra o centro).
     Hand tracking e rPPG leem os frames brutos, então o filtro era só visual. */
  opacity: 1;
}

.camera-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.camera-status {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 5px 10px;
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--accent-bright);
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.4) 72%, transparent);
  border-top: 1px solid rgba(var(--accent-rgb), 0.3);
  text-shadow: 0 0 8px rgba(var(--accent-rgb), 0.9);
}

.camera-status-item.bpm-live i {
  animation: bpm-pulse 1s ease-in-out infinite;
}

@keyframes bpm-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.25);
  }
}

.camera-status-item {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

/* ——— Modo interface (mãos controlam a UI) ——— */
.hand-mode-badge {
  position: fixed;
  top: 14px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 400;
  padding: 5px 14px;
  font-size: 11px;
  letter-spacing: 0.2em;
  color: var(--accent-bright);
  border: 1px solid rgba(var(--accent-bright-rgb), 0.7);
  background: rgba(0, 0, 0, 0.55);
  box-shadow: 0 0 14px rgba(var(--glow-rgb), 0.25);
  animation: confirm-blink 1.6s ease-in-out infinite;
  pointer-events: none;
}

.hand-cursor {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 500;
  width: 34px;
  height: 34px;
  opacity: 0;
  pointer-events: none;
  transform: translate(-999px, -999px);
  transition: opacity 0.15s ease;
}

.hand-cursor::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid var(--accent-bright);
  box-shadow:
    0 0 12px rgba(var(--glow-rgb), 0.8),
    0 0 26px rgba(var(--glow-rgb), 0.4);
  animation: cursor-ring 1.2s ease-in-out infinite;
}

.hand-cursor span {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6px;
  height: 6px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 1);
}

@keyframes cursor-ring {
  0%,
  100% {
    transform: scale(0.85);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.6;
  }
}

.panel-selected {
  border-color: var(--accent-bright) !important;
  box-shadow:
    0 0 0 1px rgba(var(--accent-bright-rgb), 0.8),
    0 0 22px rgba(var(--glow-rgb), 0.5) !important;
}

.panel-selected::before,
.panel-selected::after {
  content: "";
  position: absolute;
  width: 12px;
  height: 12px;
  border: 2px solid var(--accent-bright);
  background: rgba(0, 0, 0, 0.6);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.8);
  z-index: 10;
}

.panel-selected::before {
  top: -7px;
  left: -7px;
  border-right: none;
  border-bottom: none;
}

.panel-selected::after {
  bottom: -7px;
  right: -7px;
  border-left: none;
  border-top: none;
}

@media (max-width: 600px) {
  .hud-hint {
    display: none;
  }

  .log-panel {
    bottom: 260px;
    left: 16px;
    transform: none;
    width: calc(100vw - 32px);
    max-height: 140px;
  }

  .log-list {
    max-height: 96px;
  }
}

