}

.whatsapp-qr-title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--accent);
  display: inline-flex;
  gap: 8px;
  align-items: center;
}

.whatsapp-qr-sub {
  font-size: 12px;
