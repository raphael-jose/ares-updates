  }
}

.erros-dev-msg {
  margin-top: 8px;
  font-size: 12px;
  color: var(--text-dim);
  white-space: pre-wrap;
  word-break: break-word;
}

.erros-dev-msg.ok {
  color: #7dffa8;
}

.erros-dev-msg.erro {
