  cursor: grab;
}

.hud-controls-header.draggable:active {
  cursor: grabbing;
}

.hud-controls-title {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: "Courier New", monospace;
  font-size: 9px;
  letter-spacing: 0.2em;
  color: var(--accent-bright);
  text-shadow: 0 0 6px rgba(var(--glow-rgb), 0.5);
  white-space: nowrap;
}

.hud-controls-title::after {
  content: "▌";
  font-size: 10px;
  margin-left: 1px;
  animation: hud-cursor-blink 1.1s steps(2, start) infinite;
}

@keyframes hud-cursor-blink {
  to {
    opacity: 0.12;
  }
}

.hud-btn-collapse {
  min-width: 24px;
  height: 22px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: var(--accent);
  background: rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  clip-path: polygon(5px 0, 100% 0, 100% calc(100% - 5px), calc(100% - 5px) 100%, 0 100%, 0 5px);
  cursor: pointer;
  transition: background 0.15s ease, box-shadow 0.15s ease;
}

.hud-btn-collapse::after {
  display: none;
}

.hud-btn-collapse:hover {
  background: var(--panel-bg-hover);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.hud-btn-collapse.active {
  background: rgba(var(--accent-rgb), 0.25);
}

/* Recolhido: esconde o corpo via CSS (não desmonta — a câmera/refs continuam vivos) */
.hud-controls.collapsed .camera-panel,
.hud-controls.collapsed .hud-error,
.hud-controls.collapsed .hud-row {
  display: none;
}

/* ═══════════════════════════════════════════
   Editor universal: ações na árvore
   ═══════════════════════════════════════════ */
.editor-tree-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-tree-actions {
  display: inline-flex;
  gap: 4px;
}

.editor-node {
  display: flex;
  align-items: center;
}

.editor-node-btn {
  flex: 1;
  min-width: 0;
}

.editor-node-actions {
  display: inline-flex;
  gap: 2px;
  opacity: 0;
  transition: opacity 0.12s ease;
  padding-right: 4px;
}

.editor-node:hover .editor-node-actions,
.editor-node:focus-within .editor-node-actions {
  opacity: 1;
}

.editor-node-act {
  background: transparent;
  border: 1px solid transparent;
  color: var(--accent);
  border-radius: 3px;
  width: 20px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  cursor: pointer;
  padding: 0;
}

.editor-node-act:hover {
  background: var(--panel-bg-hover);
  border-color: rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.editor-node-act-danger:hover {
  color: #ff6b5e;
  border-color: rgba(255, 90, 70, 0.5);
}

.editor-node-renaming .editor-node-btn {
  opacity: 0.5;
}

.editor-rename-row,
.editor-new-form {
  gap: 4px;
  padding: 4px 8px;
}

/* ═══════════════════════════════════════════
   Editor universal de Office
   ═══════════════════════════════════════════ */
.office-editor {
  flex: 1;
  min-width: 0;
  min-height: 0;
  overflow-y: auto;
  padding: 12px;
  scrollbar-width: thin;
}

.office-file-title {
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 0.12em;
  color: var(--accent);
  padding: 6px 2px 12px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.25);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.office-empty {
  padding: 24px 12px;
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 12px;
  letter-spacing: 0.08em;
}

/* ——— Blocos do Word ——— */
.office-block {
  margin-bottom: 10px;
  border: 1px solid rgba(var(--accent-rgb), 0.22);
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.25);
}

.office-block-titulo {
  border-left: 3px solid var(--accent);
}

.office-block-destaque {
  border-left: 3px solid var(--accent-bright);
}

.office-block-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.15);
}

.office-block-spacer {
  flex: 1;
}

.office-select {
  background: rgba(0, 0, 0, 0.6);
  color: var(--accent);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  font-family: "Courier New", monospace;
  font-size: 10px;
  padding: 3px 6px;
  outline: none;
}

.office-select-sm {
  font-size: 9px;
}

.office-tool {
  background: transparent;
  border: 1px solid transparent;
  color: var(--accent);
  border-radius: 3px;
  width: 24px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 13px;
}

.office-tool:hover {
  background: var(--panel-bg-hover);
  border-color: rgba(var(--accent-rgb), 0.4);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.office-tool.active {
  background: var(--panel-bg-active);
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.4);
}

.office-tool-danger:hover {
  color: #ff6b5e;
  border-color: rgba(255, 90, 70, 0.5);
}

.office-textarea {
  width: 100%;
  background: rgba(0, 0, 0, 0.4);
  color: #e8e8e8;
  font-family: "Courier New", monospace;
  font-size: 12px;
  line-height: 1.5;
  padding: 8px 10px;
  resize: vertical;
  outline: none;
  min-height: 38px;
}

.office-textarea:focus {
  box-shadow: 0 0 10px rgba(var(--glow-rgb), 0.25);
}

.office-add-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px 2px;
}

.office-add {
  font-size: 10px;
  padding: 5px 10px;
}

/* ——— Grade do Excel ——— */
.office-excel-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.office-sheet-name {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 9px;
  letter-spacing: 0.15em;
  color: var(--accent);
}

.office-input {
  background: rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  color: #e8e8e8;
  font-family: "Courier New", monospace;
  font-size: 12px;
  padding: 4px 8px;
  outline: none;
}

.office-input:focus {
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.3);
}

.office-grid-wrap {
  overflow: auto;
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  border-radius: 4px;
  max-height: 46vh;
}

.office-grid {
  border-collapse: collapse;
  width: max-content;
  min-width: 100%;
}

.office-grid th,
.office-grid td {
  border: 1px solid rgba(var(--accent-rgb), 0.18);
  padding: 0;
}

.office-grid-head {
  background: rgba(var(--accent-rgb), 0.16);
  color: var(--accent);
  font-weight: bold;
  font-size: 11px;
  min-width: 110px;
  padding: 5px 8px;
  border: none;
  outline: none;
  font-family: "Courier New", monospace;
}

.office-grid-cell {
  background: transparent;
  color: #e8e8e8;
  font-family: "Courier New", monospace;
  font-size: 12px;
  min-width: 110px;
  padding: 5px 8px;
  border: none;
  outline: none;
}

.office-grid tr:nth-child(even) .office-grid-cell {
  background: rgba(255, 255, 255, 0.04);
}

.office-grid-head:focus,
.office-grid-cell:focus {
  box-shadow: 0 0 0 1px var(--accent) inset;
}

/* ——— Slides do PowerPoint ——— */
.office-slide {
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.25);
  margin-bottom: 12px;
  padding: 8px;
}

.office-slide-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
}

.office-slide-num {
  font-size: 9px;
  font-weight: bold;
  letter-spacing: 0.2em;
  color: var(--accent);
}

.office-slide-title {
  width: 100%;
  font-size: 15px;
  font-weight: bold;
  color: var(--accent);
  margin-bottom: 8px;
  border-color: rgba(var(--accent-rgb), 0.35);
}

/* ═══════════════════════════════════════════
   Terminal do ARES
   ═══════════════════════════════════════════ */
.terminal-panel.win-window {
  background: rgba(4, 8, 12, 0.82);
  backdrop-filter: blur(6px);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--glow-rgb), 0.16);
}

.terminal-tools {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
  background: rgba(0, 0, 0, 0.35);
}

.terminal-shell-label {
  font-family: "Courier New", monospace;
  font-size: 10px;
  color: rgba(255, 255, 255, 0.65);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  text-align: right;
}

.terminal-out {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 10px 12px;
  font-family: "Courier New", monospace;
  font-size: 12px;
  line-height: 1.55;
  scrollbar-width: thin;
  background: rgba(0, 0, 0, 0.35);
}

.terminal-empty {
  color: rgba(255, 255, 255, 0.45);
  font-style: italic;
  font-size: 11px;
  padding: 4px 0;
}

.terminal-line {
  display: flex;
  gap: 8px;
  align-items: baseline;
  margin-bottom: 3px;
  white-space: pre-wrap;
  word-break: break-word;
}

.terminal-line-prompt {
  color: var(--accent);
  font-weight: bold;
  flex-shrink: 0;
  user-select: none;
}

.terminal-line-text {
  margin: 0;
  font-family: inherit;
  font-size: inherit;
  white-space: pre-wrap;
  word-break: break-word;
  color: #d6e2ea;
}

.terminal-line.out .terminal-line-text {
  color: #b8c4cc;
}

.terminal-form {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  padding-right: 30px; /* deixa espaço para o canto de redimensionar */
  border-top: 1px solid rgba(var(--accent-rgb), 0.2);
  background: rgba(0, 0, 0, 0.45);
}

.terminal-form-prompt {
  color: var(--accent);
  font-family: "Courier New", monospace;
  font-size: 12px;
  font-weight: bold;
  white-space: nowrap;
  user-select: none;
}

.terminal-input {
  flex: 1;
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.4);
  color: #e8f4ff;
  font-family: "Courier New", monospace;
  font-size: 12px;
  padding: 4px 2px;
  outline: none;
}

.terminal-input:focus {
  border-bottom-color: var(--accent);
  box-shadow: 0 2px 8px -2px rgba(var(--glow-rgb), 0.4);
}

.terminal-input:disabled {
  opacity: 0.55;
}

@media (max-width: 720px) {
  .office-grid-wrap {
    max-height: 34vh;
  }
}

/* ═══════════════════════════════════════════
   Visualizador de imagens (show_image)
   ═══════════════════════════════════════════ */
.image-panel {
  position: fixed;
  top: 10%;
  left: 50%;
  transform: translateX(-50%);
  width: min(720px, calc(100vw - 24px));
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  border-radius: 6px;
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  background: var(--panel-bg-solid);
  backdrop-filter: blur(14px) saturate(1.15);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--glow-rgb), 0.2);
  z-index: 120;
  overflow: hidden;
  animation: image-in 0.22s ease-out;
}

@keyframes image-in {
  from {
    opacity: 0;
    transform: translateX(-50%) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
}

.image-view-body {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  padding: 12px;
  overflow: auto;
}

.image-view-img {
  max-width: 100%;
  max-height: 62vh;
  object-fit: contain;
  border-radius: 3px;
  box-shadow: 0 0 24px rgba(var(--glow-rgb), 0.15);
  background: rgba(255, 255, 255, 0.04);
}

.image-view-err {
  padding: 10px 12px;
  font-size: 12px;
  color: #ffb4a8;
  border: 1px dashed rgba(255, 90, 60, 0.5);
  border-radius: 4px;
  margin: 8px 12px;
}

.image-view-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  letter-spacing: 0.3em;
  color: var(--accent);
  background: rgba(0, 0, 0, 0.55);
  animation: blink 1.1s ease-in-out infinite;
}

.image-view-actions {
  display: flex;
  gap: 8px;
  padding: 10px 12px;
  border-top: 1px solid rgba(var(--accent-rgb), 0.2);
  background: rgba(0, 0, 0, 0.35);
}

@keyframes blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

/* ——— MODEL LAB: editor 3D do HUD ——— */
.model3d-window.win-window {
  position: fixed;
  top: 110px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 27;
  width: min(840px, calc(100vw - 32px));
  height: min(620px, calc(100vh - 150px));
  display: flex;
  flex-direction: column;
  background: var(--panel-bg-solid);
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 4px;
  backdrop-filter: blur(3px);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), 0 0 22px rgba(var(--glow-rgb), 0.18);
}
.model3d-window .model3d-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.model3d-window .model3d-canvas {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
  background: #070b12;
  border-top: 1px solid rgba(var(--accent-rgb), 0.18);
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.18);
}
.model3d-window .model3d-canvas canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
}
.model3d-toolbar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  flex-wrap: wrap;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.18);
}
.model3d-modes {
  display: flex;
  gap: 3px;
}
.model3d-mode,
.model3d-toggle,
.model3d-export,
.model3d-load button,
.model3d-file {
  background: rgba(var(--accent-rgb), 0.08);
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  color: var(--text-primary, #e8f1f8);
  border-radius: 3px;
  padding: 4px 8px;
  font-size: 11px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: background 0.15s, border-color 0.15s;
}
.model3d-mode:hover,
.model3d-toggle:hover,
.model3d-export:hover,
.model3d-load button:hover,
.model3d-file:hover {
  background: rgba(var(--accent-rgb), 0.18);
}
.model3d-mode.active,
.model3d-toggle.active {
  background: rgba(var(--accent-rgb), 0.32);
  border-color: rgba(var(--accent-rgb), 0.7);
}
.model3d-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: var(--text-secondary, #9fb3c4);
}
.model3d-chip input[type="color"] {
  width: 26px;
  height: 20px;
  padding: 0;
  border: 1px solid rgba(var(--accent-rgb), 0.4);
  border-radius: 3px;
  background: transparent;
  cursor: pointer;
}
.model3d-chip select {
  background: #0c1218;
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  color: var(--text-primary, #e8f1f8);
  border-radius: 3px;
  font-size: 11px;
  padding: 3px 4px;
}
.model3d-export {
  margin-left: auto;
  background: rgba(var(--accent-rgb), 0.14);
  border-color: rgba(var(--accent-rgb), 0.45);
}
.model3d-load {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  color: var(--text-secondary, #9fb3c4);
  font-size: 11px;
}
.model3d-load input[type="text"] {
  flex: 1;
  background: #0c1218;
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  color: var(--text-primary, #e8f1f8);
  border-radius: 3px;
  padding: 5px 8px;
  font-size: 11px;
}
.model3d-file {
  cursor: pointer;
}
.model3d-file input[type="file"] {
  display: none;
}
.model3d-sliders {
  display: flex;
  gap: 12px;
  padding: 6px 10px;
  flex-wrap: wrap;
  border-top: 1px solid rgba(var(--accent-rgb), 0.12);
}
.model3d-sliders label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 9.5px;
  letter-spacing: 0.6px;
  color: var(--text-secondary, #9fb3c4);
  white-space: nowrap;
}
.model3d-sliders input[type="range"] {
  width: 88px;
  accent-color: var(--accent-hex, #00bcd4);
}
.model3d-sliders span {
  min-width: 34px;
  text-align: right;
  font-size: 10px;
  color: var(--text-primary, #e8f1f8);
}
.model3d-msg {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  font-size: 11px;
  color: var(--text-secondary, #9fb3c4);
  border-top: 1px solid rgba(var(--accent-rgb), 0.12);
  min-height: 28px;
}
.model3d-msg i {
  color: rgba(var(--accent-rgb), 0.9);
}
.model3d-tools {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 10px;
  flex-wrap: wrap;
  border-top: 1px solid rgba(var(--accent-rgb), 0.12);
  background: rgba(var(--accent-rgb), 0.05);
}
.model3d-tools input[type="range"] {
  width: 110px;
  accent-color: var(--accent-hex, #00bcd4);
}
.model3d-tools select {
  background: #0c1218;
  border: 1px solid rgba(var(--accent-rgb), 0.25);
  color: var(--text-primary, #e8f1f8);
  border-radius: 3px;
  font-size: 11px;
  padding: 3px 4px;
}
.model3d-tools .model3d-toggle {
  background: rgba(var(--accent-rgb), 0.08);
}
.model3d-bones {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 10px;
  align-items: center;
}
.model3d-bones label {
  display: flex;
  align-items: center;
  gap: 4px;
}
.model3d-bones input[type="range"] {
  width: 64px;
  accent-color: var(--accent-hex, #00bcd4);
}
/* ——— Scrollbars do tema: finas, brancas com brilho (todos os contêineres) ——— */
* {
  scrollbar-width: thin;
  scrollbar-color: rgba(var(--accent-rgb), 0.35) rgba(var(--accent-rgb), 0.06);
}
*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
*::-webkit-scrollbar-track {
  background: rgba(var(--accent-rgb), 0.05);
  border-radius: 8px;
}
*::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.55), rgba(var(--accent-rgb), 0.25));
  border-radius: 8px;
  border: 2px solid rgba(4, 7, 12, 0.45);
}
*::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.9), rgba(var(--accent-rgb), 0.5));
  box-shadow: 0 0 8px rgba(var(--glow-rgb), 0.7);
}
*::-webkit-scrollbar-corner {
  background: transparent;
}

/* ——— Cursor do tema: anel de HUD branco no lugar do ponteiro padrão ——— */
* {
  cursor: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'><circle cx='12' cy='12' r='9' fill='none' stroke='%23eaf6fc' stroke-width='1.6' opacity='0.9'/><circle cx='12' cy='12' r='2.2' fill='%23eaf6fc'/></svg>") 12 12, auto !important;
}
/* Interativos: anel com ponto cheio (indica clique) */
a,
button,
[role="button"],
label,
select,
summary,
input[type="checkbox"],
input[type="radio"],
input[type="range"],
.hud-btn,
.win-btn,
.win-toolbar button {
  cursor: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'><circle cx='12' cy='12' r='9' fill='none' stroke='%23eaf6fc' stroke-width='1.6' opacity='0.9'/><circle cx='12' cy='12' r='4.2' fill='%23eaf6fc'/></svg>") 12 12, pointer !important;
}
/* Campos de texto mantêm o I-beam (prático para editar) */
input[type="text"],
input[type="search"],
input[type="email"],
input[type="password"],
input[type="number"],
input[type="date"],
input[type="time"],
textarea,
[contenteditable="true"] {
  cursor: text !important;
}
/* Orbe arrastável mantém o "grab" do drag */
.orb-root,
.orb-root * {
  cursor: grab !important;
}
.orb-root:active {
  cursor: grabbing !important;
}
