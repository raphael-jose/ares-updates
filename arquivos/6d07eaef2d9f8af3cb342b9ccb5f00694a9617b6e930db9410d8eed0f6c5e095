  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 0;
  margin: 0;
}

.whatsapp-chat {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  text-align: left;
  background: rgba(var(--accent-rgb), 0.06);
  border: 1px solid rgba(var(--accent-rgb), 0.16);
  border-radius: 4px;
  color: var(--text);
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}

.whatsapp-chat:hover {
  background: rgba(var(--accent-rgb), 0.14);
  border-color: rgba(var(--accent-rgb), 0.4);
}

.whatsapp-chat-icon {
  font-size: 20px;
  color: var(--accent);
  flex-shrink: 0;
}

.whatsapp-chat-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.whatsapp-chat-name {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.whatsapp-chat-last {
  font-size: 12px;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 280px;
}

.whatsapp-empty {
  font-size: 12px;
  color: var(--text-dim);
  text-align: center;
  padding: 14px 0;
}

.whatsapp-thread {
  display: flex;
  flex-direction: column;
  gap: 8px;
  height: 100%;
  min-height: 0;
}

.whatsapp-thread-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.18);
}

.whatsapp-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  font-size: 15px;
  color: var(--accent);
  background: rgba(var(--accent-rgb), 0.1);
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 4px;
  cursor: pointer;
}

.whatsapp-back:hover {
  background: rgba(var(--accent-rgb), 0.2);
}

.whatsapp-thread-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--accent);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.whatsapp-msgs {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 4px 2px;
  scrollbar-width: thin;
}

.whatsapp-msg {
  max-width: 82%;
  align-self: flex-start;
  padding: 7px 10px;
  background: rgba(var(--accent-rgb), 0.08);
  border: 1px solid rgba(var(--accent-rgb), 0.2);
  border-radius: 4px 8px 8px 8px;
  font-size: 13px;
  line-height: 1.4;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.whatsapp-msg.mine {
  align-self: flex-end;
  background: rgba(var(--accent-rgb), 0.2);
  border-radius: 8px 4px 8px 8px;
}

.whatsapp-msg-time {
  font-size: 10px;
  color: var(--text-dim);
  text-align: right;
}

.whatsapp-form {
  display: flex;
  gap: 8px;
  border-top: 1px solid rgba(var(--accent-rgb), 0.18);
  padding-top: 10px;
}

.whatsapp-input {
  flex: 1;
  padding: 9px 11px;
  font-size: 13px;
  color: var(--text);
  background: rgba(var(--accent-rgb), 0.06);
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 4px;
  outline: none;
}

.whatsapp-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(var(--accent-rgb), 0.18);
}

.whatsapp-send {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  font-size: 15px;
  color: #041018;
  background: var(--accent);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s;
}

.whatsapp-send:hover:not(:disabled) {
  transform: translateY(-1px);
}

.whatsapp-send:disabled {
  opacity: 0.4;
  cursor: default;
}

/* ——— Janela REGISTRO DE AÇÕES (tabela de falhas das ferramentas) ——— */
.erros-panel.win-window {
