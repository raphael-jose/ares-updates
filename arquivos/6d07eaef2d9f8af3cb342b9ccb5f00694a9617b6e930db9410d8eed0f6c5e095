}

.erros-dev-info {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 8px;
  font-size: 11px;
  color: var(--text-dim);
  opacity: 0.85;
}

.erros-dev-info.off {
  margin: 10px 12px;
  padding: 8px 10px;
  border: 1px dashed rgba(var(--accent-rgb), 0.3);
  border-radius: 6px;
}

.erros-body {
  flex: 0 0 auto;
  min-height: 120px;
  overflow-y: auto;
  padding: 8px 12px 12px;
  scrollbar-width: thin;
}

.erros-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 40px 12px;
  text-align: center;
  font-size: 13px;
  color: var(--text-dim);
}

.erros-empty i {
  font-size: 34px;
  color: var(--accent);
  opacity: 0.8;
}

.erros-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.erros-table th {
  position: sticky;
  top: 0;
  text-align: left;
  padding: 7px 8px;
  font-size: 10px;
  letter-spacing: 0.12em;
