import { NextResponse } from "next/server";
import { estadoAtualizacao, verificarAgora } from "@/lib/atualizador";

export const runtime = "nodejs";

/**
 * Atualizações automáticas.
 *   GET  /api/updates → estado atual (o cliente polla e a IA fala)
 *   POST /api/updates → força uma verificação agora
 */
export async function GET() {
  return NextResponse.json(estadoAtualizacao());
}

export async function POST() {
  const st = await verificarAgora();
  return NextResponse.json(st);
}
