/** Previsão do tempo (Open-Meteo, sem chave). Hermes: cache de 10 min. */
export const toolWeather = cachedTool("weather", 10 * 60 * 1000, toolWeatherImpl);

async function toolWeatherImpl(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const cidade = (args.cidade ?? args.local ?? args.lugar ?? "").trim();
  if (!cidade) return { ok: false, message: "Diga para qual cidade quer a previsão do tempo." };
  try {
    const geo = (await apiFetchJson(
      `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(cidade)}&count=1&language=pt&format=json`,
    )) as Record<string, unknown>;
    const results = (geo.results as Array<Record<string, unknown>> | undefined) ?? [];
    const hit = results[0];
    if (!hit) return { ok: false, message: `Não encontrei a cidade ${cidade}.` };
    const f = (await apiFetchJson(
      `https://api.open-meteo.com/v1/forecast?latitude=${hit.latitude}&longitude=${hit.longitude}&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto&forecast_days=3`,
    )) as Record<string, unknown>;
    const cur = (f.current ?? {}) as Record<string, number>;
    const daily = (f.daily ?? {}) as Record<string, unknown[]>;
    const nome = (hit.name as string) ?? cidade;
    const cond = WMO_CODES[Math.round(cur.weather_code ?? 0)] ?? "condição indefinida";
    const agora = `Agora em ${nome}: ${cond}, ${Math.round(cur.temperature_2m ?? 0)}°C (sensação ${Math.round(cur.apparent_temperature ?? 0)}°C), umidade ${Math.round(cur.relative_humidity_2m ?? 0)}% e vento de ${Math.round(cur.wind_speed_10m ?? 0)} km/h.`;
    const times = (daily.time ?? []) as string[];
    const dias = times
      .map((t, i) => {
        const dia = t.slice(5).split("-").reverse().join("/");
        const min = Math.round((daily.temperature_2m_min?.[i] as number) ?? 0);
        const max = Math.round((daily.temperature_2m_max?.[i] as number) ?? 0);
        const chuva = daily.precipitation_probability_max?.[i];
        return `${dia}: mín ${min}°, máx ${max}°${chuva != null ? `, ${Math.round(chuva as number)}% de chuva` : ""}`;
      })
      .join(". ");
    return { ok: true, message: `${agora} ${dias}.` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui buscar o tempo: ${msg}` };
  }
}

