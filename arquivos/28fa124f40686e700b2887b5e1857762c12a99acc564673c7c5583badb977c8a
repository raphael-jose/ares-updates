/** Converte medidas: comprimento, massa, volume, velocidade, tempo, dados e temperatura. */
export async function toolConvertUnits(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const rawValor = (args.valor ?? args.amount ?? "1").trim();
  const de = (args.de ?? args.from ?? "").trim();
  const para = (args.para ?? args.to ?? "").trim();
  if (!de || !para) {
    return { ok: false, message: "Informe as unidades, por exemplo: 5 quilômetros em metros." };
  }
  const parsed = rawValor
    .replace(/\s+/g, "")
    .replace(/[.](?=\d{3}(?:[.,]|$))/g, "") // 1.000 → 1000
    .replace(",", ".");
  const valor = parseFloat(parsed);
  if (!Number.isFinite(valor) || valor < 0) {
    return { ok: false, message: `Não entendi o valor "${rawValor}".` };
  }
  const res = convertUnit(valor, de, para);
  if (!res) {
    const kindDe = unitKindLabel(de);
    const kindPara = unitKindLabel(para);
    if (kindDe && kindPara && kindDe !== kindPara) {
      return {
        ok: false,
        message: `${de} é medida de ${kindDe} e ${para} é de ${kindPara} — não dá para converter.`,
      };
    }
    return { ok: false, message: `Não reconheci a unidade "${de}" ou "${para}".` };
  }
  const fmt = (n: number) =>
    n.toLocaleString("pt-BR", {
      maximumFractionDigits: Math.abs(n) >= 10000 ? 0 : Math.abs(n) >= 10 ? 2 : 4,
    });
  return { ok: true, message: `${fmt(valor)} ${de} equivalem a ${fmt(res.result)} ${res.unidade}.` };
}

