async function toolCurrencyImpl(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const valorRaw = (args.valor ?? args.amount ?? "1").replace(/[^\d.,]/g, "").replace(",", ".");
  const valor = parseFloat(valorRaw);
  const de = normKey(args.de ?? args.from ?? "USD");
  const para = normKey(args.para ?? args.to ?? "BRL");
  if (!Number.isFinite(valor) || valor <= 0 || !de || !para) {
    return { ok: false, message: "Informe a quantia e as moedas, por exemplo: 100 dólares em reais." };
  }
  const deCode = (MOEDA_ALIASES[de] ?? de.toUpperCase()).replace(/\s+/g, "");
  const paraCode = (MOEDA_ALIASES[para] ?? para.toUpperCase()).replace(/\s+/g, "");
  try {
    const data = (await apiFetchJson("https://open.er-api.com/v6/latest/USD")) as Record<string, unknown>;
    const rates = (data.rates ?? {}) as Record<string, number>;
    const rDe = deCode === "USD" ? 1 : rates[deCode];
    const rPara = paraCode === "USD" ? 1 : rates[paraCode];
    if (!rDe || !rPara) {
      return { ok: false, message: `Não conheço a moeda "${de}" ou "${para}".` };
    }
    const total = (valor / rDe) * rPara;
    const fmt = (n: number) =>
      n.toLocaleString("pt-BR", { maximumFractionDigits: n < 1000 ? 2 : 0 });
    return { ok: true, message: `${fmt(valor)} ${de} equivale a ${fmt(total)} ${para}.` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui converter: ${msg}` };
  }
}

/** Cotação de criptomoedas (CoinGecko, sem chave). Hermes: cache de 2 min. */
export const toolCrypto = cachedTool("crypto", 2 * 60 * 1000, toolCryptoImpl);

async function toolCryptoImpl(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const nome = normKey(args.cripto ?? args.moeda ?? args.nome ?? "bitcoin");
  const id = CRYPTO_IDS[nome] ?? nome.replace(/[^a-z0-9]/g, "");
  if (!id) return { ok: false, message: "Diga qual criptomoeda você quer saber a cotação." };
  try {
    const data = (await apiFetchJson(
      `https://api.coingecko.com/api/v3/simple/price?ids=${encodeURIComponent(id)}&vs_currencies=brl,usd`,
    )) as Record<string, unknown>;
    const coin = (data[id] ?? {}) as Record<string, number>;
    if (coin.brl == null) return { ok: false, message: `Não encontrei a criptomoeda ${nome}.` };
    const label = nome.charAt(0).toUpperCase() + nome.slice(1);
    return {
      ok: true,
      message: `${label} hoje: R$ ${coin.brl.toLocaleString("pt-BR", { maximumFractionDigits: 2 })} (US$ ${coin.usd.toLocaleString("en-US", { maximumFractionDigits: 2 })}).`,
    };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui buscar a cotação: ${msg}` };
  }
}

/** Informações de países (REST Countries, sem chave). */
// Nomes em português → inglês (países cuja grafia difere da busca por acento)
const PAIS_ALIASES: Record<string, string> = {
  brasil: "Brazil",
  alemanha: "Germany",
  inglaterra: "United Kingdom",
  "reino unido": "United Kingdom",
  eua: "United States",
  "estados unidos": "United States",
  japao: "Japan",
  franca: "France",
  espanha: "Spain",
  italia: "Italy",
  portugal: "Portugal",
  coreia: "South Korea",
  "coreia do sul": "South Korea",
  holanda: "Netherlands",
  "paises baixos": "Netherlands",
  suica: "Switzerland",
  "nova zelandia": "New Zealand",
  "africa do sul": "South Africa",
  argentina: "Argentina",
  mexico: "Mexico",
};

type CountryEntry = { name: string; iso2: string; iso3: string };
let countriesCache: CountryEntry[] | null = null;
let countriesCacheAt = 0;

async function findCountryApiName(term: string): Promise<string | null> {
  const key = normKey(term);
  if (PAIS_ALIASES[key]) return PAIS_ALIASES[key];

  const now = Date.now();
  if (!countriesCache || now - countriesCacheAt > 6 * 3600 * 1000) {
    const data = (await apiFetchJson("https://countriesnow.space/api/v0.1/countries")) as {
      data?: CountryEntry[];
    };
    countriesCache = (data.data ?? []).slice(0, 500);
    countriesCacheAt = now;
  }
  const list = countriesCache ?? [];
  const exact = list.find((c) => normKey(c.name) === key);
  if (exact) return exact.name;
  if (key.length >= 4) {
    const partial = list.find((c) => normKey(c.name).includes(key));
    if (partial) return partial.name;
  }
  return null;
}

/** Informações de um país (countriesnow.space, sem chave). */
export async function toolCountry(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const nome = (args.pais ?? args.nome ?? "").trim();
  if (!nome) return { ok: false, message: "Diga qual país você quer saber." };
  try {
    const apiName = await findCountryApiName(nome);
    if (!apiName) return { ok: false, message: `Não encontrei o país ${nome}.` };

    const post = (target: string) =>
      apiFetchJson(
        `https://countriesnow.space/api/v0.1/countries/${target}`,
        15000,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ country: apiName }),
        },
      ) as Promise<{ data?: Record<string, unknown> }>;

    const [capital, pop, moeda] = await Promise.all([
      post("capital"),
      post("population"),
      post("currency"),
    ]);

    const cap = (capital.data?.capital as string) ?? "—";
    const popCounts = (pop.data?.populationCounts as Array<{ year: number; value: number }>) ?? [];
    const populacao = popCounts.length
      ? `${popCounts[popCounts.length - 1].value.toLocaleString("pt-BR")} hab.`
      : "—";
    const moeadas = moeda.data?.currency as string | undefined;
    const simbolo = moeda.data?.symbol as string | undefined;
    const moedaTxt = moeadas ? `${moeadas}${simbolo ? ` (${simbolo})` : ""}` : "—";

    return {
      ok: true,
      message: `${apiName}: capital ${cap}, população ${populacao} e moeda ${moedaTxt}.`,
    };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui buscar o país: ${msg}` };
  }
}

/** Piada aleatória em português (JokeAPI, sem chave). */
export async function toolJoke(): Promise<{ ok: boolean; message: string }> {
  try {
    const data = (await apiFetchJson("https://v2.jokeapi.dev/joke/Any?lang=pt&format=json")) as Record<string, unknown>;
    if (data.type === "single" && data.joke) return { ok: true, message: String(data.joke) };
    if (data.type === "twopart" && data.setup && data.delivery) {
      return { ok: true, message: `${String(data.setup)} ... ${String(data.delivery)}` };
    }
    return { ok: false, message: "Não consegui buscar uma piada agora." };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui buscar uma piada: ${msg}` };
  }
}

