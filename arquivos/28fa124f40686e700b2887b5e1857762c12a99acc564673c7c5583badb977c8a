export async function executeTool(call: ToolCall): Promise<{ ok: boolean; message: string }> {
  const impl = TOOL_IMPLS[call.tool];
  if (!impl) return { ok: false, message: "Ferramenta desconhecida." };
  try {
    const res = await impl(call.args);
    return res;
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui: ${msg}` };
  }
}

/** Descreve a ação de forma curta para o painel de log do HUD. */
export function describeLogText(call: ToolCall, ok: boolean, message: string): string {
  const firstLine = message.split("\n")[0].trim();
  if (!ok) return firstLine || "Falha na ação.";
  return firstLine || "Ação executada.";
}

