export async function toolCreateProject(args: Record<string, string>): Promise<{ ok: true; message: string }> {
  const name = (args.nome ?? args.name ?? "meu-projeto").trim();
  const base = resolveProjectPath(args.em ?? args.local ?? "projetos");
  const root = path.join(base, name);
  await fs.mkdir(root, { recursive: true });

  const files = (args.arquivos ?? args.files ?? "README.md,index.html")
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean);

  for (const f of files) {
    const p = path.join(root, f);
    await fs.mkdir(path.dirname(p), { recursive: true });
    const ext = path.extname(f).toLowerCase();
    let content = "";
    if (f === "README.md") content = `# ${name}\n\nProjeto criado pelo ARES.\n`;
    else if (ext === ".json" && f === "package.json")
      content = `{\n  "name": "${name.toLowerCase()}",\n  "version": "1.0.0",\n  "private": true\n}\n`;
    else if (ext === ".html")
      content = `<!doctype html>\n<html lang="pt-BR">\n<head><meta charset="utf-8"><title>${name}</title></head>\n<body><h1>${name}</h1></body>\n</html>\n`;
    await fs.writeFile(p, content, "utf8");
  }

  return { ok: true, message: `Projeto criado em ${root} com ${files.length} arquivo${files.length === 1 ? "" : "s"}` };
}

export async function toolListFolder(args: Record<string, string>): Promise<{ ok: true; message: string }> {
  const p = resolveProjectPath(args.path ?? args.local ?? args.pasta ?? "");
