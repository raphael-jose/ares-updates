/** Lê o conteúdo de um arquivo com números de linha (limitado às primeiras linhas). */
export async function toolReadFile(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const raw = (args.path ?? args.arquivo ?? args.file ?? "").trim();
  if (!raw) return { ok: false, message: "Diga qual arquivo devo ler." };
  const p = resolveProjectPath(raw);
  try {
    const content = await fs.readFile(p, "utf8");
    const lines = content.split(/\r?\n/);
    // Faixa opcional: linhas="40-80" (ou "5", "40-", "10-5" invertido) mostra só o trecho
    let start = 1;
    let end = lines.length;
    const rangeRaw = (args.linhas ?? args.range ?? "").trim();
    if (rangeRaw) {
      const m = rangeRaw.match(/^(\d+)\s*(?:-\s*(\d+)?)?$/);
      if (m) {
        const a = Math.max(1, Number(m[1]));
        const hasEnd = rangeRaw.includes("-") && m[2] !== undefined;
        const b = hasEnd ? Number(m[2]) : Math.min(lines.length, a + 120 - 1);
        if (a > b) {
          // Faixa invertida ("10-5") → mostra 5-10 em vez de nada
          start = b;
          end = a;
        } else {
          start = a;
          end = b;
        }
      }
    }
    const MAX = 120;
    const shown = lines.slice(start - 1, Math.min(end, start - 1 + MAX));
    const numbered = shown.map((l, i) => `${String(start + i).padStart(4, " ")} │ ${l}`).join("\n");
    const total = lines.length;
    const hidden = Math.max(0, total - (start - 1 + shown.length));
    const tail = hidden > 0 ? `\n… (${hidden} linha${hidden === 1 ? "" : "s"} não mostradas — use linhas=\"${start + shown.length}-\" para ver mais)` : "";
    return { ok: true, message: `${p} — ${total} linha${total === 1 ? "" : "s"}\n${numbered}${tail}` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui ler ${p}: ${msg}` };
  }
}

/**
 * Edita um arquivo substituindo um trecho EXATO por outro (patch por texto).
 * Contrato: 'de' deve casar byte a byte com o conteúdo (espaços/acentos contam).
 */
export async function toolEditFile(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const raw = (args.path ?? args.arquivo ?? args.file ?? "").trim();
  const de = args.de ?? args.buscar ?? "";
  const para = args.para ?? args.substituir ?? "";
  if (!raw) return { ok: false, message: "Informe o arquivo a editar (path)." };
  if (!de) return { ok: false, message: "Informe o trecho a substituir (de)." };
  const p = resolveProjectPath(raw);
  try {
    const content = await fs.readFile(p, "utf8");
    const all = /^(true|sim|todas|todos|1)$/i.test((args.todas ?? args.all ?? "").trim());
    const idx = content.indexOf(de);
    if (idx < 0) {
      // Ajuda o modelo a corrigir: mostra a linha com mais palavras em comum
      // com o trecho procurado (funciona até para termos curtos).
      const words = de
        .trim()
        .split(/\s+/)
        .filter((w) => /[a-zA-Z0-9À-ÿ]/.test(w));
      const li = content.split(/\r?\n/);
      let best = -1;
      let bestScore = 0;
      li.forEach((l, i) => {
        const score = words.reduce((s, w) => s + (l.includes(w) ? 1 : 0), 0);
        if (score > bestScore) {
          bestScore = score;
          best = i;
        }
      });
      const hint =
        best >= 0 && bestScore > 0
          ? ` A linha mais próxima é a ${best + 1}: "${li[best].slice(0, 80)}".`
          : "";
      return {
        ok: false,
        message: `Não encontrei o trecho exato em ${p}. Confira espaçamento e acentos.${hint}`,
      };
    }
    let next: string;
    let count = 0;
    if (all) {
      next = content.split(de).join(para);
      count = content.split(de).length - 1;
    } else {
      next = content.slice(0, idx) + para + content.slice(idx + de.length);
      count = 1;
    }
    await fs.writeFile(p, next, "utf8");
    const beforeLines = content.split(/\r?\n/).length;
    const afterLines = next.split(/\r?\n/).length;
    return {
      ok: true,
      message: `Editei ${p}: ${count} substituiç${count === 1 ? "ão" : "ões"} (antes ${beforeLines} linhas, agora ${afterLines}).`,
    };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui editar ${p}: ${msg}` };
  }
}

/** Captura um print (screenshot) da tela inteira e salva em PNG, abrindo depois. */
export async function toolTakeScreenshot(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, message: "Captura de tela disponível apenas no Windows." };
  }
  const dir = resolvePath(args.salvar ?? args.em ?? args.pasta ?? "imagens");
  await fs.mkdir(dir, { recursive: true });
  const stamp = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
  const file = path.join(dir, `print-ares-${stamp}.png`);

  const script = [
    `Add-Type -AssemblyName System.Windows.Forms`,
    `Add-Type -AssemblyName System.Drawing`,
    `$bounds = [System.Windows.Forms.SystemInformation]::VirtualScreen`,
    `$bmp = New-Object System.Drawing.Bitmap $bounds.Width, $bounds.Height`,
    `$gfx = [System.Drawing.Graphics]::FromImage($bmp)`,
    `$gfx.CopyFromScreen($bounds.X, $bounds.Y, 0, 0, $bmp.Size)`,
    `$bmp.Save('${file.replace(/'/g, "''")}', [System.Drawing.Imaging.ImageFormat]::Png)`,
    `$gfx.Dispose()`,
    `$bmp.Dispose()`,
    `Write-Output 'PRINT_OK'`,
  ].join("\n");

  try {
    const { stdout } = await execAsync(
      `powershell -NoProfile -EncodedCommand ${psEncodedCommand(script)}`,
      { cwd: HOME, timeout: 30000, windowsHide: true },
    );
    if (!(stdout ?? "").includes("PRINT_OK")) {
      return { ok: false, message: "Não consegui capturar a tela." };
    }
    await execAsync(`start "" "${file.replace(/"/g, '\\"')}"`, {
      cwd: HOME,
      timeout: EXEC_TIMEOUT,
    });
    return { ok: true, message: `Print salvo e aberto: ${file}` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui capturar a tela: ${msg}` };
  }
}

// ═══════════════════════════════════════════════
// LEITURA DE TELA (OCR) — screenshot + tesseract.js
// ═══════════════════════════════════════════════
interface OcrWord {
  text: string;
  x: number;
  y: number;
  w: number;
  h: number;
}

let ocrWorkerPromise: Promise<import("tesseract.js").Worker> | null = null;
let lastOcr: {
  words: OcrWord[];
  boundsX: number;
  boundsY: number;
  screenW: number;
  screenH: number;
  at: number;
} | null = null;

async function getOcrWorker(): Promise<import("tesseract.js").Worker> {
  if (!ocrWorkerPromise) {
    ocrWorkerPromise = (async () => {
      try {
        const { createWorker } = await import("tesseract.js");
        // O webpack do Next.js reescreve o __dirname do pacote e o workerPath
        // padrão vira um caminho inexistente (ex.: C:\ROOT\node_modules\…),
        // derrubando o processo com MODULE_NOT_FOUND. Resolve o caminho REAL
        // do worker-script no disco, em runtime, a partir do cwd.
        let workerPath: string | undefined;
        try {
          const p = path.join(
            process.cwd(),
            "node_modules",
            "tesseract.js",
            "src",
            "worker-script",
            "node",
            "index.js",
          );
          await fs.access(p);
          workerPath = p;
        } catch {
          /* usa o default do pacote */
        }
        const worker = await createWorker("por", 1, workerPath ? { workerPath } : undefined);
        return worker;
      } catch (err) {
        // Download do langdata pode falhar (offline/primeira vez): libera a
        // promise para tentar de novo na próxima leitura em vez de travar.
        ocrWorkerPromise = null;
        throw err;
      }
    })();
  }
  return ocrWorkerPromise;
}

/** Hermes: cria o worker de OCR em background para a primeira leitura de tela ser rápida. */
export async function warmOcrInBackground(): Promise<boolean> {
  try {
    await getOcrWorker();
    return true;
  } catch {
    return false;
  }
}

/** Captura a tela inteira num PNG temporário e devolve as dimensões da tela virtual. */
async function captureScreenshotToFile(
  file: string,
): Promise<{ boundsX: number; boundsY: number; w: number; h: number }> {
  const script = [
    `Add-Type -AssemblyName System.Windows.Forms`,
    `Add-Type -AssemblyName System.Drawing`,
    `$bounds = [System.Windows.Forms.SystemInformation]::VirtualScreen`,
    `$bmp = New-Object System.Drawing.Bitmap $bounds.Width, $bounds.Height`,
    `$gfx = [System.Drawing.Graphics]::FromImage($bmp)`,
    `$gfx.CopyFromScreen($bounds.X, $bounds.Y, 0, 0, $bmp.Size)`,
    `$bmp.Save('${file.replace(/'/g, "''")}', [System.Drawing.Imaging.ImageFormat]::Png)`,
    `$gfx.Dispose()`,
    `$bmp.Dispose()`,
    `Write-Output "BOUNDS $($bounds.X) $($bounds.Y) $($bounds.Width) $($bounds.Height)"`,
  ].join("\n");
  const { stdout } = await execAsync(
    `powershell -NoProfile -EncodedCommand ${psEncodedCommand(script)}`,
    { cwd: HOME, timeout: 30000, windowsHide: true },
  );
  const m = (stdout ?? "").match(/BOUNDS (-?\d+) (-?\d+) (\d+) (\d+)/);
  if (!m) throw new Error("captura da tela falhou");
  return { boundsX: Number(m[1]), boundsY: Number(m[2]), w: Number(m[3]), h: Number(m[4]) };
}

/**
 * OCR NATIVO do Windows (Windows.Media.Ocr) via PowerShell — muito mais rápido
 * e preciso para texto de interface que o tesseract.js. Devolve null quando o
 * OCR do Windows não está disponível/falha (o chamador cai no tesseract).
 */
async function ocrWindows(file: string): Promise<{ text: string; words: OcrWord[] } | null> {
  // O Windows.Media.Ocr (StorageFile) NÃO aceita caminho com barras "/" —
  // exige contrabarras (C:\Users\...\arquivo.png). Normaliza sempre.
  const fileWin = file.replace(/\//g, "\\");
  const sep = "\u001F";
  const script = [
    `Add-Type -AssemblyName System.Runtime.WindowsRuntime`,
    `$null = [Windows.Storage.StorageFile, Windows.Storage, ContentType=WindowsRuntime]`,
    `$null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType=WindowsRuntime]`,
    `$null = [Windows.Globalization.Language, Windows.Globalization, ContentType=WindowsRuntime]`,
    `$null = [Windows.Graphics.Imaging.BitmapDecoder, Windows.Graphics, ContentType=WindowsRuntime]`,
    `$asTask = ([System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation\`1' })[0]`,
    `function Await($op, $t) { $m = $asTask.MakeGenericMethod($t); $task = $m.Invoke($null, @($op)); $task.Wait(-1) | Out-Null; $task.Result }`,
    `try {`,
    `  $file = Await ([Windows.Storage.StorageFile]::GetFileFromPathAsync('${fileWin.replace(/'/g, "''")}')) ([Windows.Storage.StorageFile])`,
    `  $stream = Await ($file.OpenAsync([Windows.Storage.FileAccessMode]::Read)) ([Windows.Storage.Streams.IRandomAccessStream])`,
    `  $decoder = Await ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($stream)) ([Windows.Graphics.Imaging.BitmapDecoder])`,
    `  $bitmap = Await ($decoder.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap])`,
    `  $engine = [Windows.Media.Ocr.OcrEngine]::TryCreateFromLanguage([Windows.Globalization.Language]::new('pt-BR'))`,
    `  if (-not $engine) { $engine = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages() }`,
    `  if (-not $engine) { Write-Output 'OCR_SEM_ENGINE'; exit 0 }`,
    `  $result = Await ($engine.RecognizeAsync($bitmap)) ([Windows.Media.Ocr.OcrResult])`,
    `  $out = @()`,
    `  foreach ($line in $result.Lines) {`,
    `    $out += 'L${sep}' + $line.Text`,
    `    foreach ($w in $line.Words) {`,
    `      $r = $w.BoundingRect`,
    `      $out += 'W${sep}' + $w.Text + '${sep}' + [int]$r.X + '${sep}' + [int]$r.Y + '${sep}' + [int]$r.Width + '${sep}' + [int]$r.Height`,
    `    }`,
    `  }`,
    `  Write-Output $out`,
    `  Write-Output 'OCR_OK'`,
    `} catch { Write-Output 'OCR_ERRO' }`,
  ].join("\n");
  try {
    const { stdout } = await execAsync(
      `powershell -NoProfile -EncodedCommand ${psEncodedCommand(script)}`,
      { cwd: HOME, timeout: 30000, windowsHide: true },
    );
    const out = stdout ?? "";
    if (!out.includes("OCR_OK")) return null;
    const words: OcrWord[] = [];
    const linesText: string[] = [];
    for (const raw of out.split(/\r?\n/)) {
      const l = raw.trimEnd();
      if (!l) continue;
      if (l.startsWith(`L${sep}`)) {
        linesText.push(l.slice(2));
      } else if (l.startsWith(`W${sep}`)) {
        const parts = l.split(sep);
        const txt = parts[1] ?? "";
        const w = Number(parts[4] ?? 0);
        const h = Number(parts[5] ?? 0);
        if (txt && w > 1 && h > 1) {
          words.push({ text: txt, x: Number(parts[2] ?? 0), y: Number(parts[3] ?? 0), w, h });
        }
      }
    }
    const text = linesText.join("\n").trim();
    if (!text && words.length === 0) return null;
    return { text, words };
  } catch {
    return null;
  }
}

/** OCR com tesseract.js (fallback quando o OCR do Windows não está disponível). */
async function ocrTesseract(file: string): Promise<{ text: string; words: OcrWord[] }> {
  const worker = await getOcrWorker();
  const { data } = await worker.recognize(file);
  // tesseract.js v7: Page não expõe `words` no topo — percorre a hierarquia
  // blocks → paragraphs → lines → words para coletar cada palavra com bbox.
  const words: OcrWord[] = [];
  for (const block of data.blocks ?? []) {
    for (const paragraph of block.paragraphs ?? []) {
      for (const line of paragraph.lines ?? []) {
        for (const word of line.words ?? []) {
          const text = (word.text ?? "").trim();
          if (!text) continue;
          const w = (word.bbox?.x1 ?? 0) - (word.bbox?.x0 ?? 0);
          const h = (word.bbox?.y1 ?? 0) - (word.bbox?.y0 ?? 0);
          if (w <= 1 || h <= 1) continue; // palavra sem área clicável
          words.push({ text, x: word.bbox?.x0 ?? 0, y: word.bbox?.y0 ?? 0, w, h });
        }
      }
    }
  }
  return { text: (data.text ?? "").trim(), words };
}

/**
 * Lê o texto visível na tela inteira. Usa o OCR NATIVO do Windows
 * (Windows.Media.Ocr, rápido e preciso para interface) e cai para o
 * tesseract.js quando indisponível. Guarda as palavras com posição para o clique.
 */
export async function toolScreenRead(
  _args: Record<string, string>,
): Promise<{ ok: boolean; message: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, message: "Leitura de tela disponível apenas no Windows." };
  }
  const tmp = path.join(os.tmpdir(), `ares-ocr-${crypto.randomBytes(4).toString("hex")}.png`);
  try {
    const meta = await captureScreenshotToFile(tmp);
    // 1) Tenta o OCR nativo do Windows (rápido, sem download de modelo)
    let ocr: { text: string; words: OcrWord[] } | null = null;
    try {
      ocr = await ocrWindows(tmp);
    } catch {
      ocr = null;
    }
    // 2) Fallback: tesseract.js local
    if (!ocr || (ocr.words.length === 0 && !ocr.text)) {
      ocr = await ocrTesseract(tmp).catch(() => null);
    }
    await fs.rm(tmp, { force: true }).catch(() => {});
    if (!ocr) {
      return { ok: false, message: "Não consegui ler a tela (nenhum OCR disponível)." };
    }
    if (ocr.words.length > 0) {
      lastOcr = {
        words: ocr.words,
        boundsX: meta.boundsX,
        boundsY: meta.boundsY,
        screenW: meta.w,
        screenH: meta.h,
        at: Date.now(),
      };
    }
    if (!ocr.text) return { ok: true, message: "Não consegui ler nenhum texto na tela." };
    return { ok: true, message: ocr.text.slice(0, 900) };
  } catch (err) {
    await fs.rm(tmp, { force: true }).catch(() => {});
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui ler a tela: ${msg}` };
  }
}

/**
 * Clique por coordenadas absolutas na tela (opcional duplo clique).
 * Exportado para testes (monta o script PowerShell sem executar).
 */
export function buildClickScript(cx: number, cy: number, duplo: boolean): string {
  const lines = [
    `Add-Type -AssemblyName System.Windows.Forms`,
    `Add-Type -AssemblyName System.Drawing`,
    `Add-Type @"`,
    `using System;`,
    `using System.Runtime.InteropServices;`,
    `public class AresMouse {`,
    `  [DllImport("user32.dll")] public static extern void mouse_event(uint dwFlags, uint dx, uint dy, uint dwData, UIntPtr dwExtraInfo);`,
    `}`,
    `"@`,
    `[System.Windows.Forms.Cursor]::Position = New-Object System.Drawing.Point(${Math.round(cx)}, ${Math.round(cy)})`,
    `Start-Sleep -Milliseconds 60`,
    `[AresMouse]::mouse_event(0x0002, 0, 0, 0, [UIntPtr]::Zero)`,
    `[AresMouse]::mouse_event(0x0004, 0, 0, 0, [UIntPtr]::Zero)`,
  ];
  if (duplo) {
    lines.push(`Start-Sleep -Milliseconds 140`);
    lines.push(`[AresMouse]::mouse_event(0x0002, 0, 0, 0, [UIntPtr]::Zero)`);
    lines.push(`[AresMouse]::mouse_event(0x0004, 0, 0, 0, [UIntPtr]::Zero)`);
  }
  lines.push(`Write-Output 'CLICK_OK'`);
  return lines.join("\n");
}

/** Executa o script de clique do mouse (coordenada absoluta da tela). */
async function clickAt(cx: number, cy: number, duplo: boolean): Promise<boolean> {
  const script = buildClickScript(cx, cy, duplo);
  try {
    const { stdout } = await execAsync(
      `powershell -NoProfile -EncodedCommand ${psEncodedCommand(script)}`,
      { cwd: HOME, timeout: 15000, windowsHide: true },
    );
    return (stdout ?? "").includes("CLICK_OK");
  } catch {
    return false;
  }
}

/**
 * Clica em texto/coordenada na tela. Aceita:
 * - texto: rótulo visível (ex.: 'Enviar', 'botão OK') — captura fresca quando preciso;
 * - x/y: coordenadas absolutas (ex.: "clica no ponto 500 300");
 * - duplo: "1"/"sim" para duplo clique (ex.: abrir um ícone do desktop).
 * Sempre tenta uma leitura FRESCA se não houver cache recente (tempo real).
 */
export async function toolScreenClick(
  args: Record<string, string>,
): Promise<{ ok: boolean; message: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, message: "Clique na tela disponível apenas no Windows." };
  }
  const duplo = /^(1|true|sim|yes)$/i.test((args.duplo ?? args.duploClique ?? "").trim());

  // Clique por coordenadas absolutas (sem OCR): "clica no ponto 500 300"
  const rawX = (args.x ?? args.coordX ?? "").trim();
  const rawY = (args.y ?? args.coordY ?? "").trim();
  if (rawX && rawY && /^\d{1,5}$/.test(rawX) && /^\d{1,5}$/.test(rawY)) {
    const ok = await clickAt(Number(rawX), Number(rawY), duplo);
    if (!ok) return { ok: false, message: "Não consegui clicar na tela." };
    return { ok: true, message: `Cliquei no ponto ${rawX}, ${rawY} da tela.` };
  }

  const texto = (args.texto ?? args.text ?? "").trim();
  if (!texto) return { ok: false, message: "Diga o texto em que devo clicar ou as coordenadas." };

  // Garante leitura RECENTE (cache curto = 3s) — "clicar em tempo real" exige a
  // tela atual, não uma leitura velha de 15s.
  if (!lastOcr || Date.now() - lastOcr.at > 3000) {
    const fresh = await toolScreenRead({});
    if (!fresh.ok) return fresh;
  }
  if (!lastOcr || lastOcr.words.length === 0) {
    return { ok: false, message: "Não consegui ler nenhum texto na tela para clicar." };
  }

  const norm = (s: string) =>
    s
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9 ]/gi, "")
      .trim();
  const t = norm(texto);
  // Tokens do mais específico para o mais genérico: em "clique no botão enviar",
  // o rótulo do botão é "enviar" (o token mais longo/distintivo), não "botão".
  const tokens = t
    .split(/\s+/)
    .filter((tok) => tok.length > 1)
    .sort((a, b) => b.length - a.length);
  const findWord = () =>
    lastOcr!.words.find((w) => norm(w.text) === t) ??
    lastOcr!.words.find((w) => {
      const wt = norm(w.text);
      return (wt.length > 2 && wt.includes(t)) || (t.length > 2 && t.includes(wt));
    }) ??
    // Alvo com várias palavras ("botão enviar"): o rótulo costuma ser o último token
    lastOcr!.words.find((w) => {
      const wt = norm(w.text);
      return tokens.some((tok) => wt === tok || (wt.length > 2 && wt.includes(tok)));
    });
  let word = findWord();
  // Não achou na leitura atual? Rele a tela na hora (tempo real) e tenta de novo
  if (!word) {
    const fresh = await toolScreenRead({});
    if (fresh.ok) word = findWord();
  }
  if (!word) {
    return { ok: false, message: `Não encontrei "${texto}" na tela.` };
  }
  const cx = lastOcr.boundsX + word.x + word.w / 2;
  const cy = lastOcr.boundsY + word.y + word.h / 2;
  const ok = await clickAt(cx, cy, duplo);
  if (!ok) return { ok: false, message: "Não consegui clicar na tela." };
  return { ok: true, message: `Cliquei em "${word.text}" na tela.` };
}

// ═══════════════════════════════════════════════
// DIGITAR NA TELA (type_text) — texto e teclas em coordenadas reais
// ═══════════════════════════════════════════════

/** Monta o script PowerShell de digitação (exportado para testes). */
export function buildTypeScript(opts: {
  texto?: string;
  key?: string;
  limpar?: boolean;
}): string {
  const lines = [
    `Add-Type -AssemblyName System.Windows.Forms`,
    `$ws = New-Object -ComObject WScript.Shell`,
  ];
  if (opts.limpar) {
    lines.push(`$ws.SendKeys('^a')`);
    lines.push(`Start-Sleep -Milliseconds 60`);
    lines.push(`$ws.SendKeys('{DELETE}')`);
    lines.push(`Start-Sleep -Milliseconds 60`);
  }
  const texto = (opts.texto ?? "").trim();
  if (texto) {
    if (isSimpleAscii(texto)) {
      // Texto ASCII puro: SendKeys direto (rápido). Acentos/emojis usam a área
      // de transferência (Ctrl+V), que respeita Unicode por completo.
      lines.push(`$ws.SendKeys('${sendKeysEscape(texto).replace(/'/g, "''")}')`);
    } else {
      lines.push(`[System.Windows.Forms.Clipboard]::SetText('${texto.replace(/'/g, "''")}')`);
      lines.push(`Start-Sleep -Milliseconds 80`);
      lines.push(`$ws.SendKeys('^v')`);
    }
    lines.push(`Start-Sleep -Milliseconds 80`);
  }
  if (opts.key) {
    lines.push(`$ws.SendKeys('${opts.key.replace(/'/g, "''")}')`);
    lines.push(`Start-Sleep -Milliseconds 80`);
  }
  lines.push(`Write-Output 'TYPE_OK'`);
  return lines.join("\n");
}

/**
 * Digita texto e/ou tecla na tela (campo focado), com clique opcional em
 * coordenadas reais para focar. Aceita: texto (com acentos usa clipboard),
 * key (enter, tab, esc, ctrl+c...), x/y (focar campo), limpar ('1' limpa antes).
 */
export async function toolTypeText(
  args: Record<string, string>,
): Promise<{ ok: boolean; message: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, message: "Digitação na tela disponível apenas no Windows." };
  }
  const texto = (args.texto ?? args.text ?? "").replace(/\r\n/g, "\n");
  const keyRaw = (args.key ?? args.tecla ?? "").trim();
  const limpar = /^(1|true|sim|yes)$/i.test((args.limpar ?? args.clear ?? "").trim());
  if (!texto.trim() && !keyRaw) {
    return { ok: false, message: "Diga o que devo digitar: um texto ou uma tecla (ex.: enter, tab, ctrl+c)." };
  }
  // Limite de tamanho: texto gigante via SendKeys levaria minutos
  if (texto.length > 1000) {
    return { ok: false, message: "O texto é longo demais para digitar de uma vez (máximo 1000 caracteres). Quebre em partes ou diga um trecho menor." };
  }

  // Tecla válida (se informada) — dá feedback claro para o modelo corrigir
  let key: string | null = null;
  if (keyRaw) {
    key = parseSpecialKey(keyRaw);
    if (!key) {
      return {
        ok: false,
        message: `Não conheço a tecla "${keyRaw}". Use: enter, tab, esc, backspace, delete, espaço, setas (cima/baixo/esquerda/direita), f1-f12, ctrl+c, ctrl+v, ctrl+a, ctrl+z, alt+tab.`,
      };
    }
  }

  // Clique em coordenadas reais para focar o campo (opcional)
  const rawX = (args.x ?? "").trim();
  const rawY = (args.y ?? "").trim();
  if (rawX && rawY && /^\d{1,5}$/.test(rawX) && /^\d{1,5}$/.test(rawY)) {
    const okClick = await clickAt(Number(rawX), Number(rawY), false);
    if (!okClick) return { ok: false, message: "Não consegui clicar no campo para focar." };
  }

  const script = buildTypeScript({ texto: texto.trim(), key: key ?? undefined, limpar });
  try {
    // -STA garante thread STA para a área de transferência (Clipboard)
    const { stdout } = await execAsync(
      `powershell -NoProfile -STA -EncodedCommand ${psEncodedCommand(script)}`,
      { cwd: HOME, timeout: 15000, windowsHide: true },
    );
    if (!(stdout ?? "").includes("TYPE_OK")) {
      return { ok: false, message: "Não consegui digitar na tela." };
    }
    const acoes: string[] = [];
    if (limpar) acoes.push("limpei o campo");
    if (texto.trim()) acoes.push(`digitei "${texto.trim().slice(0, 60)}"`);
    if (key) acoes.push(`apertei ${keyRaw}`);
    const onde = rawX ? ` no ponto ${rawX}, ${rawY}` : " no campo focado";
    return { ok: true, message: `${acoes.join(" e ")}${onde}.` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui digitar na tela: ${msg}` };
  }
}

// ═══════════════════════════════════════════════
// VISÃO — screen_ask: captura a tela e pergunta a um modelo vision gratuito
// ═══════════════════════════════════════════════

/**
 * Captura a tela, envia para um modelo de visão gratuito (se configurado) e
 * devolve a resposta falada. Sem modelo de visão, cai para o OCR (screen_read).
 * Ex.: 'descreve a tela', 'o que você vê na tela', 'o que tem aberto na tela?'.
 */
export async function toolScreenAsk(
  args: Record<string, string>,
): Promise<{ ok: boolean; message: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, message: "Visão de tela disponível apenas no Windows." };
  }
  const pergunta = (args.pergunta ?? args.question ?? "Descreva o que está visível na tela.")
    .trim()
    .slice(0, 300);
  const tmp = path.join(os.tmpdir(), `ares-vision-${crypto.randomBytes(4).toString("hex")}.png`);
  try {
    await captureScreenshotToFile(tmp);
    const b64 = await fs.readFile(tmp, "base64");
    const resposta = await askVision(pergunta, b64);
    if (resposta) {
      return { ok: true, message: resposta.slice(0, 700) };
    }
    // Sem modelo de visão configurado: cai para o OCR (funciona sempre) —
    // reutiliza o screenshot já capturado (não tira outro print).
    const ocr =
      (await ocrWindows(tmp).catch(() => null)) ??
      (await ocrTesseract(tmp).catch(() => null));
    if (!ocr || !ocr.text) {
      return { ok: true, message: "Não consegui reconhecer nada na tela (sem modelo de visão e sem OCR)." };
    }
    return {
      ok: true,
      message: `Não há modelo de visão configurado — li o texto da tela com OCR:\n${ocr.text.slice(0, 700)}`,
    };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui analisar a tela: ${msg}` };
  } finally {
    await fs.rm(tmp, { force: true }).catch(() => {});
  }
}

