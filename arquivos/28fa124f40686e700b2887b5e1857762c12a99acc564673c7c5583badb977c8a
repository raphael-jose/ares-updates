const WINDOW_PROCESS: Record<string, string> = {
  chrome: "chrome",
  "google chrome": "chrome",
  edge: "msedge",
  firefox: "firefox",
  word: "winword",
  excel: "excel",
  powerpoint: "powerpnt",
  "power point": "powerpnt",
  notepad: "notepad",
  "bloco de notas": "notepad",
  calculadora: "calc",
  calc: "calc",
  vscode: "Code",
  "visual studio code": "Code",
  code: "Code",
  whatsapp: "WhatsApp",
  discord: "Discord",
  spotify: "Spotify",
  telegram: "Telegram",
  taskmgr: "Taskmgr",
  "gerenciador de tarefas": "Taskmgr",
  explorador: "explorer",
  "explorador de arquivos": "explorer",
  explorer: "explorer",
  cmd: "cmd",
  terminal: "cmd",
  powershell: "powershell",
  outlook: "OUTLOOK",
};

/** Lista as janelas abertas (processo + título) usando PowerShell. */
export async function toolListWindows(): Promise<{ ok: boolean; message: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, message: "Listar janelas disponível apenas no Windows." };
  }
  const script = [
    `[Console]::OutputEncoding = [System.Text.Encoding]::UTF8`,
    `$rows = Get-Process | Where-Object { $_.MainWindowHandle -ne 0 -and $_.MainWindowTitle } | Select-Object -First 30`,
    `if (-not $rows) { Write-Output 'SEM_JANELAS'; exit 0 }`,
    `foreach ($p in $rows) { Write-Output ("JANELA | " + $p.ProcessName + " | " + $p.MainWindowTitle) }`,
  ].join("\n");
  try {
    const { stdout } = await execAsync(
      `powershell -NoProfile -EncodedCommand ${psEncodedCommand(script)}`,
      { cwd: HOME, timeout: 15000, windowsHide: true },
    );
    const out = (stdout ?? "").trim();
    if (out.includes("SEM_JANELAS")) {
      return { ok: true, message: "Nenhuma janela aberta no momento." };
    }
    const lines = out
      .split(/\r?\n/)
      .map((l) => l.replace(/^JANELA \|\s*/, ""))
      .filter((l) => l.includes(" | "))
      .map((l) => {
        const [proc, ...titulo] = l.split(" | ");
        return `• ${proc} — ${titulo.join(" | ")}`;
      });
    if (lines.length === 0) return { ok: true, message: "Nenhuma janela aberta no momento." };
    return { ok: true, message: `Janelas abertas (${lines.length}):\n${lines.join("\n")}` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui listar as janelas: ${msg}` };
  }
}

/**
 * Controla uma janela do Windows: maximizar, minimizar, restaurar, fechar ou
 * ativar/alternar (traz para a frente). janela aceita nome comum (ex.: chrome,
 * word) ou trecho do título da janela.
 */
export async function toolWindowControl(
  args: Record<string, string>,
): Promise<{ ok: boolean; message: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, message: "Controle de janelas disponível apenas no Windows." };
  }
  const acao = (args.acao ?? args.a ?? "ativar").toLowerCase().trim();
  const janela = (args.janela ?? args.programa ?? args.app ?? args.nome ?? "").trim();
  if (!janela) return { ok: false, message: "Diga qual janela/programa controlar (ex.: chrome, word)." };

  // Resolve o processo: alias conhecido ou trecho do título (ex.: "janela do meu site")
  const proc = (WINDOW_PROCESS[janela.toLowerCase()] ?? janela).replace(/[\r\n]/g, " ");
  const verbo =
    acao.startsWith("max")
      ? "maximizar"
      : acao.startsWith("min")
        ? "minimizar"
        : acao.startsWith("rest")
          ? "restaurar"
          : acao.startsWith("fech")
            ? "fechar"
            : "ativar";

  const script = [
    `[Console]::OutputEncoding = [System.Text.Encoding]::UTF8`,
    `Add-Type @"`,
    `using System;`,
    `using System.Runtime.InteropServices;`,
    `public class AresWin {`,
    `  [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);`,
    `  [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);`,
    `}`,
    `"@`,
    `$target = '*${proc.replace(/'/g, "''")}*'`,
    `$p = Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowHandle -ne 0 -and ($_.ProcessName -like $target -or $_.MainWindowTitle -like $target) } | Select-Object -First 1`,
    `if (-not $p) { Write-Output 'NOT_FOUND'; exit 0 }`,
    `switch ('${verbo}') {`,
    `  'maximizar' { [AresWin]::ShowWindow($p.MainWindowHandle, 3) }`,
    `  'minimizar' { [AresWin]::ShowWindow($p.MainWindowHandle, 6) }`,
    `  'restaurar' { [AresWin]::ShowWindow($p.MainWindowHandle, 9) }`,
    `  'fechar' { $p.CloseMainWindow() }`,
    `  default { [AresWin]::ShowWindow($p.MainWindowHandle, 9); [AresWin]::SetForegroundWindow($p.MainWindowHandle) }`,
    `}`,
    `Start-Sleep -Milliseconds 200`,
    `Write-Output 'WINDOW_OK'`,
  ].join("\n");

  try {
    const { stdout } = await execAsync(
      `powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ${psEncodedCommand(script)}`,
      { cwd: HOME, timeout: 60000, windowsHide: true },
    );
    const out = (stdout ?? "").trim();
    if (out.includes("NOT_FOUND")) {
      return {
        ok: false,
        message: `Não encontrei uma janela de "${janela}" aberta. Use list_windows para ver as janelas abertas.`,
      };
    }
    if (!out.includes("WINDOW_OK")) {
      return { ok: false, message: "Não consegui controlar a janela." };
    }
    const verbs: Record<string, string> = {
      maximizar: "Maximizei",
      minimizar: "Minimizei",
      restaurar: "Restaurei",
      fechar: "Fechei",
      ativar: "Ativei/trouxe para a frente",
    };
    return { ok: true, message: `${verbs[verbo] ?? "Controlei"} a janela de ${janela}.` };
  } catch (err) {
    const e = err as { message?: string; stderr?: string; killed?: boolean };
    const stderr = (e.stderr ?? "").trim().slice(0, 500);
    const motivo = e.killed
      ? "o PowerShell demorou demais (timeout de 60s)"
      : stderr || e.message || String(err);
    return { ok: false, message: `Não consegui controlar a janela: ${motivo}` };
  }
}

const WEB_TIMEOUT_MS = 20000;
const UA =
  "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36";

function stripTags(raw: string): string {
  return raw
    .replace(/<script[\s\S]*?<\/script>/gi, " ")
    .replace(/<style[\s\S]*?<\/style>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#0?39;/g, "'")
    .replace(/\s+/g, " ")
    .trim();
}

/**
 * Limpa a consulta de busca: o modelo/builtin às vezes inclui o nome da rede
 * ou o verbo na consulta ("no google X", "pesquisa no google X", "google X").
 * Tira só prefixos — nunca altera o assunto em si. Exportado para testes.
 */
export function cleanSearchQuery(raw: string): string {
  let q = (raw ?? "").trim().replace(/^[\s,.:;!?]+|[\s,.:;!?]+$/g, "");
  // "no google X" / "na internet X" / "no navegador X" / "no youtube X"
  q = q.replace(
    /^(?:no|na|em|neste|nesta)\s+(?:google|gogle|internet|web|navegador|browser|youtube|youtu|yt)\s+(?:sobre\s+|por\s+|o que e\s+|o que é\s+)?/i,
    "",
  );
  // "pesquise no google X" (modelo repetiu o verbo e a rede)
  q = q.replace(
    /^(?:pesquise|pesquisa|pesquisar|procure|procura|busque|busca)\s+(?:no|na)\s+(?:google|internet|web)\s+(?:sobre\s+|por\s+)?/i,
    "",
  );
  // "google X" / "youtube X" no início (modelo pôs a rede na consulta)
  q = q.replace(/^(?:google|gogle|youtube|youtu|yt)\s+/i, "");
  return q.trim();
}

/** Busca na web (sem API key, via DuckDuckGo). Hermes: mesma busca em 3 min vem do cache. */
export const toolWebSearch = cachedTool("web_search", 3 * 60 * 1000, toolWebSearchImpl);

async function toolWebSearchImpl(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const query = cleanSearchQuery(args.consulta ?? args.query ?? args.q ?? "");
  if (!query) return { ok: false, message: "Nenhuma consulta fornecida." };
  try {
    const res = await fetch(`https://html.duckduckgo.com/html/?q=${encodeURIComponent(query)}`, {
      headers: { "User-Agent": UA },
      signal: AbortSignal.timeout(WEB_TIMEOUT_MS),
    });
    if (!res.ok) return { ok: false, message: `Busca falhou (HTTP ${res.status}).` };
    const html = await res.text();

    // Extrai blocos de resultado (título, trecho, link) do HTML do DuckDuckGo
    const blocks = html.split(/<div class="result/).slice(1).slice(0, 5);
    const lines: string[] = [];
    for (const block of blocks) {
      const titleM = block.match(/class="result__a"[^>]*>([\s\S]*?)<\/a>/i);
      const snipM = block.match(/class="result__snippet"[^>]*>([\s\S]*?)<\/a>/i);
      const linkM = block.match(/class="result__a" href="([^"]+)"/i);
      const title = titleM ? stripTags(titleM[1]).slice(0, 80) : "";
      const snip = snipM ? stripTags(snipM[1]).slice(0, 160) : "";
      if (!title && !snip) continue;
      let url = "";
      const href = linkM?.[1] ?? "";
      const uddg = href.match(/uddg=([^&]+)/);
      if (uddg) url = decodeURIComponent(uddg[1]);
      else if (href.startsWith("http")) url = href;
      lines.push(`• ${title}${url ? ` — ${url}` : ""}${snip ? `\n  ${snip}` : ""}`);
    }
    if (lines.length === 0) return { ok: true, message: "Nenhum resultado encontrado para a busca." };
    return { ok: true, message: lines.join("\n") };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui pesquisar na internet: ${msg}` };
  }
}

/** Lê o conteúdo de uma página da web e devolve o texto principal. */
export async function toolFetchUrl(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  let raw = (args.url ?? args.link ?? args.site ?? "").trim();
  if (!raw) return { ok: false, message: "Nenhuma URL fornecida." };
  if (!/^https?:\/\//i.test(raw)) raw = `https://${raw}`;
  try {
    const res = await fetch(raw, {
      headers: { "User-Agent": UA },
      redirect: "follow",
      signal: AbortSignal.timeout(WEB_TIMEOUT_MS),
    });
    if (!res.ok) return { ok: false, message: `Falha ao acessar a página (HTTP ${res.status}).` };
    const contentType = res.headers.get("content-type") ?? "";
    const text = await res.text();
    if (contentType.includes("json")) {
      return { ok: true, message: text.slice(0, 800) };
    }
    const isText = contentType === "" || /text\//i.test(contentType) || /xml/i.test(contentType);
    if (!isText) {
      return {
        ok: false,
        message: `A página não é texto legível (${contentType.split(";")[0].trim() || "formato binário"}).`,
      };
    }
    const titleM = text.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
    const title = titleM ? stripTags(titleM[1]).slice(0, 120) : raw;
    // Limita o HTML bruto antes de extrair texto para não trabalhar de graça em páginas gigantes
    const body = stripTags(text.slice(0, 30000))
      .replace(/\s+/g, " ")
      .slice(0, 1200);
    return { ok: true, message: `${title}\n${body || "Página sem conteúdo legível."}` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui acessar a página: ${msg}` };
  }
}

/** Abre uma URL no navegador padrão do sistema. */
export async function toolOpenUrl(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  let raw = (args.url ?? args.link ?? args.site ?? "").trim();
  if (!raw) return { ok: false, message: "Nenhuma URL fornecida." };
  if (!/^https?:\/\//i.test(raw)) raw = `https://${raw}`;
  try {
    const win = os.platform() === "win32";
    await execAsync(win ? `start "" "${raw.replace(/"/g, '\\"')}"` : `open "${raw}"`, {
      cwd: HOME,
      timeout: EXEC_TIMEOUT,
    });
    return { ok: true, message: `Abrindo no navegador: ${raw}` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui abrir o navegador: ${msg}` };
  }
}

