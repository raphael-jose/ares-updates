const LOCAL_APPDATA = process.env.LOCALAPPDATA ?? path.join(HOME, "AppData", "Local");
const ROAMING_APPDATA = process.env.APPDATA ?? path.join(HOME, "AppData", "Roaming");

// Locais conhecidos de instalação para apps que não se registram no App Paths
const KNOWN_APP_PATTERNS: Record<string, string[]> = {
  whatsapp: [
    path.join(LOCAL_APPDATA, "WhatsApp", "WhatsApp.exe"),
    path.join(LOCAL_APPDATA, "WhatsApp", "app-*", "WhatsApp.exe"),
    path.join(LOCAL_APPDATA, "Programs", "WhatsApp", "WhatsApp.exe"),
  ],
  discord: [path.join(LOCAL_APPDATA, "Discord", "app-*", "Discord.exe")],
  spotify: [path.join(ROAMING_APPDATA, "Spotify", "Spotify.exe")],
  telegram: [path.join(ROAMING_APPDATA, "Telegram Desktop", "Telegram.exe")],
};

async function runCapture(cmd: string): Promise<string> {
  try {
    const { stdout } = await execAsync(cmd, {
      cwd: HOME,
      timeout: 10000,
      windowsHide: true,
    });
    return stdout;
  } catch {
    return "";
  }
}

/** Checa um caminho direto ou um padrão com curinga (ex.: pasta app-* dentro de um diretório). */
async function findByGlob(pattern: string): Promise<string | null> {
  const wildcardIdx = pattern.indexOf("*");
  if (wildcardIdx < 0) {
    return fs
      .access(pattern)
      .then(() => pattern)
      .catch(() => null);
  }
  const before = pattern.slice(0, wildcardIdx);
  const after = pattern.slice(wildcardIdx + 1);
  const dir = path.dirname(before);
  const prefix = path.basename(before);
  try {
    const entries = await fs.readdir(dir);
    for (const e of entries) {
      if (!e.startsWith(prefix)) continue;
      const candidate = path.join(dir, e, after);
      if (await fs.access(candidate).then(() => true).catch(() => false)) return candidate;
    }
  } catch {
    /* pasta não existe */
  }
  return null;
}

async function findInPath(name: string): Promise<string | null> {
  const out = await runCapture(`where.exe "${name}"`);
  const first = out
    .split(/\r?\n/)
    .map((s) => s.trim())
    .find(Boolean);
  return first || null;
}

function expandEnv(p: string): string {
  return p
    .replace(/%LOCALAPPDATA%/gi, LOCAL_APPDATA)
    .replace(/%APPDATA%/gi, ROAMING_APPDATA)
    .replace(/%USERPROFILE%/gi, HOME)
    .replace(/%HOMEDRIVE%%HOMEPATH%/gi, HOME);
}

async function findInAppPaths(exeName: string): Promise<string | null> {
  const bases = [
    "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths",
    "HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\App Paths",
    "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths",
  ];
  for (const base of bases) {
    const out = await runCapture(`reg query "${base}\\${exeName}" /ve`);
    const m = out.match(/Default\s+REG_(?:SZ|EXPAND_SZ)\s+(.+)$/im);
    if (!m) continue;
    const p = expandEnv(m[1].trim());
    if (await fs.access(p).then(() => true).catch(() => false)) return p;
  }
  return null;
}

/** Resolve o caminho real de um programa instalado no Windows. */
async function resolveProgram(name: string): Promise<string | null> {
  const n = name.trim();
  if (!n) return null;
  const exeName = /\.exe$/i.test(n) ? n : `${n}.exe`;
  const direct = await findByGlob(n);
  if (direct) return direct;
  const inPath = await findInPath(exeName);
  if (inPath) return inPath;
  const appPaths = await findInAppPaths(exeName);
  if (appPaths) return appPaths;
  for (const pat of KNOWN_APP_PATTERNS[n.toLowerCase()] ?? []) {
    const hit = await findByGlob(pat);
    if (hit) return hit;
  }
  return null;
}

// Apps instalados pela Microsoft Store: localizam-se pelo pacote (Get-AppxPackage)
// e abrem através do identificador AppUserModelID (shell:AppsFolder).
const STORE_APP_IDS: Record<string, { search: string; appId: string }> = {
  whatsapp: { search: "WhatsApp", appId: "App" },
  instagram: { search: "Instagram", appId: "Instagram" },
};

async function findStoreApp(appKey: string): Promise<string | null> {
  const cfg = STORE_APP_IDS[appKey];
  if (!cfg) return null;
  const cmd = `powershell -NoProfile -Command "Get-AppxPackage | Where-Object { $_.Name -like '*${cfg.search}*' } | Select-Object -First 1 -ExpandProperty PackageFamilyName"`;
  const out = await runCapture(cmd);
  const family = out
    .split(/\r?\n/)
    .map((s) => s.trim())
    .find(Boolean);
  if (!family) return null;
  return `${family}!${cfg.appId}`;
}

/** Abre um programa/aplicativo instalado no computador. */
export async function toolOpenProgram(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const raw = (args.programa ?? args.app ?? args.nome ?? "").trim();
  if (!raw) return { ok: false, message: "Nenhum programa informado." };
  const alias = PROGRAM_ALIASES[raw.toLowerCase()] ?? raw;
  try {
    const win = os.platform() === "win32";
    if (win) {
      const exe = await resolveProgram(alias);
      if (exe) {
        // Caminho real do executável: abre o programa, nunca uma pasta
        await execAsync(`start "" "${exe.replace(/"/g, '\\"')}"`, {
          cwd: HOME,
          timeout: EXEC_TIMEOUT,
        });
      } else {
        const aumid = await findStoreApp(alias.toLowerCase());
        if (aumid) {
          // App da Microsoft Store (ex.: WhatsApp): abre pelo AppUserModelID
          await execAsync(`start "" "shell:AppsFolder\\${aumid}"`, {
            cwd: HOME,
            timeout: EXEC_TIMEOUT,
          });
        } else if (alias === "whatsapp") {
          // Nem desktop nem Store → abre o WhatsApp Web com a lista de contatos
          await execAsync(`start "" "https://web.whatsapp.com/"`, {
            cwd: HOME,
            timeout: EXEC_TIMEOUT,
          });
        } else if (alias === "instagram") {
          await execAsync(`start "" "https://www.instagram.com/"`, {
            cwd: HOME,
            timeout: EXEC_TIMEOUT,
          });
        } else if (/^[A-Za-z0-9._-]+$/.test(alias)) {
          // Nome simples sem aspas: o ShellExecute resolve via App Paths / PATH
          await execAsync(`start "" ${alias}.exe`, { cwd: HOME, timeout: EXEC_TIMEOUT });
        } else {
          await execAsync(`start "" "${alias.replace(/"/g, '\\"')}"`, {
            cwd: HOME,
            timeout: EXEC_TIMEOUT,
          });
        }
      }
    } else {
      await execAsync(alias, { cwd: HOME, timeout: EXEC_TIMEOUT });
    }
    return { ok: true, message: `Abrindo o programa: ${raw}` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui abrir o programa ${raw}: ${msg}` };
  }
}

const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

/** Codifica um script PowerShell em base64 UTF-16LE (sem problemas de escaping). */
function psEncodedCommand(script: string): string {
  return Buffer.from(script, "utf16le").toString("base64");
}

/** Abre o aplicativo do WhatsApp do Windows (desktop ou Microsoft Store). */
async function openWhatsAppApp(): Promise<boolean> {
  const exe = await resolveProgram("whatsapp");
  if (exe) {
    await execAsync(`start "" "${exe.replace(/"/g, '\\"')}"`, {
      cwd: HOME,
      timeout: EXEC_TIMEOUT,
    });
    return true;
  }
  const aumid = await findStoreApp("whatsapp");
  if (aumid) {
    await execAsync(`start "" "shell:AppsFolder\\${aumid}"`, {
      cwd: HOME,
      timeout: EXEC_TIMEOUT,
    });
    return true;
  }
  return false;
}

/** Gera o script PowerShell da automação do WhatsApp (exportado para testes). */
export function buildWhatsAppScript(
  contactName: string,
  phoneNumber: string,
  message: string,
): string {
  const digits = phoneNumber.replace(/\D/g, "");
  const esc = (s: string) => s.replace(/'/g, "''").replace(/\r?\n/g, " ");
  const uri = `whatsapp://send?phone=${digits}&text=${encodeURIComponent(message)}`;
  const normName = contactName
    .toLowerCase()
    .replace(/[áàâãä]/g, "a")
    .replace(/[éèêë]/g, "e")
    .replace(/[íìîï]/g, "i")
    .replace(/[óòôõö]/g, "o")
    .replace(/[úùûü]/g, "u")
    .replace(/[ç]/g, "c");

  return [
    `$ErrorActionPreference = 'Stop'`,
    // 2) Fecha qualquer conversa aberta e foca no aplicativo
    `$ws = New-Object -ComObject WScript.Shell`,
    `$p0 = Get-Process -Name 'WhatsApp' -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowHandle -ne 0 } | Select-Object -First 1`,
    `$before = '' + $(if ($p0) { $p0.MainWindowTitle })`,
    `$ok = $ws.AppActivate('WhatsApp')`,
    `if (-not $ok) { Start-Sleep -Seconds 3; $ok = $ws.AppActivate('WhatsApp') }`,
    `if (-not $ok) { Write-Output 'FALHA_ATIVACAO'; exit 1 }`,
    // 3) Abre a conversa exata pelo número (sem busca por nome; mensagem preenchida)
    `Start-Process '${esc(uri)}'`,
    `Start-Sleep -Seconds 4`,
    `$ok = $ws.AppActivate('WhatsApp')`,
    `if (-not $ok) { Start-Sleep -Seconds 3; $ok = $ws.AppActivate('WhatsApp') }`,
    `if (-not $ok) { Write-Output 'FALHA_ATIVACAO'; exit 1 }`,
    // 4) Verifica que a conversa abriu: o título da janela muda para o contato
    `$p = Get-Process -Name 'WhatsApp' -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowHandle -ne 0 } | Select-Object -First 1`,
    `$title = '' + $(if ($p) { $p.MainWindowTitle })`,
    `$norm = { param($s) $s.ToLower() -replace '[áàâãä]','a' -replace '[éèêë]','e' -replace '[íìîï]','i' -replace '[óòôõö]','o' -replace '[úùûü]','u' -replace '[ç]','c' }`,
    `$normTitle = & $norm $title`,
    `$normBefore = & $norm $before`,
    `$expect = '${esc(normName || digits)}'`,
    `$navigated = ($normTitle -ne '' -and $normTitle -ne $normBefore)`,
    `if (($normTitle -notlike "*$expect*") -and -not $navigated) { Write-Output 'FALHA_CONVERSA'; exit 1 }`,
    `Start-Sleep -Milliseconds 500`,
    // 5) Envia (a mensagem já está preenchida pelo protocolo)
    `$ws.SendKeys('{ENTER}')`,
    `Start-Sleep -Milliseconds 900`,
    `Write-Output 'ENVIADO'`,
  ].join("\n");
}

/**
 * Automatiza o aplicativo do WhatsApp no Windows: abre a conversa exata pelo
 * número via protocolo whatsapp:// (a mensagem já vem preenchida), ativa a
 * janela e confirma visualmente que a conversa abriu antes de pressionar ENTER.
 */
async function whatsappDesktopSend(
  contactName: string,
  phoneNumber: string,
  message: string,
): Promise<{ ok: boolean; detail: string }> {
  if (os.platform() !== "win32") {
    return { ok: false, detail: "automação disponível apenas no Windows" };
  }

  // 1) Garante o aplicativo aberto (nunca o navegador)
  const opened = await openWhatsAppApp();
  if (!opened) return { ok: false, detail: "WhatsApp não instalado" };
  await sleep(4500); // espera o app carregar

  const digits = phoneNumber.replace(/\D/g, "");
  if (!digits) return { ok: false, detail: "número inválido" };

  const script = buildWhatsAppScript(contactName, phoneNumber, message);

  const cmd = `powershell -NoProfile -EncodedCommand ${psEncodedCommand(script)}`;
  try {
    const { stdout, stderr } = await execAsync(cmd, {
      cwd: HOME,
      timeout: EXEC_TIMEOUT,
      windowsHide: true,
    });
    const out = (stdout || stderr || "").trim();
    if (out.includes("ENVIADO")) return { ok: true, detail: "" };
    if (out.includes("FALHA_ATIVACAO")) {
      return { ok: false, detail: "não consegui ativar a janela do WhatsApp" };
    }
    if (out.includes("FALHA_CONVERSA")) {
      return { ok: false, detail: "não consegui abrir a conversa do contato no WhatsApp" };
    }
    return { ok: false, detail: "a automação não concluiu" };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, detail: msg };
  }
}

/**
 * Normaliza um número de telefone BR: tira o zero de discagem (01199999… →
 * 1199999…) e, se for número nacional (10-11 dígitos) sem código do país,
 * acrescenta o +55 — o protocolo whatsapp:// exige o código internacional.
 */
export function normalizeBrNumber(raw: string): string {
  let n = (raw ?? "").replace(/\D/g, "");
  if (!n) return n;
  if (n.startsWith("0")) n = n.slice(1);
  if ((n.length === 10 || n.length === 11) && !n.startsWith("55")) n = `55${n}`;
  return n;
}

/**
 * Envia uma mensagem no WhatsApp pela sessão real (whatsapp-web.js):
 * primeiro tenta o servidor (conexão rápida e confiável); se ele não estiver
 * conectado, tenta o aplicativo do Windows; por fim, abre a conversa no
 * navegador com a mensagem preenchida. O envio real só acontece depois da
 * confirmação por voz (ver executor.ts).
 */
export async function toolSendWhatsApp(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const contato = (args.contato ?? "").trim();
  let numero = normalizeBrNumber(args.numero ?? args.telefone ?? args.para ?? "");
  // O nome do contato SEMPRE manda: resolve o número pela memória. Evita que o
  // modelo invente um número qualquer ao passar um contato junto.
  if (contato) {
    const found = findContactSync(contato);
    if (found) {
      numero = normalizeBrNumber(found);
    } else if (!numero) {
      return {
        ok: false,
        message: `Não tenho o número de ${contato} na memória. Me diga o número, por exemplo: "o número da ${contato} é 5511999999999", que eu guardo e uso da próxima vez.`,
      };
    }
  }
  const mensagem = (args.mensagem ?? args.texto ?? args.msg ?? "Oi!").trim();
  if (!numero) return { ok: false, message: "Informe o número ou o contato do WhatsApp." };

  // 1) Caminho principal: sessão real via servidor whatsapp-web.js
  const serverUp = await ensureWhatsappServer();
  if (serverUp) {
    const status = await waStatus();
    if (status?.connected) {
      const res = await waSend(numero, mensagem);
      if (res.ok) {
        return { ok: true, message: `Mensagem enviada para ${contato || numero} no WhatsApp: ${mensagem}` };
      }
      if (status.lastError) {
        return { ok: false, message: `WhatsApp conectado mas o envio falhou: ${res.message}` };
      }
    }
  }

  // 2) Segunda via: automação no aplicativo do Windows (sessão antiga)
  const auto = await whatsappDesktopSend(contato, numero, mensagem);
  if (auto.ok) {
    return { ok: true, message: `Mensagem enviada para ${contato || numero} no WhatsApp: ${mensagem}` };
  }

  // 3) Última via: abre a conversa no navegador com a mensagem preenchida
  const url = `https://wa.me/${numero}${mensagem ? `?text=${encodeURIComponent(mensagem)}` : ""}`;
  try {
    await execAsync(os.platform() === "win32" ? `start "" "${url}"` : `open "${url}"`, {
      cwd: HOME,
      timeout: EXEC_TIMEOUT,
    });
    return {
      ok: true,
      message: `A sessão do WhatsApp ainda não está conectada (escaneie o QR na janela do WhatsApp). Abri a conversa no navegador com a mensagem: ${mensagem}`,
    };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return {
      ok: false,
      message: `Não consegui enviar: abra a janela do WhatsApp (diga \"abre o whatsapp\"), escaneie o QR e tente de novo. Detalhe: ${msg}`,
    };
  }
}

/**
 * Lê as conversas do WhatsApp pela sessão real. Sem "conversa", lista as
 * conversas recentes (nome + última mensagem); com "conversa", mostra as
 * últimas mensagens daquele contato/grupo (por nome ou número).
 */
export async function toolWhatsAppRead(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const servidor = await ensureWhatsappServer();
  if (!servidor) {
    return { ok: false, message: "Não consegui iniciar a sessão do WhatsApp agora." };
  }
  const status = await waStatus();
  if (!status?.connected) {
    return {
      ok: false,
      message: `A sessão do WhatsApp ainda não está conectada. Diga \"abre o whatsapp\" para ver o QR code no HUD e escaneie com o celular.${status?.sessionExists ? " (A sessão salva existe — deve reconectar sozinha.)" : ""}`,
    };
  }

  const conversa = (args.conversa ?? args.contato ?? args.com ?? "").trim();
  const limite = Math.min(Math.max(Number(args.limite ?? args.n ?? "10") || 10, 3), 25);

  // Sem conversa: lista as conversas recentes
  if (!conversa) {
    const chats = await waChats();
    if (!chats.length) return { ok: true, message: "Nenhuma conversa recente no WhatsApp." };
    const lines = chats.slice(0, Math.min(limite, 12)).map((c, i) => {
      const msg = c.lastMessage ? ` — ${c.lastMessage}` : "";
      return `${i + 1}. ${c.name}${msg}`;
    });
    return {
      ok: true,
      message: `Suas conversas recentes do WhatsApp:\n${lines.join("\n")}`,
    };
  }

  // Com conversa: acha pelo nome (case-insensitive, parte do nome) ou número
  const chats = await waChats();
  const norm = (s: string) =>
    s
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9 ]/gi, "")
      .trim();
  const alvo = norm(conversa);
  const digits = conversa.replace(/\D/g, "");
  let chat = chats.find((c) => norm(c.name) === alvo);
  if (!chat) chat = chats.find((c) => norm(c.name).includes(alvo));
  if (!chat && digits.length >= 8) {
    chat = chats.find((c) => c.id.replace(/\D/g, "").endsWith(digits));
  }
  if (!chat) {
    return {
      ok: false,
      message: `Não achei uma conversa chamada \"${conversa}\" nas recentes. Use \"leia o whatsapp\" para ver a lista.`,
    };
  }

  const data = await waMessages(chat.id, limite);
  if (!data || !data.messages.length) {
    return { ok: true, message: `A conversa com ${chat.name} não tem mensagens visíveis ainda.` };
  }
  const lines = data.messages.map((m) => {
    const quem = m.fromMe ? "Você" : chat.name;
    const hora = new Date(m.at).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });
    return `${quem} (${hora}): ${m.body}`;
  });
  return {
    ok: true,
    message: `Conversa com ${chat.name} (últimas ${lines.length}):\n${lines.join("\n")}`,
  };
}

