// Pastas comuns do usuário onde um nome simples pode estar (além da própria home)
const COMMON_USER_DIRS = [
  HOME,
  path.join(HOME, "Desktop"),
  path.join(HOME, "Downloads"),
  path.join(HOME, "Documents"),
  path.join(HOME, "Pictures"),
  path.join(HOME, "Music"),
  path.join(HOME, "Videos"),
  path.join(HOME, "Projects"),
];

// Raízes importantes que nunca devem ser apagadas por engano
const PROTECTED_DIRS = new Set(COMMON_USER_DIRS.map((d) => d.toLowerCase()));

async function pathExists(p: string): Promise<boolean> {
  try {
    await fs.access(p);
    return true;
  } catch {
    return false;
  }
}

export async function toolDeletePath(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const raw = (args.path ?? args.caminho ?? args.pasta ?? args.local ?? "").trim();
  if (!raw) return { ok: false, message: "Diga o que deseja apagar: um arquivo ou uma pasta." };
  const requested = resolveProjectPath(raw);

  // Se o caminho resolvido não existe, procura pelo nome nas pastas comuns —
  // "apaga notas.txt" normalmente se refere a um arquivo no Downloads/Desktop,
  // não na raiz da home.
  let target = requested;
  if (!(await pathExists(target))) {
    const base = path.basename(requested);
    const found: string[] = [];
    for (const dir of COMMON_USER_DIRS) {
      const candidate = path.join(dir, base);
      if (await pathExists(candidate)) found.push(candidate);
    }
    if (found.length === 0) {
      return { ok: false, message: `Não encontrei "${base}". O caminho ${requested} não existe.` };
    }
    if (found.length > 1) {
      return {
        ok: false,
        message: `Encontrei ${found.length} itens com o nome "${base}":\n${found.join("\n")}\nDiga o caminho completo para eu apagar o certo.`,
      };
    }
    target = found[0];
  }

  if (PROTECTED_DIRS.has(target.toLowerCase())) {
    return { ok: false, message: `Não posso apagar ${target}, é uma pasta importante.` };
  }

  const stat = await fs.lstat(target).catch(() => null);
  if (!stat) return { ok: false, message: `${target} não existe.` };
  try {
    await fs.rm(target, { recursive: true, force: false });
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui apagar ${target}: ${msg}` };
  }
  if (await pathExists(target)) {
    return { ok: false, message: `Não consegui apagar ${target}: o arquivo continua lá.` };
  }
  return { ok: true, message: `Apagado: ${target}` };
}

