/**
 * Busca no YouTube e devolve o ID do PRIMEIRO vídeo do resultado.
 * O HTML da busca embute o ytInitialData com os videoIds; extrai o primeiro.
 * Exportado para o teste (e útil para tocar música/vídeo direto).
 */
export async function youtubeFirstVideoId(query: string): Promise<string | null> {
  try {
    const res = await fetch(
      `https://www.youtube.com/results?search_query=${encodeURIComponent(query)}&hl=pt-BR`,
      {
        headers: { "User-Agent": UA, "Accept-Language": "pt-BR,pt;q=0.9" },
        signal: AbortSignal.timeout(WEB_TIMEOUT_MS),
      },
    );
    if (!res.ok) return null;
    const html = await res.text();
    const m = html.match(/"videoId":"([A-Za-z0-9_-]{11})"/);
    return m ? m[1] : null;
  } catch {
    return null;
  }
}

/**
 * Busca a primeira URL de vídeo real de redes que bloqueiam scraping (TikTok,
 * Instagram Reels) usando o DuckDuckGo: o HTML da busca contém os links reais
 * (uddg). Devolve null se não achar nada — o chamador cai na página de busca.
 */
export async function firstVideoFromSearch(
  query: string,
  urlTest: (u: string) => boolean,
): Promise<string | null> {
  // Retry simples: o DuckDuckGo às vezes responde 202 (desafio anti-bot) numa
  // consulta isolada; uma segunda tentativa segundos depois costuma passar.
  for (let attempt = 0; attempt < 2; attempt++) {
    try {
      const res = await fetch(`https://html.duckduckgo.com/html/?q=${encodeURIComponent(query)}`, {
        headers: { "User-Agent": UA },
        signal: AbortSignal.timeout(WEB_TIMEOUT_MS),
      });
      if (!res.ok) {
        await new Promise((r) => setTimeout(r, 1500));
        continue;
      }
      const html = await res.text();
      const blocks = html.split(/<div class="result/).slice(1).slice(0, 10);
      for (const block of blocks) {
        const linkM = block.match(/class="result__a" href="([^"]+)"/);
        const href = linkM?.[1] ?? "";
        let url = "";
        const uddg = href.match(/uddg=([^&]+)/);
        if (uddg) url = decodeURIComponent(uddg[1]);
        else if (href.startsWith("http")) url = href;
        if (url && urlTest(url)) return url;
      }
      return null;
    } catch {
      await new Promise((r) => setTimeout(r, 1500));
    }
  }
  return null;
}

/** Pesquisa um perfil/pessoa/site em uma rede social específica. */
export async function toolSocialSearch(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const rede = (args.rede ?? args.site ?? args.plataforma ?? "google").toLowerCase().trim();
  const query = cleanSearchQuery(args.consulta ?? args.query ?? args.perfil ?? args.pessoa ?? "");
  if (!query) return { ok: false, message: "Informe o que deseja pesquisar." };
  const direto = /^(1|true|sim|yes)$/i.test((args.direto ?? "").trim());

  // Música/vídeo específico: abre o PRIMEIRO resultado direto no player
  if (direto) {
    let url: string | null = null;
    let achou = false;
    if (rede === "youtube") {
      const vid = await youtubeFirstVideoId(query);
      if (vid) {
        url = `https://www.youtube.com/watch?v=${vid}&autoplay=1`;
        achou = true;
      }
    } else if (rede === "tiktok") {
      url =
        (await firstVideoFromSearch(
          `site:tiktok.com ${query}`,
          (u) => u.includes("tiktok.com/@") && u.includes("/video/"),
        )) ??
        (await firstVideoFromSearch(`site:tiktok.com ${query}`, (u) => /^https:\/\/vt\.tiktok\.com\//i.test(u)));
      achou = url !== null;
    } else if (rede === "instagram" || rede === "reels") {
      url = await firstVideoFromSearch(
        `site:instagram.com/reel ${query}`,
        (u) => u.includes("instagram.com/reel/"),
      );
      achou = url !== null;
    }

    if (url) {
      try {
        await execAsync(os.platform() === "win32" ? `start "" "${url}"` : `open "${url}"`, {
          cwd: HOME,
          timeout: EXEC_TIMEOUT,
        });
        return { ok: true, message: `Tocando no ${rede} o primeiro resultado de "${query}".` };
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        return { ok: false, message: `Não consegui tocar o vídeo: ${msg}` };
      }
    }

    // Fallback honesto: abre a página de busca da rede com o termo certo
    const fb =
      rede === "instagram" || rede === "reels"
        ? `https://www.instagram.com/explore/search/keyword/?q=${encodeURIComponent(query)}`
        : SOCIAL_SEARCH_URLS[rede]?.replace("{q}", encodeURIComponent(query)) ?? "";
    if (fb) {
      try {
        await execAsync(os.platform() === "win32" ? `start "" "${fb}"` : `open "${fb}"`, {
          cwd: HOME,
          timeout: EXEC_TIMEOUT,
        });
        return {
          ok: true,
          message: `Não achei o vídeo exato — abri a busca por "${query}" no ${rede}.`,
        };
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        return { ok: false, message: `Não consegui tocar o vídeo: ${msg}` };
      }
    }
    return {
      ok: false,
      message: `Não consegui tocar o vídeo em ${rede}.`,
    };
  }

  const base = SOCIAL_SEARCH_URLS[rede] ?? SOCIAL_SEARCH_URLS.google;
  const url = base.replace("{q}", encodeURIComponent(query));
  try {
    await execAsync(os.platform() === "win32" ? `start "" "${url}"` : `open "${url}"`, {
      cwd: HOME,
      timeout: EXEC_TIMEOUT,
    });
    return { ok: true, message: `Pesquisando "${query}" em ${rede}.` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui pesquisar: ${msg}` };
  }
}

/**
 * Encontra uma imagem sobre um assunto (Wikimedia Commons, URL direta e sem
 * chave) e devolve a URL para o HUD MOSTRAR no painel. O cliente abre o
 * visualizador quando vê o log da ferramenta show_image.
 */
export async function toolShowImage(args: Record<string, string>): Promise<{ ok: boolean; message: string }> {
  const assunto = cleanSearchQuery(args.assunto ?? args.consulta ?? args.query ?? "");
  if (!assunto) return { ok: false, message: "Diga o que você quer ver na imagem." };
  try {
    const entries = await wikimediaSearch(assunto, "bitmap", 8);
    const wide = (e: { width?: number }) => (e.width ?? 0) >= 400 || e.width == null;
    const best =
      entries.find((e) => e.mime === "image/jpeg" && wide(e)) ??
      entries.find((e) => e.mime === "image/png" && wide(e)) ??
      entries.find((e) => e.mime === "image/webp" && wide(e)) ??
      entries.find((e) => wide(e));
    if (!best?.url) {
      return { ok: false, message: `Não achei uma imagem de ${assunto}.` };
    }
    return { ok: true, message: `Mostrando imagem de ${assunto}: ${best.url}` };
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    return { ok: false, message: `Não consegui buscar a imagem: ${msg}` };
  }
}

