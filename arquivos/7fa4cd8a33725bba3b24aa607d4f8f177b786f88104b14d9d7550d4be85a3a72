/** Total de comandos catalogados. */
export const TOTAL_COMANDOS = CATALOGO_COMANDOS.reduce(
  (acc, c) => acc + c.comandos.length,
  0,
);

/** Busca nos comandos por texto (case-insensitive, sem acento). */
export function buscarComandos(
  termo: string,
): CategoriaComandos[] {
  const q = (termo ?? "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim();
  if (!q) return CATALOGO_COMANDOS;
  return CATALOGO_COMANDOS.map((cat) => ({
    ...cat,
    comandos: cat.comandos.filter((c) =>
      `${c.fala} ${c.faz}`
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .includes(q),
    ),
  })).filter((cat) => cat.comandos.length > 0);
}
