export interface ToolCall {
  tool: ToolName;
  args: Record<string, string>;
}

export interface LogEntry {
  /** Identificador único estável (contador monotônico). */
  id: number;
  /** Timestamp local (HH:MM:SS). */
  time: string;
  /** Nome da ferramenta executada. */
  tool: ToolName;
  /** Texto curto descrevendo a ação (ex.: Pasta criada: C:/...). */
  text: string;
  /** Se a ação foi bem-sucedida. */
  ok: boolean;
}

export interface AgentResult {
  /** Texto que o ARES deve falar. */
  reply: string;
  /** Entrada de log da ação executada (quando houver). */
  log?: LogEntry;
  /** Logs de uma sequência (ex.: rotinas com vários passos). */
  logs?: LogEntry[];
  /** Quando apagar algo (delete_path), pede confirmação por voz antes de executar. */
  needsConfirmation?: {
    token: string;
    action: string;
  };
  /** Sugestões curtas e relevantes ao assunto para o usuário continuar a conversa. */
  sugestoes?: string[];
}
