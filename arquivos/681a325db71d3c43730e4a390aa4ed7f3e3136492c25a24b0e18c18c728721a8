] as const;
export const VIDEO_EXTS = [
  ".mp4",
  ".m4v",
  ".webm",
  ".ogv",
  ".ogg",
  ".mov",
  ".mkv",
  ".avi",
  ".wmv",
  ".flv",
  ".mpg",
  ".mpeg",
  ".3gp",
  ".ts",
] as const;
export const TEXT_EXTS = [
  ".txt",
  ".md",
  ".log",
  ".json",
  ".js",
  ".mjs",
  ".cjs",
  ".jsx",
