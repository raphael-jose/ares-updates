/**
 * Classificação de arquivos por extensão para o HUD: o explorer abre cada
 * arquivo no módulo certo (Office, imagem, vídeo, texto) e a rota /api/media
 * usa o mesmo mapa para servir o MIME. Sem dependências (testável).
 */

export const OFFICE_EXTS = [".docx", ".xlsx", ".pptx"] as const;
export const IMAGE_EXTS = [
  ".png",
  ".jpg",
  ".jpeg",
  ".gif",
  ".webp",
  ".bmp",
  ".svg",
  ".ico",
  ".avif",
  ".tif",
