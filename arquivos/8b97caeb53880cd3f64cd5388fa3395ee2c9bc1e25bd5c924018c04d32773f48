/** Extrai o valor em reais de uma frase ("R$ 50,90", "50 reais", "1.200"). */
function extrairValorFinanceiro(texto: string): number | null {
  const m = texto.match(/r\$\s*([\d][\d.,]*)|([\d][\d.,]*)\s*reais?/i);
  if (!m) return null;
  const raw = (m[1] ?? m[2] ?? "").replace(/\s/g, "");
  let v: number;
  if (raw.includes(",") && raw.includes(".")) v = Number(raw.replace(/\./g, "").replace(",", "."));
  else if (raw.includes(",")) v = Number(raw.replace(",", "."));
  else v = Number(raw);
  return Number.isFinite(v) && v > 0 ? v : null;
}

/** Descobre a categoria do gasto pela palavra-chave na frase. */
function extrairCategoriaFinanceira(texto: string): string {
  const regras: [RegExp, string][] = [
    [/alimenta|caf[ée]|lanche|mercado|restaurante|pizza|ifood|padaria|feira|comida/i, "alimentação"],
    [/transpor|combust|gasolina|uber|99|ônibus|onibus|metr[ôo]|t[áa]xi|ped[áa]gio/i, "transporte"],
    [/moradia|aluguel|luz|[áa]gua|internet|condom[ií]nio|telefone/i, "moradia"],
    [/lazer|cinema|show|viagem|jogo|streaming|netflix|spotify|jogos/i, "lazer"],
    [/sa[úu]de|farm[áa]cia|m[ée]dico|dentista|rem[ée]dio|academia/i, "saúde"],
    [/educa[çc][ãa]o|curso|faculdade|escola|livro/i, "educação"],
    [/sal[áa]rio|bolsa|pens[ãa]o|freela|renda/i, "salário"],
  ];
  for (const [re, cat] of regras) if (re.test(texto)) return cat;
  return "outros";
}

/** Descobre se é receita (dinheiro entrou) ou despesa (saiu). */
function extrairTipoFinanceiro(texto: string): "receita" | "despesa" {
  if (/ganhei|recebi|recebemos|receita|recebido|sal[áa]rio|renda|caiu\s+na\s+conta|entrou/i.test(texto)) {
    return "receita";
  }
  return "despesa";
}

/** Monta uma descrição curta do lançamento a partir do resto da frase. */
function descricaoFinanceira(texto: string): string | undefined {
  const d = texto
    .replace(
      /^(?:adiciona|adicionar|registra|registre|registrar|lan[çc]a|lance|lan[çc]ar|coloca|coloque|anota|anote|marca|marque|gastei|paguei|comprei|ganhei|recebi|gasto|gastamos|recebemos|custou|entrou|caiu)\s+(?:(?:uma|um|a|o)\s+)?(?:despesa|receita|gasto|ganho|de|em|com|por)\s*/i,
      "",
    )
    .replace(/\b\d[\d.,]*\s*reais?\b/gi, " ")
    .replace(/\br\$\s*[\d.,]+\b/gi, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 60);
  return d || undefined;
}

