// ——— Atalhos personalizados de sites (janela COMANDOS → MEUS SITES) ———
// O usuário registra "frase falada → URL" na interface; aqui esses atalhos são
// casados por voz ("abre meu painel", "vai para meu painel" ou só "meu painel").
export interface SiteAtalho {
  nome: string;
  url: string;
}

const CUSTOM_SITES_KEY = "ares-custom-sites";

/** Lê os atalhos personalizados salvos no localStorage (vazio no servidor). */
export function getCustomSites(): SiteAtalho[] {
  try {
    if (typeof window === "undefined") return [];
    const raw = window.localStorage.getItem(CUSTOM_SITES_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw) as unknown;
    if (!Array.isArray(parsed)) return [];
    return parsed
      .filter(
        (e): e is SiteAtalho =>
          !!e && typeof e === "object" && typeof (e as SiteAtalho).nome === "string" && typeof (e as SiteAtalho).url === "string",
      )
      .map((e) => ({ nome: e.nome.trim(), url: e.url.trim() }))
      .filter((e) => e.nome && e.url);
  } catch {
    return [];
  }
}

/** Minúsculas + sem acentos, para casar com a transcrição de voz. */
function normWord(s: string): string {
  return s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim();
}

// ——— Entendimento da fala: cortesia, gagueira e ruído ———
// Palavras de cortesia não fazem parte da intenção: o usuário pede uma ação
// e acrescenta "por favor"/"obrigado" no fim — isso nunca pode entrar numa
// agenda, memória, tarefa, nota ou no texto enviado ao modelo.
const POLITENESS_RE =
  /\b(?:muito\s+obrigad[oa]s?|por\s+favor|porfavor|obrigad[oa]s?|obrigad[aã]o|brigad[oa]s?|brigad[aã]o|obrigad[íi]ssim[oa]s?|agradecid[oa]s?|agrade[çc]o(?:-lhe)?|valeu|gr[ãa]t[oa]s?|gratid[ãa]o|\bpv?f\b|pfvr|pfv)\b/gi;

/**
 * Limpa a fala do usuário antes de qualquer interpretação:
 * - remove palavras de cortesia ("por favor", "obrigado", "valeu"…);
 * - colapsa repetições consecutivas de palavras (gagueira/erro do
 *   reconhecimento: "eu eu quero criar criar" vira "eu quero criar");
 * - limpa pontuação sobrante e espaços duplos.
 * A intenção é preservada; os ruídos de fala não entram em agenda/memória.
 */
export function normalizeUtterance(raw: string): string {
  let s = (raw ?? "").trim();
  if (!s) return "";
  s = s.replace(POLITENESS_RE, " ");
  // Pontuação de sentença (vírgulas, exclamações…) → espaço; pontos dentro de
  // nomes ("texto.txt") são preservados
  s = s.replace(/[,;.!?…]+(?=\s|$)/g, " ");
  // Gagueira/repetição: "eu eu quero" → "eu quero"
  s = s.replace(/\b([\p{L}]+)\b(?:(?:\s+|\s*[.,!?;:]+\s*)\1\b)+/giu, "$1");
  s = s.replace(/^[,;:!?…]+/, "").replace(/[,;:!?….]+$/, "");
  s = s.replace(/\s{2,}/g, " ").trim();
  return s;
}

// Fala de fundo/solta (interjeições e confirmações rápidas) que não deve
// acionar o núcleo nem gerar resposta — a menos que seja sim/não de uma
// confirmação pendente (tratada antes deste filtro).
const NOISE_ACK_WORDS = new Set([
  "ah", "a", "e", "é", "o", "u", "oh", "hmm", "hm", "hum", "uh", "hã", "ahn",
  "tá", "tá bom", "ta", "ta bom", "beleza", "blz", "ok", "okay", "opa", "eita",
  "vixe", "oxe", "bah", "perfeito", "exato", "exatamente", "isso", "isso mesmo",
  "tranquilo", "certo", "fechado", "fechou", "anotado", "entendi", "entendido",
  "entendeu", "vai", "legal", "top", "massa", "show", "demais", "bora", "nada",
  "gente", "senhor", "meu", "cara", "x", "nt",
]);
const GREETING_RE =
  /^(?:oi|ó|ola|hey|e ai|eai|ei|bom dia|boa tarde|boa noite|alo)\b/i;

/** True se a frase é só ruído/interjeição (não é uma pergunta nem um pedido). */
export function isNoiseUtterance(raw: string): boolean {
  const s = normalizeUtterance(raw);
  if (!s) return false;
  const puro = s.toLocaleLowerCase("pt-BR").replace(/[.,!?…;:]$/, "").trim();
  if (NOISE_ACK_WORDS.has(puro)) return true;
  // Letra única repetida ("aaaa", "ehhh"…) — só ruído
  if (/^([a-záàâãéêíóôõúùüç])\1{2,}$/i.test(puro)) return true;
  // Fragmentos minúsculos do reconhecimento ("ta", "aa"…) — mas nunca saudações
  // nem as confirmações "sim"/"não" (que respondem a uma pergunta pendente)
  if (
    puro.length <= 3 &&
    puro !== "sim" &&
    puro !== "não" &&
    puro !== "nao" &&
    /^[a-záàâãéêíóôõúûçü]+$/i.test(puro) &&
    !GREETING_RE.test(s)
  ) {
    return true;
  }
  return false;
}

/** True quando a frase é APENAS um agradecimento ("obrigado", "valeu"). */
export function isGratitude(raw: string): boolean {
  const b = (raw ?? "").trim();
  if (!b) return false;
  if (!/^(?:(?:muito\s+)?(?:obrigad[oa][sç]?|obrigad[aã]o|brigad[oa]s?|brigad[aã]o|valeu|agradecid[oa]s?|agrade[çc]o|gr[ãa]t[oa]s?)[.!?,]?\s*)+$/i.test(b)) {
    return false;
  }
  return normalizeUtterance(b).length === 0;
}

/**
 * Casa a frase falada com um atalho de site salvo: "abre meu painel",
 * "vai para o meu painel", "abre a página meu painel" ou só "meu painel".
 * Exported para os testes de roteamento.
 */
export function matchCustomSite(trimmed: string): SiteAtalho | null {
  const sites = getCustomSites();
  if (sites.length === 0) return null;
  const fala = normWord(trimmed).replace(/[.,;!?]+$/g, "");
  if (!fala) return null;
  const verbs =
    "(?:abre|abra|abrir|acessa|acesse|acessar|vai\\s+para|v[aá]\\s+para|va\\s+para|ir\\s+para|mostra|mostre|exibe|exiba|abre\\s+o|abrir\\s+o|abre\\s+a|abrir\\s+a)";
  for (const site of sites) {
    const nome = normWord(site.nome);
    if (!nome) continue;
    const esc = nome.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const pattern = new RegExp(
      `^${verbs}\\s+(?:o\\s+|a\\s+|site\\s+|p[aá]gina\\s+|portal\\s+|plataforma\\s+)?${esc}$`,
    );
    if (pattern.test(fala) || fala === nome) return site;
  }
  return null;
}

