/**
 * Extrai a consulta musical de "toca músicas do X" / "quero ouvir X" …
 * Devolve null quando a intenção é VÍDEO (deixa o fluxo do YouTube seguir).
 */
export function parseMusicQuery(text: string): string | null {
  const t = text;
  // Guarda: intenção de vídeo ou do YouTube externo → NÃO é o player do HUD
  if (/\b(?:no\s+youtube|no\s+site\s+do\s+youtube)\b|\b(?:v[ií]deo|v[ií]deos|clipe|clipes)\b/i.test(t)) return null;
  let m: RegExpMatchArray | null =
    // "toca músicas do X" · "tocar as músicas de X" · "toca um pouco de X"
    t.match(
      /^(?:toca|toque|tocar|coloque|coloca|colocar|ponha|p[õo]e|liga|ligue|ative|ativa)\s+(?:(?:as|umas|algumas|um\s+pouco\s+de|um\s+pouco\s+da|um\s+pouco\s+do)\s+)?(?:m[úu]sicas|musicas)\s+(?:do|da|de|sobre|com)\s+(.+)$/i,
    ) ??
    // "toca playlist de X" · "toca uma playlist de X"
    t.match(
      /^(?:toca|toque|tocar|coloque|coloca|colocar|ponha|p[õo]e|liga|ligue)\s+(?:uma\s+)?playlist\s+(?:do|da|de|sobre|com)\s+(.+)$/i,
    ) ??
    // "toca o álbum X de Y" · "toca álbum de X"
    t.match(
      /^(?:toca|toque|tocar|coloque|coloca|colocar|ponha|p[õo]e|liga|ligue)\s+(?:o\s+|um\s+)?(?:[áa]lbum|album)\s+(?:(?:de|do|da|completo\s+de|completo\s+do|completo\s+da)\s+)?(.+)$/i,
    ) ??
    // "toca música do X" (coletivo, sem artigo) · "toca música de X"
    t.match(
      /^(?:toca|toque|tocar|coloque|coloca|colocar|ponha|p[õo]e)\s+m[úu]sica\s+(?:do|da|de|sobre|com)\s+(.+)$/i,
    ) ??
    // "tocar um pouco de jazz" / "toca um pouco de X" (sem a palavra música)
    t.match(/^(?:toca|toque|tocar|coloque|coloca|colocar|ponha|p[õo]e)\s+um\s+pouco\s+(?:de|da|do)\s+(.+)$/i) ??
    // "quero ouvir X" · "queria ouvir X" · "quero escutar X"
    t.match(/^(?:quero|queria|gostaria\s+de)\s+(?:ouvir|escutar)\s+(.+)$/i);
  // Música ambiente/fundo → busca padrão de foco
  if (/^(?:toca|toque|tocar|coloque|coloca|colocar|ponha|p[õo]e)\s+m[úu]sica\s+(?:de\s+fundo|ambiente|de\s+relaxamento|pra\s+relaxar)$/i.test(t)) {
    return "música relaxante para foco";
  }
  if (!m) return null;
  const q = (m[1] ?? "").trim().replace(/[.,;!?]+$/, "");
  return q.length > 0 && q.length <= 120 ? q : null;
}

// ——— Helpers de timer ———
/** Soma durações compostas ("1 hora e 30 minutos" → 90 min). Retorna null se nada bater. */
function parseDuration(raw: string): number | null {
  const parts = raw.matchAll(
    /(\d+(?:[.,]\d+)?)\s*(segundos?|seg|s|minutos?|min|horas?|h)\b/gi,
  );
  let total = 0;
  let found = false;
  for (const m of parts) {
    const v = parseFloat(m[1].replace(",", "."));
    if (!Number.isFinite(v) || v <= 0) continue;
    const unit = (m[2] ?? "").toLowerCase();
    if (unit.startsWith("h")) total += v * 3600_000;
    else if (unit.startsWith("min")) total += v * 60_000;
    else total += v * 1000;
    found = true;
  }
  return found ? total : null;
}

function formatDuration(ms: number): string {
  const totalSec = Math.round(ms / 1000);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  const parts: string[] = [];
  if (h) parts.push(`${h} hora${h > 1 ? "s" : ""}`);
  if (m) parts.push(`${m} minuto${m > 1 ? "s" : ""}`);
  if (s && !h) parts.push(`${s} segundo${s > 1 ? "s" : ""}`);
  return parts.join(" e ") || `${totalSec} segundos`;
}

/** Reconhece "timer de X", "lembrete em X para Y", "me lembre de Y em X". */
function parseTimerCommand(
  text: string,
): { ms: number; label: string; kind: "timer" | "reminder" } | null {
  const t = text.trim();
  const timerM = t.match(
    /^(?:cria|create|marca|marque|dispara|dispare|inicia|inicie|vou querer|quero)?\s*(?:um\s+)?timer\s+de\s+(.+)$/i,
  );
  if (timerM) {
    const ms = parseDuration(timerM[1]);
    if (ms) return { ms, label: "timer", kind: "timer" };
  }
  const rem1 = t.match(/^(?:lembrete|alarme)\s+(?:em|daqui a)\s+(.+?)\s+(?:para|pra)\s+(.+)$/i);
  if (rem1) {
    const ms = parseDuration(rem1[1]);
    const label = rem1[2].trim();
    if (ms && label) return { ms, label, kind: "reminder" };
  }
  const rem2 = t.match(/^(?:me\s+lembre|me\s+lembra|me\s+avise)\s+de\s+(.+?)\s+(?:em|daqui a)\s+(.+)$/i);
  if (rem2) {
    const ms = parseDuration(rem2[2]);
    const label = rem2[1].trim();
    if (ms && label) return { ms, label, kind: "reminder" };
  }
  const rem3 = t.match(/^(?:em|daqui a)\s+(.+?)\s+(?:me\s+lembre|me\s+lembra|me\s+avise)\s+de\s+(.+)$/i);
  if (rem3) {
    const ms = parseDuration(rem3[1]);
    const label = rem3[2].trim();
    if (ms && label) return { ms, label, kind: "reminder" };
  }
  return null;
}

// ——— Helpers de clipboard (client-side) ———
async function copyToClipboard(text: string): Promise<string> {
  if (!text) return "O que devo copiar?";
  try {
    if (typeof navigator === "undefined" || !navigator.clipboard) {
      return "Não consigo acessar a área de transferência neste navegador.";
    }
    await navigator.clipboard.writeText(text);
    return `Copiei para a área de transferência: ${text.slice(0, 80)}.`;
  } catch {
    return "Não consegui copiar. Talvez o navegador tenha bloqueado o acesso à área de transferência.";
  }
}

async function readClipboard(): Promise<string> {
  try {
    if (typeof navigator === "undefined" || !navigator.clipboard) {
      return "Não consigo acessar a área de transferência neste navegador.";
    }
    const text = await navigator.clipboard.readText();
    if (!text) return "A área de transferência está vazia.";
    return `Na área de transferência está: ${text.slice(0, 200)}.`;
  } catch {
    return "Não consegui ler a área de transferência.";
  }
}

export function createAssistant(callbacks: AssistantCallbacks): Assistant {
  // Contador de chamadas em voo: só notifica “livre” quando todas terminam,
  // evitando que uma pergunta cancelada pela resposta zere o busy no meio do fluxo.
  let inFlight = 0;
  let pendingToken: string | null = null;
  let muted = false;
  const timers: TimerInfo[] = [];

  // Barge-in: momento em que o usuário começou a falar. Usado para processar a
  // frase mesmo que a fala anterior ainda esteja terminando de ser cancelada.
  let lastBargeAt = 0;

  // Fala somente se o usuário não mandou “sem som”.
  const say = async (reply: string) => {
    if (!muted) await speak(reply);
  };

  // Sincroniza o token pendente com o HUD (indicador “AGUARDANDO CONFIRMAÇÃO”)
  const setPending = (token: string | null) => {
    pendingToken = token;
    callbacks.onConfirming(token !== null);
  };

  const begin = () => {
    inFlight += 1;
    callbacks.onBusy(true);
  };
  const end = () => {
    inFlight = Math.max(0, inFlight - 1);
    if (inFlight === 0) callbacks.onBusy(false);
  };

  const handleText = async (text: string) => {
    // Limpa a fala antes de tudo: cortesia, gagueira e pontuação ficam de
    // fora da intenção (nunca entram em agenda, memória ou no modelo).
    const trimmed = normalizeUtterance(text).trim();

    // Comando de mudo: funciona no meio de uma fala (corta na hora) e silencia depois
    if (MUTE_WORDS.test(trimmed)) {
      muted = true;
      begin();
      try {
        setSpeechBlocked(true);
        callbacks.onTranscript(trimmed);
        callbacks.onReply("SOM DESLIGADO");
      } finally {
        end();
      }
      return;
    }
    if (UNMUTE_WORDS.test(trimmed)) {
      muted = false;
      begin();
      try {
        setSpeechBlocked(false);
        callbacks.onTranscript(trimmed);
        const reply = "Tá bom, vou falar de novo.";
        callbacks.onReply(reply);
        await speak(reply);
      } finally {
        end();
      }
      return;
    }

    // Pedido para digitar URL/@ na interface: abre a caixa de texto sem processos o comando
    if (TYPE_REQUEST_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Pode digitar a URL ou o @ do Instagram aqui na tela que eu acesso.";
        callbacks.onReply(reply);
        callbacks.onRequestInput?.();
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Nível de humor/sarcasmo do ARES por voz (0–100%) ———
    if (HUMOR_PCT_WORDS.test(trimmed)) {
      const m = trimmed.match(/(\d{1,3})/);
      const alvo = Math.max(0, Math.min(100, parseInt(m?.[1] ?? "0", 10)));
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const nivel = setHumorLevel(alvo);
        const reply = `Humor ajustado em ${nivel} por cento.`;
        callbacks.onReply(reply);
        callbacks.onHumorLevel?.(nivel);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (HUMOR_SERIO_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        setHumorLevel(0);
        const reply = "Modo sério ativado. Sarcasmo em zero por cento.";
        callbacks.onReply(reply);
        callbacks.onHumorLevel?.(0);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (HUMOR_MAXIMO_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        setHumorLevel(100);
        const reply = "Modo brincalhão ativado. Sarcasmo no máximo.";
        callbacks.onReply(reply);
        callbacks.onHumorLevel?.(100);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (HUMOR_MAIS_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const nivel = adjustHumorLevel(20);
        const reply = `Sarcasmo aumentado para ${nivel} por cento.`;
        callbacks.onReply(reply);
        callbacks.onHumorLevel?.(nivel);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (HUMOR_MENOS_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const nivel = adjustHumorLevel(-20);
        const reply = `Sarcasmo reduzido para ${nivel} por cento.`;
        callbacks.onReply(reply);
        callbacks.onHumorLevel?.(nivel);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (HUMOR_STATUS_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const nivel = getHumorLevel();
        const reply = `Meu nível de humor está em ${nivel} por cento.`;
        callbacks.onReply(reply);
        callbacks.onHumorLevel?.(nivel);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    // ——— Janela WHATSAPP do HUD (sessão real do whatsapp-web.js) ———
    if (WHATSAPP_OPEN_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply =
          "Abri o WhatsApp no painel. Se for a primeira vez, escaneie o QR code com o celular para conectar a sessão.";
        callbacks.onReply(reply);
        callbacks.onPanel?.("whatsapp", "abrir");
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (WHATSAPP_CLOSE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Fechei o WhatsApp.";
        callbacks.onReply(reply);
        callbacks.onPanel?.("whatsapp", "fechar");
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Janela CALENDÁRIO do HUD (agenda sincronizada com a memória) ———
    if (CALENDAR_OPEN_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Abri o calendário no painel. Ele está sincronizado com a sua memória — marca novos compromissos por voz ou no próprio calendário.";
        callbacks.onReply(reply);
        callbacks.onPanel?.("calendario", "abrir");
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (CALENDAR_CLOSE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Fechei o calendário.";
        callbacks.onReply(reply);
        callbacks.onPanel?.("calendario", "fechar");
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Câmera do HUD (hand tracking + rPPG) e modo interface ———
    if (CAMERA_ABRIR_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply =
          "Ligando a câmera. Mostre uma mão para ela: a pinça entre polegar e indicador gira o orbe, e as duas mãos afastando ou aproximando dão zoom. No modo interface, as mãos controlam os painéis do HUD.";
        callbacks.onReply(reply);
        callbacks.onCamera?.("abrir");
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (CAMERA_FECHAR_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Desliguei a câmera.";
        callbacks.onReply(reply);
        callbacks.onCamera?.("fechar");
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (INTERFACE_MODE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply =
          "Modo interface ativado. Com a mão em pinça, arraste os painéis do HUD; afaste ou aproxime as duas mãos para redimensionar o painel selecionado. Diga sai do modo interface para voltar.";
        callbacks.onReply(reply);
        callbacks.onInterfaceMode?.(true);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (INTERFACE_EXIT_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Saindo do modo interface. As mãos voltam a controlar o orbe.";
        callbacks.onReply(reply);
        callbacks.onInterfaceMode?.(false);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (SAUDE_STATUS_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Vou verificar seus batimentos pela câmera.";
        callbacks.onReply(reply);
        callbacks.onSaudeStatus?.();
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Janela de catálogo de comandos (mostrar comandos) ———
    if (COMANDOS_OPEN_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Abri a lista de comandos no painel. Diga o nome de um comando para saber como usá-lo.";
        callbacks.onReply(reply);
        callbacks.onComandos?.(true);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (COMANDOS_CLOSE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Fechei a lista de comandos.";
        callbacks.onReply(reply);
        callbacks.onComandos?.(false);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Janela REGISTRO DE AÇÕES (tabela de falhas) ———
    if (ERROS_OPEN_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Abri o registro de ações no painel. Ele mostra as tarefas que não consegui executar e o motivo.";
        callbacks.onReply(reply);
        callbacks.onErros?.(true);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (ERROS_CLOSE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Fechei o registro de ações.";
        callbacks.onReply(reply);
        callbacks.onErros?.(false);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Recolher/expandir o painel de comandos (collapse) ———
    if (CONTROLS_COLLAPSE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Recolhi o painel de comandos.";
        callbacks.onReply(reply);
        callbacks.onControlsCollapse?.(true);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (CONTROLS_EXPAND_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Expandi o painel de comandos.";
        callbacks.onReply(reply);
        callbacks.onControlsCollapse?.(false);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Player de áudio do HUD (música do YouTube — só o áudio) ———
    if (MUSIC_OPEN_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Abri o player de música. Diga o que você quer ouvir.";
        callbacks.onReply(reply);
        callbacks.onMusic?.({ tipo: "abrir", query: "" });
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    const musicQuery = parseMusicQuery(trimmed);
    if (musicQuery) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = `Vou buscar ${musicQuery} e tocar no player de música.`;
        callbacks.onReply(reply);
        callbacks.onMusic?.({ tipo: "abrir", query: musicQuery });
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (MUSIC_PAUSE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Pausei a música.";
        callbacks.onReply(reply);
        callbacks.onMusic?.({ tipo: "controle", acao: "pause" });
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (MUSIC_PLAY_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Voltei a tocar a música.";
        callbacks.onReply(reply);
        callbacks.onMusic?.({ tipo: "controle", acao: "play" });
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (MUSIC_NEXT_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Pulando para a próxima música.";
        callbacks.onReply(reply);
        callbacks.onMusic?.({ tipo: "controle", acao: "proxima" });
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (MUSIC_PREV_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Voltando para a música anterior.";
        callbacks.onReply(reply);
        callbacks.onMusic?.({ tipo: "controle", acao: "anterior" });
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (MUSIC_VOLUME_UP_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        callbacks.onMusic?.({ tipo: "controle", acao: "volume", valor: 10 });
        const reply = "Aumentei o volume.";
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (MUSIC_VOLUME_DOWN_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        callbacks.onMusic?.({ tipo: "controle", acao: "volume", valor: -10 });
        const reply = "Diminui o volume.";
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (MUSIC_CLOSE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Fechei o player de música.";
        callbacks.onReply(reply);
        callbacks.onMusic?.({ tipo: "fechar" });
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Atalhos personalizados de sites (MEUS SITES da janela COMANDOS) ———
    // Roda DEPOIS dos comandos nativos do HUD (editor/explorer/terminal/
    // música/mapa) para não roubar frases como "abre o terminal"
    // caso o usuário salve um atalho com o mesmo nome.
    const customSite = matchCustomSite(trimmed);
    if (customSite) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        let url = customSite.url;
        if (!/^https?:\/\//i.test(url)) url = `https://${url}`;
        const reply = `Abri o site ${customSite.nome} no navegador.`;
        callbacks.onReply(reply);
        callbacks.onOpenUrl?.(url);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Resumo de documento (resume o documento X) ———
    const resumoM = trimmed.match(
      /^(?:resume|resuma|resumir|faz\s+um\s+resumo\s+de|faça\s+um\s+resumo\s+de|me\s+resume|me\s+resuma|fala\s+um\s+resumo\s+de)\s+(?:o\s+|a\s+)?(?:documento|arquivo|texto)?\s*(.+)$/i,
    );
    if (resumoM) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const caminho = (resumoM[1] ?? "").trim().replace(/[.,;!?]+$/, "");
        if (!caminho) {
          const reply = "Qual documento você quer que eu resuma? (ex.: resume o documento C:/meus/arquivo.docx)";
          callbacks.onReply(reply);
          await say(reply);
          return;
        }
        callbacks.onReply(`Vou resumir ${caminho}…`);
        await say(`Vou resumir o documento ${caminho}. Um momento.`);
        const res = await fetch(`/api/resumo?path=${encodeURIComponent(caminho)}`);
        const data = (await res.json().catch(() => null)) as {
          ok?: boolean;
          message?: string;
          nome?: string;
          resumo?: string;
          stats?: { palavras?: number; linhas?: number };
        } | null;
        if (!res.ok || !data || !data.ok || !data.resumo) {
          const reply = data?.message ?? "Não consegui resumir esse arquivo.";
          callbacks.onReply(reply);
          await say(reply);
          return;
        }
        const reply = `Resumo de ${data.nome ?? caminho}: ${data.resumo}`;
        callbacks.onReply(reply);
        await say(reply.slice(0, 1100));
      } finally {
        end();
      }
      return;
    }

    // ——— Timer / lembrete (client-side, sem servidor) ———
    const timerCmd = parseTimerCommand(trimmed);
    if (timerCmd) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const t: TimerInfo = {
          id: `t${Date.now()}`,
          label: timerCmd.label,
          kind: timerCmd.kind,
          endsAt: Date.now() + timerCmd.ms,
          totalMs: timerCmd.ms,
        };
        timers.push(t);
        callbacks.onTimers?.(timers.map((x) => ({ ...x })));
        window.setTimeout(() => fireTimer(t.id), timerCmd.ms);
        const reply =
          timerCmd.kind === "timer"
            ? `Timer de ${formatDuration(timerCmd.ms)} iniciado.`
            : `Lembrete marcado para ${formatDuration(timerCmd.ms)}: ${timerCmd.label}.`;
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Cancelar timers/lembretes ———
    if (
      /^(?:cancela|cancelar|para|pare|remove|remover|apaga|apagar)\s+(?:todos\s+os\s+)?(?:timers?|lembretes?|alarmes?)\b/i.test(
        trimmed,
      )
    ) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const count = timers.length;
        timers.length = 0;
        callbacks.onTimers?.([]);
        const reply = count
          ? `Cancelei ${count} timer${count > 1 ? "s" : ""}.`
          : "Não tenho nenhum timer ativo.";
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Clipboard: copiar (escrever) ———
    const copyCmd = trimmed.match(
      /^(?:copia|copie|copiar|guarda no clipboard|salva no clipboard|cola isso)\s+(.+)$/i,
    );
    if (copyCmd) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const text = (copyCmd[1] ?? "").trim().replace(/[.,;!?]+$/, "");
        const reply = await copyToClipboard(text);
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Clipboard: colar (ler) ———
    if (
      /^(?:cola|cole|colar|o que (?:esta|está|tem) (?:na area de transferencia|na área de transferência|no clipboard)|me (?:diz|diga) o que (?:copiei|copiou)|o que copiei)\b/i.test(
        trimmed,
      )
    ) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = await readClipboard();
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Controle financeiro (voz local + /api/finance) ———
    if (FINANCE_ADD_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const valor = extrairValorFinanceiro(trimmed);
        if (!valor) {
          const reply =
            "Não entendi o valor. Diga por exemplo: adiciona despesa de 50 reais em alimentação.";
          callbacks.onReply(reply);
          await say(reply);
          return;
        }
        const tipo = extrairTipoFinanceiro(trimmed);
        const categoria = extrairCategoriaFinanceira(trimmed);
        const res = await fetch("/api/finance", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            acao: "add",
            tipo,
            valor,
            categoria,
            descricao: descricaoFinanceira(trimmed),
          }),
        });
        const data = (await res.json().catch(() => null)) as { message?: string } | null;
        const reply = data?.message ?? "Registrei o lançamento financeiro.";
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (FINANCE_SUMMARY_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const res = await fetch("/api/finance");
        const data = (await res.json().catch(() => null)) as { falado?: string } | null;
        const reply =
          data?.falado ??
          "Ainda não tenho lançamentos registrados. Diga por exemplo: adiciona despesa de 50 reais em alimentação.";
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (FINANCE_REMOVE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const ref = trimmed.match(/#\d+/)?.[0] ?? trimmed;
        const res = await fetch("/api/finance", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ acao: "remove", ref }),
        });
        const data = (await res.json().catch(() => null)) as { message?: string } | null;
        const reply = data?.message ?? "Removi o lançamento.";
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Identidade e rede P2P (outras IAs) ———
    if (IDENTIDADE_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const id = estadoIdentidade();
        const idPublico = id.idPublico || "ainda não criada";
        const reply = `Minha identidade é ${idPublico}. Abri o painel de identidade para você ver o fingerprint e a senha.`;
        callbacks.onReply(reply);
        callbacks.onIdentidade?.();
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (PEER_ABRIR_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply =
          "Abri o chat. Gere um convite e envie para a outra IA, ou cole o convite que ela te enviou — a identidade é verificada criptograficamente.";
        callbacks.onReply(reply);
        callbacks.onPeer?.("abrir");
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (FINANCE_ABRIR_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Abri a planilha de finanças.";
        callbacks.onReply(reply);
        callbacks.onFinance?.(true);
        await say(reply);
      } finally {
        end();
      }
      return;
    }
    if (CHAT_ABRIR_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const reply = "Abri o chat.";
        callbacks.onReply(reply);
        callbacks.onChat?.(true);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // ——— Antecedência dos alertas de agenda ———
    if (ALERTA_ANTES_WORDS.test(trimmed)) {
      begin();
      try {
        callbacks.onTranscript(trimmed);
        const mins = Number(trimmed.match(ALERTA_ANTES_WORDS)?.[1] ?? "5");
        try {
          window.localStorage.setItem("ares-alerta-antes", String(Math.min(60, Math.max(1, mins))));
        } catch {
          /* sem storage */
        }
        const reply = `Ok, vou avisar ${mins} minutos antes de cada compromisso.`;
        callbacks.onReply(reply);
        await say(reply);
      } finally {
        end();
      }
      return;
    }

    // Deixa o usuário responder “sim”/“não” mesmo enquanto a pergunta ainda está sendo falada
    const answeringPending =
      pendingToken !== null &&
      (CONFIRM_WORDS.test(trimmed) || CANCEL_WORDS.test(trimmed));
    // Barge-in: se o usuário acabou de começar a falar, processa a frase mesmo
    // que a fala/processamento anterior ainda esteja sendo cancelado.
    const barging = Date.now() - lastBargeAt < 2000;
    if (inFlight > 0 && !answeringPending && !barging) return;
    callbacks.onTranscript(trimmed);
    // Fala de fundo/solta ("ok", "ah", "hum"…) não aciona o núcleo nem gera
    // resposta — a menos que seja o sim/não de uma confirmação pendente.
    if (!answeringPending && isNoiseUtterance(text)) return;
    // "Obrigado"/"valeu" soltos: resposta curta local, sem chamar o LLM nem
    // criar agenda/memória/tarefa com essas palavras.
    if (!pendingToken && isGratitude(text)) {
      const reply = "De nada! Sempre que precisar, é só chamar.";
      callbacks.onReply(reply);
      await say(reply);
      return;
    }
    begin();
    try {
      // Fluxo de confirmação: “sim” confirma o apagamento pendente; “não” cancela
      if (pendingToken && CANCEL_WORDS.test(trimmed)) {
        const reply = "Ok, cancelei a ação. Nada foi apagado.";
        setPending(null);
        callbacks.onReply(reply);
        await say(reply);
        return;
      }
      if (pendingToken && CONFIRM_WORDS.test(trimmed)) {
        const token = pendingToken;
        setPending(null);
        const res = await fetch("/api/confirm", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token }),
        });
        const data = (await res.json().catch(() => null)) as AgentResult | null;
        if (!res.ok || !data) {
          const reply = "Não consegui confirmar a ação. Tente novamente.";
          callbacks.onReply(reply);
          await say(reply);
          return;
        }
        callbacks.onReply(data.reply);
        if (data.logs) data.logs.forEach((l) => callbacks.onLog(l));
        else if (data.log) callbacks.onLog(data.log);
        await say(data.reply);
        return;
      }

      setPending(null);
      // Análise de sentimento: o ARES adapta o tom ao humor do usuário e
      // antecipa necessidades (média móvel — um texto sozinho não define tudo).
      const sent = analyzeSentiment(trimmed);
      const humorAtual = updateHumor(trimmed);
      callbacks.onHumor?.(humorAtual, humorLabel(humorAtual));
      const humorCtx = sentimentContext(trimmed);
      const res = await fetch("/api/ai", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: trimmed, humor: humorCtx }),
      });
      if (!res.ok) {
        const reply = "Ocorreu um erro no meu núcleo. Tente novamente.";
        callbacks.onReply(reply);
        await say(reply);
        return;
      }
      const data = (await res.json()) as AgentResult;
      // Antecipação: se o usuário está tenso/triste, reforça a sugestão de apoio
      const sugestoes = data.sugestoes ?? [];
      if (sugestoes.length === 0 && (getHumor() === "tenso" || getHumor() === "triste") && sent.score <= -0.2) {
        callbacks.onSuggestions?.(["Quer que eu te ajude a resolver isso?"]);
      } else {
        callbacks.onSuggestions?.(sugestoes);
      }
      if (data.needsConfirmation) {
        setPending(data.needsConfirmation.token);
        callbacks.onReply(data.reply);
        await say(data.reply);
      } else {
        callbacks.onReply(data.reply);
        if (data.logs) data.logs.forEach((l) => callbacks.onLog(l));
        else if (data.log) callbacks.onLog(data.log);
        await say(data.reply);
      }
    } finally {
      end();
    }
  };

  /** Dispara um timer vencido: remove da lista, avisa a UI e fala. */
  const fireTimer = (id: string) => {
    const idx = timers.findIndex((t) => t.id === id);
    if (idx < 0) return;
    const t = timers[idx];
    timers.splice(idx, 1);
    callbacks.onTimers?.(timers.map((x) => ({ ...x })));
    const msg =
      t.kind === "reminder"
        ? `Lembrete: ${t.label}.`
        : `O timer de ${formatDuration(t.totalMs)} terminou.`;
    callbacks.onTimerFired?.(t);
    void (async () => {
      if (!muted) await speak(msg);
    })();
  };

  const voice: VoiceListener = createVoiceListener({
    onListening: callbacks.onListening,
    onError: callbacks.onError,
    onInterim: (text) => callbacks.onTranscript(text),
    onSpeechStart: () => {
      // Só abre a janela de barge se havia fala de verdade sendo cortada
      // (senão um comando novo durante o “pensando” não vira processamento concorrente)
      if (cancelSpeech()) lastBargeAt = Date.now();
    },
    onFinal: (text) => {
      if (text.trim()) void handleText(text.trim());
    },
  });

  return {
    start() {
      voice.start();
    },
    stop() {
      voice.stop();
    },
    isListening: () => voice.isListening(),
    send(text) {
      // Digitar um comando enquanto o ARES fala também interrompe a fala
      if (cancelSpeech()) lastBargeAt = Date.now();
      if (text.trim()) void handleText(text.trim());
    },
    speak(text) {
      void say(text);
    },
    getTimers: () => timers.map((x) => ({ ...x })),
  };
}
