/** Converte um nome de tecla falado/digitado para a sintaxe do SendKeys. */
export function parseSpecialKey(raw: string): string | null {
  const n = (raw ?? "").toLowerCase().trim().replace(/\s+/g, " ");
  return SPECIAL_KEYS[n] ?? null;
}
