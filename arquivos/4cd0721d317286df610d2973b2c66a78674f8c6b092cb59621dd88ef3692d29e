/**
 * Teclas especiais do SendKeys (Windows) — módulo FOLHA, sem dependências.
 * O builtin de voz importa daqui em vez de puxar o tools.ts (que usa fs/os/
 * child_process e não pode entrar no bundle do cliente).
 */

/** Caracteres que o SendKeys interpreta como modificadores (precisam de chaves). */
const SENDKEYS_SPECIAL = /[+^%~(){}[\]]/g;

/** Escapa texto para o SendKeys: `+^%~(){}[]` viram `{+}` etc. Exportado para testes. */
export function sendKeysEscape(text: string): string {
  // Primeiro escapa os caracteres especiais; só depois troca quebras de linha
  // pelo comando {ENTER} (que não pode ser re-escapado).
  return text.replace(SENDKEYS_SPECIAL, (m) => `{${m}}`).replace(/\r?\n/g, "{ENTER}");
}

/** Texto 100% ASCII imprimível → vai direto pelo SendKeys (rápido). */
export function isSimpleAscii(s: string): boolean {
  return /^[\x20-\x7E]+$/.test(s);
}

