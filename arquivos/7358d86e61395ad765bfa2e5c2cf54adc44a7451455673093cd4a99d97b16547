import type { AgentResult, LogEntry, ToolCall, ToolName } from "./types";

function resultForCall(call: ToolCall): Promise<AgentResult> {
  return handleTool(call).then(({ reply, log, confirmation }) => {
    if (confirmation) {
      return { reply, needsConfirmation: confirmation };
    }
    return { reply, log };
  });
}

/** Extrai a linha \"Sugestão: ...\" do final da resposta e devolve fala limpa + sugestão. */
export function extractSuggestion(raw: string): { reply: string; sugestoes: string[] } {
  const sugestoes: string[] = [];
  let reply = (raw ?? "").trim();
  const m = reply.match(/^Sugest[aã]o:\s*(.+)$/im);
  if (m) {
    const s = m[1].trim().replace(/[.!]+$/, "").trim();
    if (s && s.length <= 120) sugestoes.push(s);
    reply = reply.replace(/^Sugest[aã]o:\s*.+$/im, "").trim();
  }
  if (!reply) reply = raw ?? "";
  return { reply, sugestoes };
}

