import { NextResponse } from "next/server";
import { listarRespostas, removerResposta } from "@/lib/agent/feedback";

export const runtime = "nodejs";

/**
 * Usuário consulta as respostas do dev ao feedback que enviou:
 *   GET    /api/feedback/respostas           → lista (mais recentes primeiro)
 *   DELETE /api/feedback/respostas?id=<id>   → remove UMA resposta
 *   DELETE /api/feedback/respostas           → limpa todas
 */
export async function GET() {
  return NextResponse.json({ respostas: listarRespostas() });
}

export async function DELETE(req: Request) {
  const url = new URL(req.url);
  const idRaw = url.searchParams.get("id");
  if (idRaw !== null) {
    const id = Number(idRaw);
    if (!Number.isFinite(id)) {
      return NextResponse.json({ ok: false, message: "Id inválido." }, { status: 400 });
    }
    return NextResponse.json(removerResposta(id));
  }
  return NextResponse.json({ ok: true, message: "Respostas limpas." });
}
