import { NextRequest, NextResponse } from "next/server";
import { resolveAudioUrl, searchMusicFast, ytDlpStatus } from "@/lib/agent/music";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

const UA =
  "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36";

/**
 * Player de áudio do HUD (música do YouTube — só o áudio, sem o vídeo).
 *
 * GET ?action=status            → { ok, disponivel, instalando } (yt-dlp)
 * GET ?action=search&q=...      → { ok, faixas: MusicTrack[] } — busca no
 *                                 YouTube (álbuns completos quando possível)
 * GET ?action=prefetch&ids=...  → pré-resolve até 4 URLs de áudio (aquece o
 *                                 cache) para os próximos plays serem rápidos
 * GET ?action=stream&id=...     → proxy do stream de áudio (m4a/opus) com
 *                                 suporte a Range (o <audio> busca/arrasta).
 */

function fmtDuracao(s: number): string {
  if (!s || s <= 0) return "--:--";
  const m = Math.floor(s / 60);
  const sec = Math.floor(s % 60);
  return `${m}:${String(sec).padStart(2, "0")}`;
}

export async function GET(req: NextRequest) {
  const sp = req.nextUrl.searchParams;
  const action = sp.get("action") ?? "";

  if (action === "status") {
    const st = await ytDlpStatus();
    return NextResponse.json({ ok: true, ...st });
  }

  if (action === "search") {
    const q = (sp.get("q") ?? "").trim();
    if (!q) {
      return NextResponse.json({ ok: false, message: "O que você quer ouvir?" }, { status: 400 });
    }
    const st = await ytDlpStatus();
    if (!st.disponivel) {
      return NextResponse.json(
        {
          ok: false,
          message: st.instalando
            ? "Estou instalando o reprodutor de áudio (yt-dlp). Tente de novo em instantes."
            : "Não consegui ativar o reprodutor de áudio (yt-dlp não está disponível e o download automático falhou).",
        },
        { status: 501 },
      );
    }
    const { tracks: faixas, primeiroUrl } = await searchMusicFast(q);
    if (faixas.length === 0) {
      return NextResponse.json(
        { ok: false, message: `Não encontrei músicas para "${q}".` },
        { status: 404 },
      );
    }
    return NextResponse.json({
      ok: true,
      consulta: q,
      primeiroUrl,
      faixas: faixas.map((f) => ({ ...f, durLabel: fmtDuracao(f.duracao) })),
    });
  }

  if (action === "prefetch") {
    // Pré-resolve URLs de áudio (aquece o cache) para os próximos plays serem
    // quase instantâneos. Fire-and-forget: o cliente não precisa da resposta.
    const ids = (sp.get("ids") ?? "")
      .split(",")
      .map((s) => s.trim())
      .filter(Boolean)
      .slice(0, 4);
    if (ids.length === 0) return NextResponse.json({ ok: true, resolvidos: 0 });
    const resolvidos = (
      await Promise.all(
        ids.map(async (id) => {
          try {
            return (await resolveAudioUrl(id)) ? id : null;
          } catch {
            return null;
          }
        }),
      )
    ).filter((x): x is string => x !== null);
    return NextResponse.json({ ok: true, resolvidos: resolvidos.length });
  }

  if (action === "stream") {
    const id = (sp.get("id") ?? "").trim();
    if (!id) {
      return NextResponse.json({ ok: false, message: "Falta o id da música." }, { status: 400 });
    }
    const url = await resolveAudioUrl(id);
    if (!url) {
      return NextResponse.json(
        { ok: false, message: "Não consegui obter o áudio desta música." },
        { status: 502 },
      );
    }
    // Proxy do stream de áudio com Range passthrough (seek/arrastar da barra)
    const range = req.headers.get("range");
    const headers: Record<string, string> = { "User-Agent": UA, Accept: "*/*" };
    if (range) headers.Range = range;
    try {
      const up = await fetch(url, {
        headers,
        signal: req.signal,
        cache: "no-store",
      });
      if (!up.ok && up.status !== 206) {
        return NextResponse.json(
          { ok: false, message: `O YouTube recusou o áudio (HTTP ${up.status}).` },
          { status: 502 },
        );
      }
      if (!up.body) {
        return NextResponse.json({ ok: false, message: "Áudio sem conteúdo." }, { status: 502 });
      }
      const out: Record<string, string> = {
        "Content-Type": up.headers.get("content-type") ?? "audio/mp4",
        "Cache-Control": "no-store",
        "Accept-Ranges": "bytes",
      };
      const cr = up.headers.get("content-range");
      const cl = up.headers.get("content-length");
      if (cr) out["Content-Range"] = cr;
      if (cl) out["Content-Length"] = cl;
      return new Response(up.body as unknown as BodyInit, {
        status: up.status === 206 ? 206 : 200,
        headers: out,
      });
    } catch {
      return NextResponse.json({ ok: false, message: "Falha ao transmitir o áudio." }, { status: 502 });
    }
  }

  return NextResponse.json({ ok: false, message: "Ação desconhecida." }, { status: 400 });
}
