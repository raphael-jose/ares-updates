/**
 * Feedback de usuários (sugestões do que melhorar/implementar).
 *
 * - O USUÁRIO envia pela janela REGISTRO DE AÇÕES (textarea + botão). O POST
 *   /api/feedback publica no MQTT (`ares/v1/feedback` — mesmo caminho da
 *   telemetria de erros, best-effort).
 * - O DEV recebe: assina o tópico no boot (máquina com ARES_ERROS_RECEBER=1
 *   ou ARES_DEV_MODE=1), persiste em `~/.ares/feedback.json` e a janela dele
 *   mostra a seção FEEDBACK RECEBIDO.
 */
import fs from "fs";
import fsp from "fs/promises";
import os from "os";
import path from "path";
import {
  MAX_TEXTO_FB,
  publicarFeedback,
  publicarRespostaFeedback,
  registrarReceptorFeedback,
  registrarReceptorResposta,
  type FeedbackRecebido,
  type RespostaRecebida,
} from "./errosMqtt";

/** Categorias que o dev pode atribuir a um feedback recebido (organização). */
export type FeedbackCategoria = "bug" | "sugestao" | "elogio" | "outro";

export const CATEGORIAS: { valor: FeedbackCategoria; rotulo: string }[] = [
  { valor: "bug", rotulo: "BUG" },
  { valor: "sugestao", rotulo: "SUGESTÃO" },
  { valor: "elogio", rotulo: "ELOGIO" },
  { valor: "outro", rotulo: "OUTRO" },
];

export interface FeedbackItem {
  id: number;
  de: string;
  hora: string;
  iso: string;
  texto: string;
  categoria?: FeedbackCategoria;
  /** Resposta do dev a este feedback (entregue ao usuário via MQTT). */
  resposta?: string;
  respostaHora?: string;
}

/** Resposta do dev recebida pelo usuário (persistida em feedback-respostas.json). */
export interface RespostaItem {
  id: number;
  de: string;
  hora: string;
  iso: string;
  texto: string;
}

const DIR = path.join(os.homedir(), ".ares");
const FILE = path.join(DIR, "feedback.json");
const FILE_RESPOSTAS = path.join(DIR, "feedback-respostas.json");
const MAX = 200;

// O arquivo em ~/.ares/feedback.json é a FONTE DA VERDADE: a recepção MQTT
// (instrumentation) e a rota /api/feedback podem rodar em instâncias de módulo
// diferentes no dev server, então NUNCA confiamos em cache em memória para
// leitura — cada chamada relê o disco (arquivo pequeno, 200 itens máx).
let writeQueue: Promise<void> = Promise.resolve();

function nowIso(): string {
  return new Date().toISOString();
}

function horaDe(iso: string): string {
  return new Date(iso).toLocaleTimeString("pt-BR", { hour12: false });
}

function ensureLoaded(): FeedbackItem[] {
  try {
    if (fs.existsSync(FILE)) {
      const raw = JSON.parse(fs.readFileSync(FILE, "utf8")) as unknown;
      return Array.isArray(raw)
        ? (raw as FeedbackItem[]).filter((f) => f && typeof f.texto === "string").slice(0, MAX)
        : [];
    }
  } catch {
    /* arquivo corrompido/ausente — lista vazia */
  }
  return [];
}

function scheduleSave(data: FeedbackItem[]): void {
  writeQueue = writeQueue.then(async () => {
    try {
      await fsp.mkdir(DIR, { recursive: true });
      await fsp.writeFile(FILE, JSON.stringify(data, null, 2), "utf8");
    } catch {
      /* best-effort */
    }
  });
}

function inserir(item: FeedbackItem): void {
  const data = ensureLoaded();
  data.unshift(item);
  if (data.length > MAX) data.length = MAX;
  scheduleSave(data);
}

/** Envia um feedback do usuário (publica no MQTT — best-effort). */
export function enviarFeedback(texto: string): void {
  try {
    publicarFeedback({
      hora: horaDe(nowIso()),
      texto,
    });
  } catch {
    /* best-effort */
  }
}

/** Feedback recebido pelo dev (mais recentes primeiro). */
export function listarFeedback(limite = 100): FeedbackItem[] {
  return ensureLoaded().slice(0, limite);
}

/** Remove UM feedback recebido pelo id (só o dev). */
export function removerFeedback(id: number): { ok: boolean; message: string } {
  const lista = ensureLoaded().filter((f) => f.id !== id);
  scheduleSave(lista);
  return { ok: true, message: "Feedback removido." };
}

/** Define a categoria de UM feedback recebido (só o dev). */
export function definirCategoria(
  id: number,
  categoria: FeedbackCategoria,
): { ok: boolean; message: string; encontrado: boolean } {
  const lista = ensureLoaded();
  const alvo = lista.find((f) => f.id === id);
  if (!alvo) return { ok: true, message: "Feedback não encontrado (pode ter sido removido).", encontrado: false };
  alvo.categoria = categoria;
  scheduleSave(lista);
  return { ok: true, message: "Categoria definida.", encontrado: true };
}

/** Responde a UM feedback (dev): guarda a resposta e a entrega ao usuário via MQTT. */
export function responderFeedback(
  id: number,
  texto: string,
): { ok: boolean; message: string; encontrado: boolean } {
  const limpo = texto.trim();
  if (!limpo) return { ok: false, message: "Escreva a resposta antes de enviar.", encontrado: false };
  const lista = ensureLoaded();
  const alvo = lista.find((f) => f.id === id);
  if (!alvo) return { ok: false, message: "Feedback não encontrado (pode ter sido removido).", encontrado: false };
  alvo.resposta = limpo.slice(0, MAX_TEXTO_FB);
  alvo.respostaHora = horaDe(nowIso());
  scheduleSave(lista);
  // Entrega ao usuário (tópico por instalação — best-effort)
  publicarRespostaFeedback(alvo.de, alvo.resposta);
  return { ok: true, message: "Resposta enviada ao usuário.", encontrado: true };
}

// ——— Respostas recebidas pelo USUÁRIO (persistidas localmente) ———

function ensureRespostas(): RespostaItem[] {
  try {
    if (fs.existsSync(FILE_RESPOSTAS)) {
      const raw = JSON.parse(fs.readFileSync(FILE_RESPOSTAS, "utf8")) as unknown;
      return Array.isArray(raw)
        ? (raw as RespostaItem[]).filter((r) => r && typeof r.texto === "string").slice(0, MAX)
        : [];
    }
  } catch {
    /* arquivo corrompido/ausente — lista vazia */
  }
  return [];
}

function scheduleSaveRespostas(data: RespostaItem[]): void {
  writeQueue = writeQueue.then(async () => {
    try {
      await fsp.mkdir(DIR, { recursive: true });
      await fsp.writeFile(FILE_RESPOSTAS, JSON.stringify(data, null, 2), "utf8");
    } catch {
      /* best-effort */
    }
  });
}

/** Respostas do dev recebidas por ESTA máquina (usuário). */
export function listarRespostas(limite = 50): RespostaItem[] {
  return ensureRespostas().slice(0, limite);
}

/** Liga a recepção de respostas no boot (todas as máquinas). */
export function ativarRespostas(): void {
  try {
    registrarReceptorResposta((r: RespostaRecebida) => {
      const iso = new Date(r.ts ?? Date.now()).toISOString();
      const lista = ensureRespostas();
      // Dedupe: o broker público pode reentregar a mesma resposta (QoS 0)
      const jaExiste = lista.some((x) => x.iso === iso && x.de === r.de && x.texto === r.texto);
      if (jaExiste) return;
      lista.unshift({
        id: (r.ts ?? Date.now()) * 100 + Math.floor(Math.random() * 90),
        de: r.de,
        hora: r.hora || horaDe(iso),
        iso,
        texto: r.texto,
      });
      if (lista.length > MAX) lista.length = MAX;
      scheduleSaveRespostas(lista);
    });
  } catch {
    /* best-effort */
  }
}

/** Limpa a lista de feedback recebido (só o dev). */
export function limparFeedback(): { ok: boolean; message: string } {
  scheduleSave([]);
  return { ok: true, message: "Feedback recebido limpo." };
}

/** Liga a recepção no boot: feedback remoto chega e é persistido (dev) e as
 *  respostas do dev chegam e são persistidas (todas as máquinas). */
export function ativarFeedback(): void {
  try {
    registrarReceptorFeedback((f: FeedbackRecebido) => {
      const iso = new Date(f.ts ?? Date.now()).toISOString();
      inserir({
        id: (f.ts ?? Date.now()) * 100 + Math.floor(Math.random() * 90),
        de: f.de,
        hora: f.hora || horaDe(iso),
        iso,
        texto: f.texto,
      });
    });
  } catch {
    /* best-effort */
  }
  ativarRespostas();
}


