/**
 * Conversão de medidas (comprimento, massa, volume, velocidade, tempo,
 * temperatura e dados) sem depender de API externa.
 */

type UnitKind =
  | "length"
  | "mass"
  | "volume"
  | "speed"
  | "time"
  | "data"
  | "temp";

interface UnitCode {
  kind: UnitKind;
  /** Fator para a unidade base (não usado em temperatura). */
  factor: number;
}

const norm = (s: string) =>
  s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();

// Alias → código canônico da unidade (as chaves já estão normalizadas)
const UNIT_ALIASES: Record<string, string> = {
