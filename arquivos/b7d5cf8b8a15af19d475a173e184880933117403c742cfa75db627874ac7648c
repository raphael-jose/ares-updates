  metro: "m", metros: "m", m: "m",
  quilometro: "km", quilometros: "km", kilometros: "km", km: "km",
  centimetro: "cm", centimetros: "cm", cm: "cm",
  milimetro: "mm", milimetros: "mm", mm: "mm",
  polegada: "in", polegadas: "in", in: "in",
  pe: "ft", pes: "ft", pezinhos: "ft", ft: "ft",
  jarda: "yd", jardas: "yd", yd: "yd",
  milha: "mi", milhas: "mi", mi: "mi",
  // Massa (base: quilograma)
  grama: "g", gramas: "g", g: "g",
  quilograma: "kg", quilogramas: "kg", quilo: "kg", quilos: "kg", kg: "kg",
  tonelada: "t", toneladas: "t", t: "t",
  libra: "lb", libras: "lb", lb: "lb",
  onca: "oz", oncas: "oz", oz: "oz",
  // Volume (base: litro)
  litro: "l", litros: "l", l: "l",
  mililitro: "ml", mililitros: "ml", ml: "ml",
  "metro cubico": "m3", "metros cubicos": "m3", m3: "m3",
  "centimetro cubico": "cm3", "centimetros cubicos": "cm3", cm3: "cm3",
  galao: "gal", galoes: "gal", gal: "gal",
  // Velocidade (base: m/s)
  "km/h": "kmh", "kmh": "kmh", "kph": "kmh",
  "quilometro por hora": "kmh", "quilometros por hora": "kmh",
  "m/s": "ms", "metros por segundo": "ms", "metro por segundo": "ms",
  mph: "mph", "milhas por hora": "mph", "milha por hora": "mph",
  // Tempo (base: segundo)
  segundo: "s", segundos: "s", s: "s",
  minuto: "min", minutos: "min", min: "min",
  hora: "h", horas: "h", h: "h",
  dia: "d", dias: "d",
  semana: "sem", semanas: "sem",
  // Dados (base: byte)
  byte: "b", bytes: "b", b: "b",
