import {
  FilesetResolver,
  HandLandmarker,
  type NormalizedLandmark,
} from "@mediapipe/tasks-vision";

const WASM_CDN =
  "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.35/wasm";
const MODEL_URL =
  "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task";

// Landmark indices (MediaPipe hand model)
const WRIST = 0;
const THUMB_TIP = 4;
const INDEX_TIP = 8;
const MIDDLE_MCP = 9;

// Pinch hysteresis: thumb–index distance relative to hand size
const PINCH_ON = 0.32;
const PINCH_OFF = 0.45;

// How strongly hand movement rotates the orb (radians per normalized unit)
const ROTATE_SPEED = 5.0;
// Smoothing factor for grab-point tracking (0..1, higher = snappier)
const SMOOTHING = 0.4;

export type GestureMode = "idle" | "spin" | "zoom";

export interface TrackerStatus {
  hands: number;
  mode: GestureMode;
}

export interface HandStateData {
  /** Ponto médio pinça dedo polegar-indicador (espelhado, normalizado 0..1). */
  x: number;
  y: number;
  pinching: boolean;
  /** Posição da ponta do indicador (espelhada, normalizada 0..1). */
  indexX: number;
  indexY: number;
}

export interface HandTrackerCallbacks {
  /** Called when a single pinched hand drags: deltas in mirrored normalized coords. */
  onRotate(deltaTheta: number, deltaPhi: number): void;
  /** Called when both hands pinch and spread/close: multiply camera distance by factor. */
  onZoom(factor: number): void;
  onStatus(status: TrackerStatus): void;
  /** Called on every frame with the hands data (always, no matter the mode). */
  onHands?(hands: HandStateData[]): void;
  /** Called when the user claps twice quickly (palms together, 2x in ~2s). */
  onDoubleClap?(): void;
  /** Called on each clap detected (count 1 ou 2) — usado para feedback na UI. */
  onClap?(count: number): void;
  /** Called in interface mode when two hands spread/close: multiply size by factor. */
  onResize?(factor: number): void;
}

interface Point {
  x: number;
  y: number;
}

interface HandState {
  pinching: boolean;
  grab: Point; // smoothed pinch midpoint, mirrored
}

export class HandTracker {
  private video: HTMLVideoElement;
  private overlay: HTMLCanvasElement;
  private callbacks: HandTrackerCallbacks;
  private landmarker: HandLandmarker | null = null;
  private stream: MediaStream | null = null;
  private rafId = 0;
  private running = false;
  private lastVideoTime = -1;

  // keyed by handedness label so state survives re-ordering between frames
  private handStates = new Map<string, HandState>();
  private prevMode: GestureMode = "idle";
  private prevSpinGrab: Point | null = null;
  private prevZoomDist: number | null = null;
  private lastStatus: TrackerStatus = { hands: 0, mode: "idle" };

  // Modo interface: as mãos controlam a interface em vez do orbe
  private interfaceMode = false;

  // Detecção de palma dupla (duas mãos fechando rápido)
  private prevHandsDist = 0;
  private clapCount = 0;
  private firstClapAt = 0;
  private lastClapFire = 0;

  // Redimensionar no modo interface (distância entre as mãos)
  private prevResizeDist: number | null = null;

  /** Timestamp em que as mãos deixaram de ser detectadas (para tolerar perda momentânea). */
  private handsLostAt = 0;

  /** True quando a automação de palma deve ignorar frames de palma (evita resize). */
  private skipClapFrame = false;

  constructor(
    video: HTMLVideoElement,
    overlay: HTMLCanvasElement,
    callbacks: HandTrackerCallbacks,
  ) {
    this.video = video;
    this.overlay = overlay;
    this.callbacks = callbacks;
  }

  /** Alterna o modo: orbe (padrão) ou interface (mãos controlam a UI). */
  setInterfaceMode(on: boolean): void {
    this.interfaceMode = on;
    this.prevSpinGrab = null;
    this.prevZoomDist = null;
    this.prevResizeDist = null;
  }

  isInterfaceMode(): boolean {
    return this.interfaceMode;
  }

  /**
   * Inicia o tracking. Se `preStream` for passado, usa o stream já aberto
   * (o HUD abre o vídeo e o rPPG antes — o BPM não depende do modelo de mãos).
   */
  async start(preStream?: MediaStream): Promise<void> {
    this.stream =
      preStream ??
      (await navigator.mediaDevices.getUserMedia({
        video: { width: 640, height: 480, facingMode: "user" },
        audio: false,
      }));
    this.video.srcObject = this.stream;
    await this.video.play();

    const fileset = await FilesetResolver.forVisionTasks(WASM_CDN);
    const options = {
      baseOptions: { modelAssetPath: MODEL_URL, delegate: "GPU" as const },
      runningMode: "VIDEO" as const,
      numHands: 2,
      minHandDetectionConfidence: 0.6,
      minHandPresenceConfidence: 0.6,
      minTrackingConfidence: 0.6,
    };
    try {
      this.landmarker = await HandLandmarker.createFromOptions(fileset, options);
    } catch {
      // Some browsers/GPUs reject the GPU delegate — fall back to CPU
      this.landmarker = await HandLandmarker.createFromOptions(fileset, {
        ...options,
        baseOptions: { ...options.baseOptions, delegate: "CPU" as const },
      });
    }

    this.running = true;
    this.loop();
  }

  stop(): void {
    this.running = false;
    cancelAnimationFrame(this.rafId);
    this.landmarker?.close();
    this.landmarker = null;
    this.stream?.getTracks().forEach((t) => t.stop());
    this.stream = null;
    this.video.srcObject = null;
    this.handStates.clear();
    this.prevMode = "idle";
    this.prevSpinGrab = null;
    this.prevZoomDist = null;
    const ctx = this.overlay.getContext("2d");
    ctx?.clearRect(0, 0, this.overlay.width, this.overlay.height);
    this.emitStatus({ hands: 0, mode: "idle" });
  }

  private loop = () => {
    if (!this.running) return;
    this.rafId = requestAnimationFrame(this.loop);

    if (!this.landmarker || this.video.readyState < 2) return;
    if (this.video.currentTime === this.lastVideoTime) return;
    this.lastVideoTime = this.video.currentTime;

    const result = this.landmarker.detectForVideo(this.video, performance.now());
    this.processHands(result.landmarks, result.handedness.map((h) => h[0]?.categoryName ?? "?"));
    this.drawOverlay(result.landmarks);
  };

  private processHands(
    landmarks: NormalizedLandmark[][],
    labels: string[],
  ): void {
    const pinchedGrabs: Point[] = [];
    const seen = new Set<string>();
    const handsData: HandStateData[] = [];

    landmarks.forEach((lm, i) => {
      const label = labels[i];
      seen.add(label);

      const handScale = dist2d(lm[WRIST], lm[MIDDLE_MCP]);
      if (handScale < 1e-6) return;
      const pinchRatio = dist2d(lm[THUMB_TIP], lm[INDEX_TIP]) / handScale;

      // Mirrored so hand-right = screen-right from the user's perspective
      const raw: Point = {
        x: 1 - (lm[THUMB_TIP].x + lm[INDEX_TIP].x) / 2,
        y: (lm[THUMB_TIP].y + lm[INDEX_TIP].y) / 2,
      };

      let state = this.handStates.get(label);
      if (!state) {
        state = { pinching: false, grab: raw };
        this.handStates.set(label, state);
      }

      // Hysteresis so the pinch doesn't flicker on/off at the threshold
      if (state.pinching && pinchRatio > PINCH_OFF) state.pinching = false;
      else if (!state.pinching && pinchRatio < PINCH_ON) state.pinching = true;

      state.grab = {
        x: state.grab.x + (raw.x - state.grab.x) * SMOOTHING,
        y: state.grab.y + (raw.y - state.grab.y) * SMOOTHING,
      };

      if (state.pinching) pinchedGrabs.push(state.grab);

      handsData.push({
        x: state.grab.x,
        y: state.grab.y,
        pinching: state.pinching,
        indexX: 1 - lm[INDEX_TIP].x,
        indexY: lm[INDEX_TIP].y,
      });
    });

    // Drop state for hands that left the frame
    for (const key of this.handStates.keys()) {
      if (!seen.has(key)) this.handStates.delete(key);
    }

    // Palma dupla: as duas mãos fechando rápido (palmas juntas) dentro de ~2s
    this.detectClap(handsData);

    // Envia os dados das mãos (a UI usa no modo interface)
    this.callbacks.onHands?.(handsData);

    if (this.interfaceMode) {
      this.handleInterfaceGestures(handsData);
      this.emitStatus({ hands: landmarks.length, mode: "idle" });
      return;
    }

    const mode: GestureMode =
      pinchedGrabs.length >= 2 ? "zoom" : pinchedGrabs.length === 1 ? "spin" : "idle";

    // Reset reference points on any mode change to avoid jumps
    if (mode !== this.prevMode) {
      this.prevSpinGrab = null;
      this.prevZoomDist = null;
      this.prevMode = mode;
    }

    if (mode === "spin") {
      const grab = pinchedGrabs[0];
      if (this.prevSpinGrab) {
        const dx = grab.x - this.prevSpinGrab.x;
        const dy = grab.y - this.prevSpinGrab.y;
        if (Math.abs(dx) > 1e-4 || Math.abs(dy) > 1e-4) {
          this.callbacks.onRotate(dx * ROTATE_SPEED, dy * ROTATE_SPEED);
        }
      }
      this.prevSpinGrab = grab;
    } else if (mode === "zoom") {
      const d = Math.hypot(
        pinchedGrabs[0].x - pinchedGrabs[1].x,
        pinchedGrabs[0].y - pinchedGrabs[1].y,
      );
      if (this.prevZoomDist && d > 1e-4) {
        // Spread hands apart -> factor < 1 -> camera moves closer
        const factor = Math.min(1.18, Math.max(0.85, this.prevZoomDist / d));
        this.callbacks.onZoom(factor);
      }
      this.prevZoomDist = d;
    }

    this.emitStatus({ hands: landmarks.length, mode });
  }

  /**
   * Detecção de palma: baseada em VELOCIDADE (aproximação rápida entre frames),
   * não em posição absoluta — assim funciona mesmo que o tracker perca uma das
   * mãos no instante do impacto. 2 palmas em ~2,4s = palma dupla.
   */
  private detectClap(hands: HandStateData[]): void {
    const now = performance.now();

    // Menos de 2 mãos: tolera perda momentânea (sobreposição no impacto);
    // só reseta a contagem se ficar sem as duas mãos por um tempo.
    if (hands.length < 2) {
      if (this.handsLostAt === 0) this.handsLostAt = now;
      if (now - this.handsLostAt > 700) {
        this.prevHandsDist = 0;
        this.clapCount = 0;
      }
      return;
    }

    const d = Math.hypot(
      hands[0].indexX - hands[1].indexX,
      hands[0].indexY - hands[1].indexY,
    );

    // Mãos voltaram a aparecer depois de uma perda: não conta palma na 1ª leitura
    if (this.handsLostAt !== 0) {
      this.handsLostAt = 0;
      this.prevHandsDist = d;
      return;
    }

    const prev = this.prevHandsDist;
    this.prevHandsDist = d;

    // Palma = mãos afastadas (prev > 0.25) que se aproximam rápido
    // (queda de >= 0.12 em um frame) OU chegam bem juntas (d < 0.13).
    const clapped =
      prev > 0.25 &&
      now - this.lastClapFire > 400 &&
      (d < prev - 0.12 || d < 0.13);

    if (!clapped) return;

    this.lastClapFire = now;
    this.skipClapFrame = true;
    if (this.clapCount === 0 || now - this.firstClapAt > 2400) {
      this.clapCount = 1;
      this.firstClapAt = now;
    } else {
      this.clapCount += 1;
      if (this.clapCount >= 2) {
        this.clapCount = 0;
        this.callbacks.onDoubleClap?.();
      }
    }
    this.callbacks.onClap?.(this.clapCount);
  }

  /** Modo interface: 1 mão em pinça arrasta; 2 mãos afastando/aproximando redimensiona. */
  private handleInterfaceGestures(hands: HandStateData[]): void {
    const now = performance.now();
    if (this.skipClapFrame && now - this.lastClapFire < 600) {
      this.prevResizeDist = null;
      return;
    }
    this.skipClapFrame = false;

    if (hands.length >= 2) {
      const a = hands[0];
      const b = hands[1];
      const d = Math.hypot(a.indexX - b.indexX, a.indexY - b.indexY);
      if (d > 0.2 && this.prevResizeDist && this.prevResizeDist > 0.2) {
        const factor = Math.min(1.12, Math.max(0.89, this.prevResizeDist / d));
        this.callbacks.onResize?.(factor);
      }
      this.prevResizeDist = d;
    } else {
      this.prevResizeDist = null;
    }
  }

  private emitStatus(status: TrackerStatus): void {
    if (
      status.hands !== this.lastStatus.hands ||
      status.mode !== this.lastStatus.mode
    ) {
      this.lastStatus = status;
      this.callbacks.onStatus(status);
    }
  }

  private drawOverlay(landmarks: NormalizedLandmark[][]): void {
    const ctx = this.overlay.getContext("2d");
    if (!ctx) return;
    const { width, height } = this.overlay;
    ctx.clearRect(0, 0, width, height);

    for (const lm of landmarks) {
      const thumb = lm[THUMB_TIP];
      const index = lm[INDEX_TIP];
      // Overlay canvas sits on the mirrored video preview, so mirror x here too
      const tx = (1 - thumb.x) * width;
      const ty = thumb.y * height;
      const ix = (1 - index.x) * width;
      const iy = index.y * height;

      const handScale = dist2d(lm[WRIST], lm[MIDDLE_MCP]);
      const pinched =
        handScale > 1e-6 && dist2d(thumb, index) / handScale < PINCH_ON;

      ctx.strokeStyle = pinched ? "#ffd54f" : "rgba(255,179,0,0.5)";
      ctx.lineWidth = pinched ? 2 : 1;
      ctx.beginPath();
      ctx.moveTo(tx, ty);
      ctx.lineTo(ix, iy);
      ctx.stroke();

      ctx.fillStyle = pinched ? "#ffd54f" : "rgba(255,179,0,0.7)";
      for (const [x, y] of [
        [tx, ty],
        [ix, iy],
      ]) {
        ctx.beginPath();
        ctx.arc(x, y, pinched ? 5 : 3, 0, Math.PI * 2);
        ctx.fill();
      }
    }
  }
}

function dist2d(a: NormalizedLandmark, b: NormalizedLandmark): number {
  return Math.hypot(a.x - b.x, a.y - b.y);
}
