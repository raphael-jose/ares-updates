// Onde os painéis HUD ficam por padrão (topo esquerdo → escala a partir do canto)
/**
 * Se o texto contém uma URL de imagem DIRETA (extensão de imagem ou host de
 * imagens conhecido), devolve essa URL — para o HUD abrir o visualizador.
 */
function extractImageUrl(text: string): string | null {
  const urls = text.match(/https?:\/\/[^\s"'<>]+/gi) ?? [];
  const IMG_HOST =
    /(?:upload\.wikimedia\.org|i\.imgur\.com|images\.unsplash\.com|cdn\.pixabay\.com|live\.staticflickr\.com|media\.istockphoto\.com|picsum\.photos|pbs\.twimg\.com|i\.ytimg\.com|image\.tmdb\.org|cdn\.images\.express\.co\.uk|images\.pexels\.com)$/i;
  for (const raw of urls) {
    const u = raw.replace(/[.,;:!?()\])]+$/g, "");
    try {
      const parsed = new URL(u);
      const path = parsed.pathname.toLowerCase();
      const isExt = /\.(jpe?g|png|gif|webp|bmp|avif)(\?|$)/.test(path);
      const isHost = IMG_HOST.test(parsed.hostname.toLowerCase());
      if (isExt || isHost) return u;
    } catch {
      /* URL inválida: segue para a próxima */
    }
  }
  return null;
}

/** Linha do modo leitura com os termos da busca destacados (<mark>). */
function EditorLineMark({ line, term }: { line: string; term: string }): ReactNode {
  if (!term) return <>{line || " "}</>;
  const lower = line.toLowerCase();
  const t = term.toLowerCase();
  const parts: ReactNode[] = [];
  let i = 0;
  let idx = 0;
  let key = 0;
  while ((idx = lower.indexOf(t, i)) !== -1) {
    if (idx > i) parts.push(<span key={key++}>{line.slice(i, idx)}</span>);
    parts.push(
      <mark key={key++} className="editor-find-hit">
        {line.slice(idx, idx + t.length)}
      </mark>,
    );
    i = idx + t.length;
  }
  if (i < line.length) parts.push(<span key={key++}>{line.slice(i)}</span>);
  return parts.length ? <>{parts}</> : (line || " ");
}

/** Quebra um caminho em segmentos clicáveis (C:/a/b → [C:, a, b]). */
function pathSegments(p: string): Array<{ nome: string; caminho: string }> {
  const parts = (p ?? "").split(/[\\/]+/).filter(Boolean);
  let acc = "";
  return parts.map((part) => {
    acc = acc ? `${acc}/${part}` : part;
    // Segmento de drive (C:) deve navegar para a raiz C:/
    if (/^[A-Za-z]:$/.test(acc)) acc = `${acc}/`;
    return { nome: part, caminho: acc };
  });
}

/** Probe de FPS oculto: só aparece com ?fps=1 na URL. Mostra FPS real + modo. */
function FpsProbe() {
  const [fps, setFps] = useState(0);
  const [info, setInfo] = useState("");

  useEffect(() => {
    if (typeof window === "undefined") return;
    if (!/fps=1/.test(window.location.search)) return;
    let frames = 0;
    let last = performance.now();
    let raf = 0;
    const update = () => {
      const c = document.querySelector("canvas");
      const eco =
        window.localStorage.getItem("ares-eco") === "1" ||
        /[?&]eco=1/.test(window.location.search);
      let ratio = "";
      if (c && c.clientWidth > 0) {
        ratio = ` · ratio ${(c.width / c.clientWidth).toFixed(2)}`;
      }
      setInfo((eco ? "ECO" : "NORMAL") + ratio);
    };
    const tick = (now: number) => {
      frames++;
      if (now - last >= 1000) {
        setFps(Math.round((frames * 1000) / (now - last)));
        frames = 0;
        last = now;
        update();
      }
      raf = requestAnimationFrame(tick);
    };
    update();
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, []);

  if (typeof window === "undefined") return null;
  if (!/fps=1/.test(window.location.search)) return null;
  return (
    <div className="fps-probe" title="Probe de FPS — tire ?fps=1 da URL para ocultar">
      {fps} FPS · {info}
    </div>
  );
}

/** Avatar determinístico: iniciais + cor derivada do ID (foto de perfil
 *  gerada automaticamente — sem precisar enviar imagem). */
function Avatar({ nome, id, tamanho = 32 }: { nome?: string; id: string; tamanho?: number }) {
  const base = (id || nome || "?").toLowerCase();
  let h = 7;
  for (let i = 0; i < base.length; i++) h = (h * 31 + base.charCodeAt(i)) >>> 0;
  const cores = [
    "#22d3ee",
    "#818cf8",
    "#f472b6",
    "#34d399",
    "#fbbf24",
    "#fb7185",
    "#a78bfa",
    "#2dd4bf",
  ];
  const cor = cores[h % cores.length];
  const iniciais =
    (nome || "")
      .split(/[\s#]+/)
      .map((p) => p[0] ?? "")
      .join("")
      .toUpperCase()
      .slice(0, 2) || "?";
  return (
    <span
      className="chat-avatar"
      style={{
        background: cor,
        width: tamanho,
        height: tamanho,
        fontSize: Math.round(tamanho * 0.4),
      }}
      aria-hidden="true"
    >
      {iniciais}
    </span>
  );
}

/** Senha interna gerada no cadastro — a identidade desbloqueia sozinha,
 *  sem o usuário nunca digitar senha (sem fluxo de desbloqueio). */
function gerarSenhaInterna(): string {
  const chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  let s = "";
  for (let i = 0; i < 24; i++) s += chars[Math.floor(Math.random() * chars.length)];
  return s;
}

