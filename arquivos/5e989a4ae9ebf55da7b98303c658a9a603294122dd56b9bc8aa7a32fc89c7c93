/** Estrutura mínima de um compromisso da agenda (sem importar o módulo node). */
interface AgendaItemLite {
  id: string;
  titulo: string;
  quando: number;
  recorrencia?: { frequencia: "diaria" | "semanal" | "mensal" };
}

/** Próxima ocorrência de um compromisso (a partir de `agora`), ou null. */
function proximaOcorrencia(
  e: AgendaItemLite,
  agora: number,
): number | null {
  if (!e.recorrencia) return e.quando >= agora - 30000 ? e.quando : null;
  let t = e.quando;
  const f = e.recorrencia.frequencia;
  let guard = 0;
  while (t < agora - 30000 && guard < 400) {
    if (f === "diaria") t += 86400000;
    else if (f === "semanal") t += 7 * 86400000;
    else {
      const d = new Date(t);
      d.setMonth(d.getMonth() + 1);
      t = d.getTime();
    }
    guard++;
  }
  return t;
}

