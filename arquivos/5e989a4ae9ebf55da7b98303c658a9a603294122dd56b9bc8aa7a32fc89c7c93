      setFbRespostaMsg("Erro de rede ao enviar a resposta.");
    }
    window.setTimeout(() => setFbRespostaMsg(""), 6000);
  }, []);

  // Dev: define a categoria de UM feedback (bug/sugestão/elogio/outro).
  const definirCategoriaFeedback = useCallback(async (id: number, categoria: string) => {
    setFeedbackRecebido((lista) =>
      lista.map((f) => (f.id === id ? { ...f, categoria } : f)),
    );
    setFbDetalhe((d) => (d && d.id === id ? { ...d, categoria } : d));
    try {
      await fetch(`/api/feedback?id=${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ categoria }),
      });
    } catch {
      /* best-effort */
    }
  }, []);

  // Resumo semanal de feedbacks por categoria (painel do dev).
  const fbResumo = useMemo(() => {
    const semanaMs = 7 * 86400000;
    const agora = Date.now();
    const linhas = FB_CATEGORIAS.map((c) => ({
      ...c,
      semana: 0,
      total: 0,
    }));
    for (const f of feedbackRecebido) {
      const cat = (f.categoria ?? "outro") as string;
      const linha = linhas.find((l) => l.valor === cat) ?? linhas[linhas.length - 1];
      linha.total += 1;
      const iso = (f as { iso?: string }).iso;
      if (!iso || agora - new Date(iso).getTime() <= semanaMs) linha.semana += 1;
    }
    const maxSemana = Math.max(1, ...linhas.map((l) => l.semana));
    return { linhas, maxSemana, total: feedbackRecebido.length };
  }, [feedbackRecebido]);

  // Apaga um contato (lista, conversas e conexão ativa).
  const apagarContato = useCallback((id: string) => {
    setContatos((c) => c.filter((x) => x.id !== id));
    setConversas((conv) => {
      const n = { ...conv };
      delete n[id];
      return n;
    });
    setChatSel((sel) => (sel === id ? null : sel));
    const pm = peerManagersRef.current.get(id);
    if (pm) {
      try {
        pm.fechar("contato apagado");
      } catch {
        /* já fechado */
      }
    }
    peerManagersRef.current.delete(id);
    setChatAviso("Contato apagado.");
    window.setTimeout(() => setChatAviso(""), 4000);
  }, []);

  // Bloqueia/desbloqueia um contato (mensagens entrantes ignoradas).
  // A chave de bloqueio é o ID público normalizado (chaveDe) — bate com o
  // remetente das mensagens entrantes mesmo antes do fingerprint ser preenchido.
  const alternarBloqueio = useCallback((id: string) => {
    const contato = contatosRef.current.find((x) => x.id === id);
    const chave = chaveDe(contato?.idPublico ?? contato?.nome ?? id);
    const tem = bloqueadosRef.current.includes(chave);
    const novo = tem ? bloqueadosRef.current.filter((x) => x !== chave) : [...bloqueadosRef.current, chave];
    bloqueadosRef.current = novo;
    setBloqueados(novo);
    try {
      window.localStorage.setItem("ares-bloqueados", JSON.stringify(novo));
    } catch {
      /* sem storage */
    }
    setChatAviso(tem ? "Contato desbloqueado." : "Contato bloqueado — mensagens dele serão ignoradas.");
    window.setTimeout(() => setChatAviso(""), 4000);
  }, []);

  const enviarChatRich = useCallback(
    (alvo: string | null, rico: PeerRich): Promise<boolean> | false => {
      const pm =
        (alvo && peerManagersRef.current.get(alvo)) || peerManagerRef.current;
      const destino = alvo ?? peerRemoto ?? null;
      const contatoAlvo = destino ? contatos.find((c) => c.id === destino) : undefined;
      const chave = chaveDe(contatoAlvo?.idPublico ?? contatoAlvo?.nome ?? destino ?? "");
      const nomeAlvo = contatoAlvo?.idPublico ?? contatoAlvo?.nome ?? "o contato";
      const minhaFp = estadoIdentidade().fingerprint || getInstanceId();
      const montarItem = (): ChatMensagem => ({
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        de: minhaFp,
        rico,
        ts: Date.now(),
        minha: true,
      });
      // Item ÚNICO por envio: o mesmo id vai para a fila, o estado e o wire
      // (o ACK do destinatário referencia exatamente esse id).
      const item = montarItem();
      // Mensagem salva na FILA (entrega garantida quando o contato voltar).
      const enfileirar = (msg: ChatMensagem) => {
        setFilaOffline((f) => ({ ...f, [chave]: [...(f[chave] ?? []), msg] }));
        if (destino) {
          setConversas((conv) => ({
            ...conv,
            [destino]: [...(conv[destino] ?? []), msg],
          }));
        }
        setPeerChat((c) => [...c, msg]);
      };
      if (!pm) {
        // Sem PeerManager (contato recém-adicionado): ainda dá para entregar
        // quando a conexão automática estabelecer.
        if (!destino) {
          setChatAviso("Adicione o ID de uma IA para conversar.");
          window.setTimeout(() => setChatAviso(""), 4000);
          return false;
        }
        enfileirar({ ...item, pendente: true });
        setChatAviso(`Mensagem salva — será entregue quando ${nomeAlvo} conectar.`);
        window.setTimeout(() => setChatAviso(""), 5000);
        return Promise.resolve(true);
      }
      // Conexão realmente morta (sem PC, falhou ou fechou): fila local.
      if (
        !pm.conectado &&
        (pm.estadoPc === "failed" || pm.estadoPc === "closed" || pm.estadoPc === "sem-pc")
      ) {
        enfileirar({ ...item, pendente: true });
        setChatAviso(`Mensagem salva — será entregue quando ${nomeAlvo} reconectar.`);
        window.setTimeout(() => setChatAviso(""), 5000);
        return Promise.resolve(true);
      }
      // Queda curta: o enviarRich reabre o canal e espera (até ~6s) antes de
      // desistir — a mensagem sai assim que a conexão volta.
      return pm.enviarRich(rico, item.id).then((ok) => {
        if (ok) {
          if (destino) {
            setConversas((conv) => ({
              ...conv,
              [destino]: [...(conv[destino] ?? []), item],
            }));
          }
          setPeerChat((c) => [...c, item]);
        } else {
          // Falhou mesmo após esperar: entra na fila em vez de se perder.
          enfileirar({ ...item, pendente: true });
          setChatAviso(`Sem conexão — mensagem salva e será entregue quando ${nomeAlvo} reconectar.`);
          window.setTimeout(() => setChatAviso(""), 5000);
        }
        return true;
      });
    },
    [peerRemoto, contatos],
  );

  const enviarChatTexto = useCallback(() => {
    const t = chatMsg.trim();
    if (!t) return;
    const prom = enviarChatRich(chatSel, { kind: "texto", texto: t });
    if (prom === false) return;
    // Limpa o input só quando o envio CONFIRMAR — se cair, o texto fica para
    // o usuário tentar de novo (nada se perde).
    void prom.then((ok) => {
      if (ok) setChatMsg("");
    });
  }, [chatMsg, chatSel, enviarChatRich]);

  const enviarChatUrl = useCallback(
    (kind: "imagem" | "video", url: string) => {
      const u = url.trim();
      if (!u) return;
      enviarChatRich(chatSel, {
        kind,
        url: u,
        nome: u.split("/").pop()?.slice(0, 60) || u.slice(0, 60),
      });
    },
    [chatSel, enviarChatRich],
  );

  const enviarChatSticker = useCallback(
    (key: string) => {
      enviarChatRich(chatSel, { kind: "sticker", url: key, texto: key });
      setChatStickers(false);
    },
    [chatSel, enviarChatRich],
  );

  const enviarChatEmoji = useCallback(
    (emoji: string) => {
      enviarChatRich(chatSel, { kind: "emoji", texto: emoji });
    },
    [chatSel, enviarChatRich],
  );

  // Gravação de áudio (MediaRecorder → webm/opus → base64 → P2P)
  const gravarAudioChat = useCallback(async () => {
    if (chatGravandoRef.current) {
      // Para a gravação
      chatGravandoRef.current = false;
      setChatGravando(false);
      const rec = chatRecRef.current;
      if (rec && rec.state !== "inactive") rec.stop();
      return;
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const rec = new MediaRecorder(stream, {
        mimeType: MediaRecorder.isTypeSupported("audio/webm;codecs=opus")
          ? "audio/webm;codecs=opus"
          : "audio/webm",
      });
      chatChunksRef.current = [];
      rec.ondataavailable = (e) => {
        if (e.data.size > 0) chatChunksRef.current.push(e.data);
      };
      rec.onstop = () => {
        stream.getTracks().forEach((t) => t.stop());
        const blob = new Blob(chatChunksRef.current, { type: rec.mimeType || "audio/webm" });
        if (blob.size > 0) {
          const reader = new FileReader();
          reader.onload = () => {
            const b64 = String(reader.result).split(",")[1] ?? "";
            const duracao = Math.round(blob.size / 16000);
            enviarChatRich(chatSel, {
              kind: "audio",
              url: `data:${rec.mimeType};base64,${b64}`,
              mime: rec.mimeType,
              duracao,
              nome: "áudio.webm",
            });
          };
          reader.readAsDataURL(blob);
        }
      };
      rec.start();
      chatRecRef.current = rec;
      chatGravandoRef.current = true;
      setChatGravando(true);
    } catch {
      setChatAviso("Não consegui acessar o microfone.");
      window.setTimeout(() => setChatAviso(""), 4000);
    }
  }, [chatSel, enviarChatRich]);

  // Envia arquivo (imagem/vídeo/áudio/documento) selecionado no input file
  const enviarChatArquivo = useCallback(
    (file: File | null) => {
      if (!file) return;
      // Imagem/vídeo/áudio → mídia; QUALQUER outro tipo (PDF, Office, texto,
      // zip…) vira documento (baixável no chat).
      const kind: "imagem" | "video" | "audio" | "documento" =
        file.type.startsWith("image/")
          ? "imagem"
          : file.type.startsWith("video/")
            ? "video"
            : file.type.startsWith("audio/")
              ? "audio"
              : "documento";
      const reader = new FileReader();
      reader.onload = () => {
        enviarChatRich(chatSel, {
          kind,
          url: String(reader.result),
          mime: file.type || "application/octet-stream",
          nome: file.name.slice(0, 80),
          duracao: kind === "audio" ? Math.round(file.size / 16000) : undefined,
        });
      };
      reader.readAsDataURL(file);
    },
    [chatSel, enviarChatRich],
  );

  // Fecha o preview da câmera do chat (libera o stream)
  const fecharCamChat = useCallback(() => {
    chatCamStreamRef.current?.getTracks().forEach((t) => t.stop());
    chatCamStreamRef.current = null;
    setChatCamAberta(false);
  }, []);

  // Abre o preview da câmera dentro do chat (rosto/ambiente para enviar foto)
  const abrirCamChat = useCallback(async () => {
    if (chatCamAberta) {
      fecharCamChat();
      return;
    }
    try {
      const stream = await Promise.race([
        navigator.mediaDevices.getUserMedia({
          video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        }),
        new Promise<never>((_, rej) =>
          setTimeout(() => rej(new Error("câmera indisponível (permissão negada ou sem câmera)")), 8000),
        ),
      ]);
      chatCamStreamRef.current = stream;
      setChatCamAberta(true);
      // Liga o video no próximo tick (o elemento só existe depois do state)
      window.setTimeout(() => {
        const v = chatCamVideoRef.current;
        if (v) {
          v.srcObject = stream;
          void v.play().catch(() => {});
        }
      }, 50);
    } catch {
      chatCamStreamRef.current?.getTracks().forEach((t) => t.stop());
      chatCamStreamRef.current = null;
      setChatAviso("Não consegui acessar a câmera (permissão negada ou sem câmera).");
      window.setTimeout(() => setChatAviso(""), 5000);
    }
  }, [chatCamAberta, fecharCamChat]);

  // Captura o frame atual da câmera e envia como imagem P2P
  const capturarFotoChat = useCallback(() => {
    const v = chatCamVideoRef.current;
    if (!v || !v.videoWidth) {
      setChatAviso("Câmera ainda não pronta — aguarde um instante.");
      window.setTimeout(() => setChatAviso(""), 4000);
      return;
    }
    const canvas = document.createElement("canvas");
    canvas.width = v.videoWidth;
    canvas.height = v.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(v, 0, 0, canvas.width, canvas.height);
    const url = canvas.toDataURL("image/jpeg", 0.85);
    const enviado = enviarChatRich(chatSel, {
      kind: "imagem",
      url,
      mime: "image/jpeg",
      nome: `foto-camera-${new Date().toISOString().slice(11, 19).replace(/:/g, "-")}.jpg`,
    });
    if (enviado) fecharCamChat();
  }, [chatSel, enviarChatRich, fecharCamChat]);

  // Libera a câmera se a janela do chat for fechada com o preview aberto
  useEffect(() => {
    if (!chatOpen) fecharCamChat();
  }, [chatOpen, fecharCamChat]);

  // Persiste contatos no localStorage
  useEffect(() => {
    try {
      window.localStorage.setItem("ares-contatos", JSON.stringify(contatos));
    } catch {
      /* sem storage */
    }
  }, [contatos]);

  // Persiste as conversas (histórico sobrevive a recarregamentos). Mídia
  // grande (data-URL) é truncada para não estourar a quota do localStorage.
  useEffect(() => {
    try {
      window.localStorage.setItem("ares-conversas", JSON.stringify(compactarConversas(conversas)));
    } catch {
      // Quota cheia — tenta sem nenhuma mídia embutida
      try {
        window.localStorage.setItem(
          "ares-conversas",
          JSON.stringify(compactarConversas(conversas, true)),
        );
      } catch {
        /* sem storage — conversa fica só na sessão */
      }
    }
  }, [conversas]);

  // Persiste os marcadores de lido por contato
  useEffect(() => {
    try {
      window.localStorage.setItem("ares-lidos", JSON.stringify(chatLidos));
    } catch {
      /* sem storage */
    }
  }, [chatLidos]);

  // Marca como lidas as mensagens do contato selecionado quando o chat está
  // aberto — cobre a chegada de mensagem na conversa aberta e a reabertura.
  useEffect(() => {
    if (!chatOpen || !chatSel) return;
    const msgs = conversas[chatSel] ?? [];
    let ultimo = 0;
    for (const m of msgs) {
      if (!m.minha && m.ts > ultimo) ultimo = m.ts;
    }
    if (ultimo > (chatLidos[chatSel] ?? 0)) {
      setChatLidos((l) => ({ ...l, [chatSel]: ultimo }));
    }
  }, [chatOpen, chatSel, conversas, chatLidos]);

  // ——— FINANÇAS: carrega a planilha ———
  const carregarFinancas = useCallback(async () => {
    try {
      const res = await fetch("/api/finance?lista=1");
      const data = (await res.json()) as {
        transacoes: {
          id: string;
          tipo: "receita" | "despesa";
          valor: number;
          categoria: string;
          descricao?: string;
          quando: number;
        }[];
        resumo: {
          saldo: number;
          receitasMes: number;
          despesasMes: number;
          porCategoria: { categoria: string; total: number; count: number }[];
        };
      };
      setFinData({ transacoes: data.transacoes ?? [], resumo: data.resumo ?? null });
    } catch {
      setFinMsg("Erro ao carregar a planilha.");
    }
  }, []);

  const addTransacaoFin = useCallback(async () => {
    const valor = Number(finForm.valor.replace(",", "."));
    if (!Number.isFinite(valor) || valor <= 0) {
      setFinMsg("Digite um valor válido.");
      return;
    }
    try {
      const res = await fetch("/api/finance", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          acao: "add",
          tipo: finForm.tipo,
          valor,
          categoria: finForm.categoria || "outros",
          descricao: finForm.descricao || undefined,
        }),
      });
      const data = (await res.json().catch(() => null)) as { message?: string } | null;
      setFinMsg(data?.message ?? "Lançamento registrado.");
      setFinForm((f) => ({ ...f, valor: "", descricao: "" }));
      await carregarFinancas();
    } catch {
      setFinMsg("Erro ao registrar.");
    }
  }, [finForm, carregarFinancas]);

  const removeTransacaoFin = useCallback(
    async (ref: string) => {
      try {
        const res = await fetch("/api/finance", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ acao: "remove", ref }),
        });
        const data = (await res.json().catch(() => null)) as { message?: string } | null;
        setFinMsg(data?.message ?? "Removido.");
        await carregarFinancas();
      } catch {
        setFinMsg("Erro ao remover.");
      }
    },
    [carregarFinancas],
  );

  // Carrega a planilha ao abrir a janela
  useEffect(() => {
    if (finOpen) void carregarFinancas();
  }, [finOpen, carregarFinancas]);

  // Gráfico de barras: gastos por categoria do mês (canvas, P&B com acento
  // ciano). Redesenha a cada lançamento (finData muda) e ao abrir a janela.
  useEffect(() => {
    const canvas = finChartRef.current;
    const container = canvas?.parentElement;
    if (!canvas || !container) return;

    const desenhar = () => {
      const dpr = window.devicePixelRatio || 1;
      const w = Math.max(200, container.clientWidth);
      const h = 170;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      const cats = finData.resumo?.porCategoria ?? [];
      if (cats.length === 0) {
        ctx.fillStyle = "rgba(86, 217, 255, 0.5)";
        ctx.font = "11px monospace";
        ctx.textAlign = "center";
        ctx.fillText("Sem gastos este mês ainda — lance uma despesa para ver o gráfico.", w / 2, h / 2);
        return;
      }

      const max = Math.max(...cats.map((c) => c.total), 1);
      const padB = 26;
      const padT = 18;
      const chartH = h - padB - padT;
      const n = cats.length;
      const slot = w / n;
      const barW = Math.min(46, slot * 0.6);

      ctx.textAlign = "center";
      cats.forEach((c, i) => {
        const cx = slot * i + slot / 2;
        const bh = Math.max(2, (c.total / max) * chartH);
        const y = padT + chartH - bh;
        // Barra com gradiente ciano (mais forte na base do topo)
        const grad = ctx.createLinearGradient(0, y, 0, y + bh);
        grad.addColorStop(0, "rgba(86, 217, 255, 0.95)");
        grad.addColorStop(1, "rgba(86, 217, 255, 0.25)");
        ctx.fillStyle = grad;
        ctx.fillRect(cx - barW / 2, y, barW, bh);
        // Valor sobre a barra
        ctx.fillStyle = "rgba(220, 240, 255, 0.95)";
        ctx.font = "bold 10px monospace";
        ctx.fillText(shortValor(c.total), cx, y - 4);
        // Rótulo da categoria
        ctx.fillStyle = "rgba(150, 200, 230, 0.8)";
        ctx.font = "9px monospace";
        let label = c.categoria;
        if (label.length > 8) label = label.slice(0, 7) + "…";
        ctx.fillText(label, cx, h - padB + 12);
      });
    };

    desenhar();
    const ro = new ResizeObserver(desenhar);
    ro.observe(container);
    return () => ro.disconnect();
  }, [finData, finOpen]);

  return (
    <>
      <div ref={containerRef} className="orb-root" />
      <FpsProbe />

      <div className="overlay-vignette" />
      <div className="overlay-grain" />
      <div className="overlay-scanlines" />

      {/* ——— Modo interface: aviso + cursor da mão ——— */}
      {interfaceMode && (
        <div className="hand-mode-badge">MODO INTERFACE — MÃOS CONTROLAM A UI</div>
      )}
      <div className="hand-cursor" ref={handCursorRef}>
        <span />
      </div>

      {/* ——— Changelog: nota de versão exibida após a instalação ——— */}
      {changelog && (
        <div className="upd-banner" role="alert">
          <div className="upd-banner-titulo">
            <i className="bi bi-stars" aria-hidden="true" />
            Atualização {changelog.versao} instalada
          </div>
          <ul className="upd-banner-notas">
            {changelog.notas.map((n, i) => (
              <li key={i}>{n}</li>
            ))}
          </ul>
          <button
            type="button"
            className="upd-banner-fechar"
            onClick={() => setChangelog(null)}
            aria-label="Fechar novidades"
          >
            <i className="bi bi-x-lg" aria-hidden="true" />
          </button>
        </div>
      )}

      {/* ——— Chips HUD: timers/lembretes ativos ——— */}
      {timers.length > 0 && (
        <div className="chip-row" aria-live="polite">
          {timers.map((t) => (
            <div key={t.id} className="chip chip-timer" title={`${t.kind === "reminder" ? "Lembrete" : "Timer"}: ${t.label}`}>
              <span className="chip-icon" aria-hidden="true">
                <i className={`bi ${t.kind === "reminder" ? "bi-alarm" : "bi-stopwatch"}`} />
              </span>
              {t.kind === "reminder" ? t.label : formatCountdown(t.endsAt)}
            </div>
          ))}
        </div>
      )}

      {/* ——— Alertas de agenda: evento chegando (chip com contagem) ——— */}
      {alertasEvento.length > 0 && (
        <div className="chip-row" aria-live="polite">
          {alertasEvento.map((a) => (
            <div key={a.id} className="chip chip-evento" title={`${a.titulo} — ${new Date(a.quando).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" })}`}>
              <span className="chip-icon" aria-hidden="true">
                <i className="bi bi-bell" />
              </span>
              {a.titulo}
            </div>
          ))}
        </div>
      )}

      {/* ——— Chip P2P: conectada com outra IA ——— */}
      {peerRemoto && (
        <div className="chip-row" aria-live="polite">
          <div className="chip chip-peer" title={`Conectada P2P com ${peerRemoto}`}>
            <span className="chip-icon" aria-hidden="true">
              <i className="bi bi-hdd-network" />
            </span>
            P2P · {peerRemoto.slice(0, 8)}
          </div>
        </div>
      )}

      {/* ——— Chip SAÚDE: batimentos pela câmera (rPPG) ——— */}
      {cameraOn && (
        <div className="chip-row" aria-live="polite">
          <div className="chip chip-bpm" title="Batimentos por minuto (rPPG pela câmera)">
            <span className="chip-icon" aria-hidden="true">
              <i className="bi bi-heart-pulse" />
            </span>
            {bpm !== null ? `${bpm} BPM` : "MEDINDO…"}
          </div>
        </div>
      )}

